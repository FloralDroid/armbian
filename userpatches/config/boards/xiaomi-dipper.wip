# Xiaomi Mi 8 (dipper) Qualcomm SDM845 mobile device.
declare -g BOARD_NAME="Xiaomi Mi 8"
declare -g BOARD_VENDOR="xiaomi"
declare -g BOARD_MAINTAINER=""
declare -g INTRODUCED="2018"
declare -g BOARDFAMILY="sdm845"
declare -g KERNEL_TARGET="current"
declare -g KERNEL_TEST_TARGET="current"
declare -g EXTRAWIFI="no"
declare -g BOOTCONFIG="none"
declare -g IMAGE_PARTITION_TABLE="gpt"
declare -g ABL_DTB_LIST=("sdm845-xiaomi-dipper")

enable_extension "kernel-common"

# Debug packages keep their own kernel release and module directory.
if [[ "${SDM845_DEBUG:-no}" == "yes" ]]; then
	enable_extension "sdm845-debug"
fi

function custom_kernel_config__xiaomi_dipper_drivers() {
	opts_m+=(
		"BATTERY_QCOM_FG"
		"DRM_MSM"
		"DRM_PANEL_SAMSUNG_EA8074"
		"SND_SOC_QDSP6_Q6VOICE"
		"SND_SOC_TAS2557"
		"TOUCHSCREEN_STM_FTS_DOWNSTREAM"
		"VIDEO_IMX363"
		"VIDEO_OV7251"
		"VIDEO_QCOM_VENUS"
	)
}

function post_customize_image__xiaomi_dipper_recovery() {
	install -d -m 755 "${SDCARD}/etc/sysctl.d" "${SDCARD}/etc/systemd/system.conf.d"

	cat > "${SDCARD}/etc/sysctl.d/90-xiaomi-dipper-recovery.conf" <<'EOF'
kernel.panic_on_rcu_stall = 1
kernel.panic_on_oops = 1
kernel.panic_on_warn = 0
kernel.panic = 1
EOF

	cat > "${SDCARD}/etc/systemd/system.conf.d/90-xiaomi-dipper-watchdog.conf" <<'EOF'
[Manager]
RuntimeWatchdogSec=30s
RuntimeWatchdogPreSec=10s
RuntimeWatchdogPreGovernor=panic
EOF
}

function post_customize_image__xiaomi_dipper_memory() {
	install -d -m 755 "${SDCARD}/etc/sysctl.d" "${SDCARD}/etc/systemd/system"

	cat > "${SDCARD}/etc/sysctl.d/90-xiaomi-dipper-memory.conf" <<'EOF'
vm.page-cluster = 0
EOF

	# procps reads sysctl.conf after drop-ins.
	sed -i 's/^[[:space:]]*vm\.page-cluster[[:space:]]*=.*/vm.page-cluster=0/' \
		"${SDCARD}/etc/sysctl.conf"

	cat > "${SDCARD}/etc/systemd/system/ksm.service" <<'EOF'
[Unit]
Description=KSM configuration
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
  K=/sys/kernel/mm/ksm; \
  echo 0 > $$K/run; \
  echo none > $$K/advisor_mode; \
  echo 200 > $$K/pages_to_scan; \
  echo 20 > $$K/sleep_millisecs; \
  echo 1 > $$K/smart_scan; \
  echo 0 > $$K/use_zero_pages; \
  echo 1 > $$K/run'

ExecStop=/bin/sh -c 'echo 0 > /sys/kernel/mm/ksm/run'

[Install]
WantedBy=multi-user.target
EOF

	chroot_sdcard systemctl --no-reload enable ksm.service
}

# Use distribution firmware packages; proprietary device extraction stays outside Git.
declare -g BOARD_FIRMWARE_INSTALL="-full"

function post_family_tweaks_bsp__xiaomi_dipper_usb_network() {
	install -Dm644 \
		"${SRC}/packages/bsp/xiaomi-dipper/10-xiaomi-dipper-usb0.network" \
		"${destination}/etc/systemd/network/10-xiaomi-dipper-usb0.network"
}
