From 41737c99b5e41ca3a417deff7e16984fe60cc552 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sun, 27 Sep 2026 16:26:03 +0800
Subject: [PATCH] arm64: dts: qcom: xiaomi-dipper: persist ftrace and pmsg

Reserve per-CPU persistent function history and userspace test markers in the existing debug-only ramoops region. This can retain the last calls and the active test setting when a hung CPU cannot provide an NMI backtrace.

Signed-off-by: 5656565566 <contact@home56.top>
---
 arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dts b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dts
index 9e0802215..fdc5296ab 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dts
+++ b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dts
@@ -252,6 +252,9 @@ ramoops: ramoops@b0000000 {
 			reg = <0 0xb0000000 0 0x400000>;
 			record-size = <0x40000>;
 			console-size = <0x100000>;
+			pmsg-size = <0x40000>;
+			ftrace-size = <0x100000>;
+			flags = <1>; /* RAMOOPS_FLAG_FTRACE_PER_CPU */
 			ecc-size = <16>;
 		};
 
-- 
2.47.3

