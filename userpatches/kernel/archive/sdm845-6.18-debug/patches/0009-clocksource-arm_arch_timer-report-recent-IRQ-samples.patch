From af9939ac07e26cf556462938176c486c68162791 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Mon, 28 Sep 2026 09:50:55 +0800
Subject: [PATCH 9/9] clocksource: arm_arch_timer: report recent IRQ samples on
 panic

Keep the last eight architecture timer interrupt samples per CPU in ordinary memory. Record the interrupted PC, pstate, task, counter and whether the event handler returned. On panic, print their ages and raw PCs for later symbolization with the old boot KASLR offset.

Sampling avoids a persistent RAM write on every timer tick; only the panic notifier emits the ring contents. A direct hardware reset without panic will not preserve these samples.

Signed-off-by: 5656565566 <contact@home56.top>
---
 drivers/clocksource/arm_arch_timer.c | 127 +++++++++++++++++++++++++++
 1 file changed, 127 insertions(+)

diff --git a/drivers/clocksource/arm_arch_timer.c b/drivers/clocksource/arm_arch_timer.c
index 90aeff44a..664765b8f 100644
--- a/drivers/clocksource/arm_arch_timer.c
+++ b/drivers/clocksource/arm_arch_timer.c
@@ -23,6 +23,8 @@
 #include <linux/of_address.h>
 #include <linux/io.h>
 #include <linux/slab.h>
+#include <linux/panic_notifier.h>
+#include <linux/sched.h>
 #include <linux/sched/clock.h>
 #include <linux/sched_clock.h>
 #include <linux/acpi.h>
@@ -31,6 +33,10 @@
 
 #include <asm/arch_timer.h>
 #include <asm/virt.h>
+#ifdef CONFIG_ARM64
+#include <asm/irq_regs.h>
+#include <asm/ptrace.h>
+#endif
 
 #include <clocksource/arm_arch_timer.h>
 
@@ -65,6 +71,124 @@ static enum vdso_clock_mode vdso_default = VDSO_CLOCKMODE_NONE;
 static cpumask_t evtstrm_available = CPU_MASK_NONE;
 static bool evtstrm_enable __ro_after_init = IS_ENABLED(CONFIG_ARM_ARCH_TIMER_EVTSTREAM);
 
+#ifdef CONFIG_ARM64
+#define ARCH_TIMER_HANG_SAMPLES 8
+
+struct arch_timer_hang_sample {
+	u64 counter;
+	unsigned long pc;
+	unsigned long pstate;
+	u32 seq;
+	pid_t pid;
+	char comm[TASK_COMM_LEN];
+	bool complete;
+};
+
+struct arch_timer_hang_cpu {
+	u32 head;
+	struct arch_timer_hang_sample samples[ARCH_TIMER_HANG_SAMPLES];
+};
+
+static DEFINE_PER_CPU(struct arch_timer_hang_cpu, arch_timer_hang_cpus);
+
+static struct arch_timer_hang_sample *arch_timer_hang_enter(void)
+{
+	struct arch_timer_hang_cpu *state = this_cpu_ptr(&arch_timer_hang_cpus);
+	struct arch_timer_hang_sample *sample;
+	struct pt_regs *regs = get_irq_regs();
+	u32 seq = READ_ONCE(state->head) + 1;
+
+	sample = &state->samples[seq % ARCH_TIMER_HANG_SAMPLES];
+	WRITE_ONCE(state->head, seq);
+	WRITE_ONCE(sample->seq, 0);
+	WRITE_ONCE(sample->complete, false);
+	sample->counter = __arch_counter_get_cntvct();
+	sample->pc = regs ? instruction_pointer(regs) : 0;
+	sample->pstate = regs ? regs->pstate : 0;
+	sample->pid = current->pid;
+	memcpy(sample->comm, current->comm, TASK_COMM_LEN);
+	sample->comm[TASK_COMM_LEN - 1] = '\0';
+	/* Publish the fields only after the slot is complete. */
+	smp_store_release(&sample->seq, seq);
+
+	return sample;
+}
+
+static void arch_timer_hang_exit(struct arch_timer_hang_sample *sample)
+{
+	/* Distinguish a completed timer interrupt from one still in flight. */
+	smp_store_release(&sample->complete, true);
+}
+
+static int arch_timer_hang_panic(struct notifier_block *nb,
+				unsigned long event, void *data)
+{
+	u64 now = __arch_counter_get_cntvct();
+	unsigned int cpu, i;
+
+	if (!arch_timer_rate)
+		return NOTIFY_DONE;
+
+	pr_emerg("timer samples: counter=%llu rate=%u\n", now, arch_timer_rate);
+	for_each_possible_cpu(cpu) {
+		struct arch_timer_hang_cpu *state = per_cpu_ptr(&arch_timer_hang_cpus, cpu);
+		u32 head = READ_ONCE(state->head);
+
+		if (!head)
+			continue;
+
+		for (i = 0; i < ARCH_TIMER_HANG_SAMPLES && i < head; i++) {
+			struct arch_timer_hang_sample *sample;
+			struct arch_timer_hang_sample snapshot;
+			u64 counter, age_ms;
+			u32 seq = head - i;
+
+			sample = &state->samples[seq % ARCH_TIMER_HANG_SAMPLES];
+			/* Ignore an in-progress overwrite of this ring slot. */
+			if (smp_load_acquire(&sample->seq) != seq)
+				continue;
+
+			memcpy(&snapshot, sample, sizeof(snapshot));
+			/* Pair with the completed interrupt's release store. */
+			snapshot.complete = smp_load_acquire(&sample->complete);
+			if (READ_ONCE(sample->seq) != seq)
+				continue;
+
+			counter = snapshot.counter;
+			age_ms = now >= counter ?
+				div64_u64((now - counter) * 1000, arch_timer_rate) : 0;
+			/* Raw PC is needed to resolve the old boot's KASLR offset. */
+			pr_emerg("timer sample CPU%u seq=%u age=%llums complete=%u pid=%d comm=%s pc=%px (%pS) pstate=%lx\n",
+				 cpu, seq, age_ms, snapshot.complete,
+				 snapshot.pid, snapshot.comm,
+				 (void *)snapshot.pc, (void *)snapshot.pc,
+				 snapshot.pstate);
+		}
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block arch_timer_hang_panic_nb = {
+	.notifier_call = arch_timer_hang_panic,
+};
+
+static int __init arch_timer_hang_init(void)
+{
+	int ret;
+
+	ret = atomic_notifier_chain_register(&panic_notifier_list,
+					     &arch_timer_hang_panic_nb);
+	if (!ret)
+		pr_info("panic timer samples enabled\n");
+	return ret;
+}
+late_initcall(arch_timer_hang_init);
+#else
+static inline void *arch_timer_hang_enter(void) { return NULL; }
+static inline void arch_timer_hang_exit(void *sample) { }
+#endif
+
 static int __init early_evtstrm_cfg(char *buf)
 {
 	return kstrtobool(buf, &evtstrm_enable);
@@ -565,12 +689,15 @@ static __always_inline irqreturn_t timer_handler(const int access,
 					struct clock_event_device *evt)
 {
 	unsigned long ctrl;
+	void *hang_sample;
 
 	ctrl = arch_timer_reg_read_cp15(access, ARCH_TIMER_REG_CTRL);
 	if (ctrl & ARCH_TIMER_CTRL_IT_STAT) {
+		hang_sample = arch_timer_hang_enter();
 		ctrl |= ARCH_TIMER_CTRL_IT_MASK;
 		arch_timer_reg_write_cp15(access, ARCH_TIMER_REG_CTRL, ctrl);
 		evt->event_handler(evt);
+		arch_timer_hang_exit(hang_sample);
 		return IRQ_HANDLED;
 	}
 
-- 
2.47.3

