+#ifdef SCHED_RT_GROUP_QUOTA
+/* RT uses the existing quota caches, without entering the fair runqueues. */
+void account_rt_cfs_runtime(struct rq *rq, struct task_struct *p, u64 delta)
+{
+	struct sched_entity *se;
+
+	for (se = &p->se; se; se = parent_entity(se)) {
+		struct cfs_rq *cfs_rq = cfs_rq_of(se);
+
+		account_cfs_rq_runtime(cfs_rq, delta);
+		if (cfs_rq->runtime_enabled && cfs_rq->runtime_remaining <= 0)
+			resched_curr(rq);
+	}
+}
+
+void check_rt_cfs_runtime(struct task_struct *p)
+{
+	struct sched_entity *se;
+	bool throttled = false;
+
+	for (se = &p->se; se; se = parent_entity(se)) {
+		struct cfs_rq *cfs_rq = cfs_rq_of(se);
+
+		account_cfs_rq_runtime(cfs_rq, 0);
+		throttled |= check_cfs_rq_runtime(cfs_rq);
+		if (cfs_rq->throttle_count)
+			record_throttle_clock(cfs_rq);
+	}
+	if (throttled || throttled_hierarchy(cfs_rq_of(&p->se)))
+		task_throttle_setup_work(p);
+}
+
+bool enqueue_rt_throttled(struct task_struct *p)
+{
+	return p->throttled && enqueue_throttled_task(p);
+}
+
+bool dequeue_rt_throttled(struct task_struct *p, int flags)
+{
+	if (!p->throttled)
+		return false;
+	dequeue_throttled_task(p, flags);
+	return true;
+}
