 void memory_resource_watermarks(u64 managed, u64 watermarks[3]);
 unsigned long uts_resources_task_limit(struct task_struct *task);
 bool uts_resources_self_rtprio(void);
+bool uts_resources_rt_capable(struct task_struct *p);
 #else
