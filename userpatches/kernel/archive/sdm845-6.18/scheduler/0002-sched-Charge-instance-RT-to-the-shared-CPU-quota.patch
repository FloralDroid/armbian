 		if (cfs_rq->throttled)
 			unthrottle_cfs_rq(cfs_rq);
@@ -10227,7 +10272,94 @@ static ssize_t cpu_max_write(struct kernfs_open_file *of,
 }
 #endif /* CONFIG_CFS_BANDWIDTH */
 
+#ifdef SCHED_RT_GROUP_QUOTA
+DEFINE_STATIC_KEY_FALSE(sched_rt_group_quota);
+
+static int cpu_rt_mode_show(struct seq_file *sf, void *v)
+{
+	struct task_group *tg = css_tg(seq_css(sf));
+
+	seq_puts(sf, READ_ONCE(tg->rt_owner) ? "quota\n" : "native\n");
+	return 0;
+}
+
+static ssize_t cpu_rt_mode_write(struct kernfs_open_file *of, char *buf,
+				size_t nbytes, loff_t off)
+{
+	struct task_group *tg = css_tg(of_css(of));
+	struct cgroup *cgrp;
+	bool enable;
+	int ret = 0;
+
+	if (!ns_capable(&init_user_ns, CAP_SYS_ADMIN))
+		return -EPERM;
+	buf = strim(buf);
+	if (!strcmp(buf, "quota"))
+		enable = true;
+	else if (!strcmp(buf, "native"))
+		enable = false;
+	else
+		return -EINVAL;
+
+	/* Match kernfs/cgroup lock ordering without retaining active protection. */
+	cgrp = tg->css.cgroup;
+	css_get(&tg->css);
+	cgroup_get(cgrp);
+	kernfs_break_active_protection(of->kn);
+	cgroup_lock();
+	if (!(tg->css.flags & CSS_ONLINE)) {
+		ret = -ENOENT;
+		goto out;
+	}
+	/* Empty is not sufficient: a published boundary must stay immutable. */
+	if (READ_ONCE(tg->rt_published) || cgroup_is_populated(cgrp) ||
+	    css_has_online_children(&cgrp->self)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (tg->parent && tg->parent->rt_owner) {
+		ret = -EPERM;
+		goto out;
+	}
+	if (enable == (tg->rt_owner == tg))
+		goto out;
+	if (enable) {
+		guard(cpus_read_lock)();
+		guard(mutex)(&cfs_constraints_mutex);
+
+		if (!rt_group_sched_enabled() || IS_ENABLED(CONFIG_SCHED_CORE) ||
+		    IS_ENABLED(CONFIG_SCHED_PROXY_EXEC) || IS_ENABLED(CONFIG_SCHED_CLASS_EXT)) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		if (tg->cfs_bandwidth.quota == RUNTIME_INF) {
+			ret = -EINVAL;
+			goto out;
+		}
+		static_branch_inc_cpuslocked(&sched_rt_group_quota);
+		WRITE_ONCE(tg->rt_owner, tg);
+	} else {
+		WRITE_ONCE(tg->rt_owner, NULL);
+		static_branch_dec(&sched_rt_group_quota);
+	}
+out:
+	cgroup_unlock();
+	kernfs_unbreak_active_protection(of->kn);
+	cgroup_put(cgrp);
+	css_put(&tg->css);
+	return ret ?: nbytes;
+}
+#endif
