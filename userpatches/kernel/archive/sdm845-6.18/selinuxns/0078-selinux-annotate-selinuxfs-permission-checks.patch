 			   SECCLASS_SECURITY, SECURITY__READ_POLICY, NULL);
@@ -711,7 +723,13 @@ static ssize_t sel_write_load(struct file *file, const char __user *buf,
 	if (fsi->state != current_selinux_state)
 		return -EPERM;
 
-	length = avc_has_perm(current_selinux_state, current_sid(), SECINITSID_SECURITY,
+
+	/*
