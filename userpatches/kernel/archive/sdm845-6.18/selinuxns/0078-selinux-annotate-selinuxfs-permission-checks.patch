 			  SECCLASS_SECURITY, SECURITY__READ_POLICY, NULL);
@@ -555,6 +563,10 @@ static ssize_t sel_read_policy(struct file *filp, char __user *buf,
 	struct policy_load_memory *plm = filp->private_data;
