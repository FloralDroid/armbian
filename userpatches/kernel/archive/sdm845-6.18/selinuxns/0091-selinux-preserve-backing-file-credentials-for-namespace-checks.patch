From 063cfd565eb2485360fa739deb49894f1e87b9ea Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sun, 8 Nov 2026 01:55:55 +0800
Subject: [PATCH] selinux: Preserve backing-file credentials for namespace
 checks

Linux 6.18.54 retains intermediate backing-file mounter SIDs so that
mprotect() checks every layer of a stacked filesystem. SELinux namespaces
also require the mounter credentials and their parent namespace chain;
the stored SID alone cannot supply that permission-checking context.

Retain each intermediate mounter credential alongside its path. Take a
reference when adding or copying a layer and release it in the existing
backing-file cleanup hook. Use cred_tsid_has_perm() and inode_has_perm()
so these checks follow the same namespace ancestry as the other file
permission checks, while retaining the stable user SID and layer checks.

Signed-off-by: 5656565566 <contact@home56.top>
---
 security/selinux/hooks.c          | 39 ++++++++++---------------------
 security/selinux/include/objsec.h |  2 +-
 2 files changed, 13 insertions(+), 28 deletions(-)

diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 5df6293954c0f019f56d17fa0a7a3ad08fae0d89..5566f419e6657aacee26453103a73f744e805b4f 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -1686,25 +1686,6 @@ static int cred_has_capability(const struct cred *cred,
 	return rc;
 }
 
-/*
- * Check whether a SID has a particular permission to an inode.  The 'adp'
- * parameter is optional and allows other audit data to be passed (e.g. the
- * dentry).
- */
-static int inode_sid_has_perm(u32 sid, struct inode *inode, u32 perms,
-			      struct common_audit_data *adp)
-{
-	struct inode_security_struct *isec;
-
-	if (unlikely(IS_PRIVATE(inode)))
-		return 0;
-
-	isec = selinux_inode(inode);
-
-	return avc_has_perm(current_selinux_state,
-			    sid, isec->sid, isec->sclass, perms, adp);
-}
-
 static int inode_has_perm(const struct cred *cred,
 			  struct inode *inode,
 			  u32 perms,
@@ -4024,12 +4005,13 @@ static int selinux_backing_file_alloc(struct file *backing_file,
 		layer = &bfsec->layers[i];
 		*layer = ubfsec->layers[i];
 		path_get(&layer->path);
+		layer->mounter_cred = get_cred(layer->mounter_cred);
 	}
 
 	/* f_path, not file_user_path(): this layer, not the top-level file */
 	layer = &bfsec->layers[i];
 	layer->path = user_file->f_path;
-	layer->mounter_sid = cred_sid(user_file->f_cred);
+	layer->mounter_cred = get_cred(user_file->f_cred);
 	layer->fd_sid = selinux_file(user_file)->sid;
 	path_get(&layer->path);
 	bfsec->layer_count = ubfsec->layer_count + 1;
@@ -4040,14 +4022,18 @@ static int selinux_backing_file_alloc(struct file *backing_file,
 static void selinux_backing_file_free(struct file *backing_file)
 {
 	struct backing_file_security_struct *bfsec;
+	struct backing_file_security_layer *layer;
 
 	/* security_backing_file_free() may be called twice after an error */
 	if (!backing_file_security(backing_file))
 		return;
 
 	bfsec = selinux_backing_file(backing_file);
-	while (bfsec->layer_count)
-		path_put(&bfsec->layers[--bfsec->layer_count].path);
+	while (bfsec->layer_count) {
+		layer = &bfsec->layers[--bfsec->layer_count];
+		path_put(&layer->path);
+		put_cred(layer->mounter_cred);
+	}
 	kfree(bfsec->layers);
 	bfsec->layers = NULL;
 }
@@ -4207,15 +4193,14 @@ static int backing_mounters_has_perm(const struct file *file, u32 av)
 		ad.type = LSM_AUDIT_DATA_PATH;
 		ad.u.path = layer->path;
 
-		if (layer->mounter_sid != layer->fd_sid) {
-			rc = avc_has_perm(current_selinux_state,
-					  layer->mounter_sid, layer->fd_sid,
-					  SECCLASS_FD, FD__USE, &ad);
+		if (cred_sid(layer->mounter_cred) != layer->fd_sid) {
+			rc = cred_tsid_has_perm(layer->mounter_cred, layer->fd_sid,
+						SECCLASS_FD, FD__USE, &ad);
 			if (rc)
 				return rc;
 		}
 
-		rc = inode_sid_has_perm(layer->mounter_sid, inode, av, &ad);
+		rc = inode_has_perm(layer->mounter_cred, inode, av, &ad);
 		if (rc)
 			return rc;
 	}
diff --git a/security/selinux/include/objsec.h b/security/selinux/include/objsec.h
index 37a3c2ea1db7ea181d87ecaf8a139e53a7259dcb..4b15ae8a867bec95a8f0fef76e7fcdd2007073ac 100644
--- a/security/selinux/include/objsec.h
+++ b/security/selinux/include/objsec.h
@@ -81,7 +81,7 @@ struct file_security_struct {
 
 struct backing_file_security_layer {
 	struct path path; /* this layer's real path */
-	u32 mounter_sid; /* SID of the mounter that opened it */
+	const struct cred *mounter_cred; /* mounter and its namespace ancestry */
 	u32 fd_sid; /* SID of its open file description */
 };
 
