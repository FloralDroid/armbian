diff --git a/tools/testing/selftests/filesystems/nsfs/uts_identity.c b/tools/testing/selftests/filesystems/nsfs/uts_identity.c
new file mode 100644
index 000000000..b32d16ecc
--- /dev/null
+++ b/tools/testing/selftests/filesystems/nsfs/uts_identity.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/capability.h>
+#include <linux/nsfs.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/personality.h>
+#include <sys/syscall.h>
+#include <sys/utsname.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "../../kselftest.h"
+
+static void require(int ok, const char *what)
+{
+	if (!ok)
+		ksft_exit_fail_msg("%s: %s\n", what, strerror(errno));
+}
+
+static int nsfd(const char *name)
+{
+	char path[64];
+	int fd;
+
+	snprintf(path, sizeof(path), "/proc/self/ns/%s", name);
+	fd = open(path, O_RDONLY);
+	require(fd >= 0, "open namespace");
+	return fd;
+}
+
+static void wait_ok(pid_t pid)
+{
+	int status;
+
+	require(waitpid(pid, &status, 0) == pid, "waitpid");
+	require(WIFEXITED(status) && !WEXITSTATUS(status), "child result");
+}
+
+static void text(const char *path, char *buf, size_t size)
+{
+	int fd = open(path, O_RDONLY);
+	ssize_t len;
+
+	require(fd >= 0, path);
+	len = read(fd, buf, size - 1);
+	require(len > 0, "read proc");
+	buf[len] = 0;
+	if (buf[len - 1] == '\n')
+		buf[len - 1] = 0;
+	close(fd);
+}
+
+static void check_tail(const char *str, size_t size)
+{
+	size_t len = strlen(str);
+
+	while (++len < size)
+		require(!str[len], "uname tail is cleared");
+}
+
+static void check_views(const struct uts_ns_identity *expected)
+{
+	struct utsname libc_name, raw;
+	char value[512], banner[256];
+	unsigned long saved;
+
+	require(!uname(&libc_name), "libc uname");
+	memset(&raw, 0xa5, sizeof(raw));
+	require(!syscall(SYS_uname, &raw), "raw uname");
+	require(!memcmp(&raw, &libc_name, sizeof(raw)), "libc and raw uname agree");
+	require(!strcmp(raw.release, expected->release), "release");
+	require(!strcmp(raw.version, expected->version), "version");
+	check_tail(raw.release, sizeof(raw.release));
+	check_tail(raw.version, sizeof(raw.version));
+	text("/proc/sys/kernel/osrelease", value, sizeof(value));
+	require(!strcmp(value, raw.release), "release sysctl");
+	text("/proc/sys/kernel/version", value, sizeof(value));
+	require(!strcmp(value, raw.version), "version sysctl");
+	errno = 0;
+	require(open("/proc/sys/kernel/osrelease", O_WRONLY) == -1 && errno == EACCES,
+		"release sysctl remains read-only");
+	text("/proc/sys/kernel/ostype", value, sizeof(value));
+	require(!strcmp(value, raw.sysname), "ostype sysctl");
+	text("/proc/version", value, sizeof(value));
+	snprintf(banner, sizeof(banner), "%s version %s %s", raw.sysname,
+		 raw.release, raw.version);
+	require(!strcmp(value, banner), "proc banner has no host build identity");
+
+	saved = personality(0xffffffffUL);
+	require(saved != (unsigned long)-1, "get personality");
+	require(personality(saved | UNAME26) != -1, "set UNAME26");
+	require(!syscall(SYS_uname, &raw), "raw UNAME26");
+	require(!strcmp(raw.release, "2.6.70-lupine"), "UNAME26 uses instance release");
+	require(personality(saved) != -1, "restore personality");
+}
+
+static void check_guest(int own, int sibling, int host,
+			const struct uts_ns_identity *expected, const char *compat)
+{
+	struct uts_ns_identity actual;
+	int descendant;
+	pid_t pid;
+
+	require(!setns(own, CLONE_NEWUTS), "enter instance before new PID namespace");
+	require(!unshare(CLONE_NEWPID), "new PID namespace");
+	pid = fork();
+	require(pid >= 0, "fork guest");
+	if (pid) {
+		wait_ok(pid);
+		return;
+	}
+
+	check_views(expected);
+	require(!ioctl(own, NS_UTS_GET_IDENTITY, &actual), "get identity");
+	require(actual.flags == UTS_NS_IDENTITY_SEALED, "sealed status");
+	require(ioctl(own, NS_UTS_SET_IDENTITY, expected) == -1 && errno == EPERM,
+		"guest root cannot configure identity");
+	require(ioctl(host, NS_UTS_GET_IDENTITY, &actual) == -1 && errno == EPERM,
+		"host FD cannot disclose host identity");
+	require(ioctl(sibling, NS_UTS_GET_IDENTITY, &actual) == -1 && errno == EPERM,
+		"sibling FD cannot disclose sibling identity");
+	require(setns(host, CLONE_NEWUTS) == -1 && errno == EPERM,
+		"host FD cannot escape identity");
+	require(setns(sibling, CLONE_NEWUTS) == -1 && errno == EPERM,
+		"identical strings do not allow switching identity families");
+	require(!unshare(CLONE_NEWUTS), "clone descendant UTS");
+	descendant = nsfd("uts");
+	require(!ioctl(descendant, NS_UTS_GET_IDENTITY, &actual), "get descendant");
+	require(actual.flags == UTS_NS_IDENTITY_SEALED, "descendant remains sealed");
+	check_views(expected);
+	require(!setns(own, CLONE_NEWUTS), "same family setns");
+	require(!setns(descendant, CLONE_NEWUTS), "descendant setns");
+	require(!sethostname("guest", 5), "standard hostname remains writable");
+
+	if (compat) {
+		pid = fork();
+		require(pid >= 0, "fork compat");
+		if (!pid) {
+			execl(compat, compat, NULL);
+			_exit(1);
+		}
+		wait_ok(pid);
+	}
+
+	/* A child user namespace cannot regain host management authority. */
+	require(!unshare(CLONE_NEWUSER), "new user namespace");
+	require(ioctl(own, NS_UTS_SET_IDENTITY, expected) == -1 && errno == EPERM,
+		"user namespace root cannot configure identity");
+	_exit(0);
+}
+
+int main(int argc, char **argv)
+{
+	struct uts_ns_identity identity = {
+		.abi_version = UTS_NS_IDENTITY_VERSION,
+		.release = "5.10.66-lupine",
+		.version = "#1 SMP PREEMPT",
+	}, actual, invalid;
+	struct utsname before, after;
+	char banner_before[512], banner_after[512];
+	int host, a, b, wrong;
+	pid_t pid;
+
+	ksft_print_header();
+	host = nsfd("uts");
+	if (ioctl(host, NS_UTS_GET_IDENTITY, &actual)) {
+		if (errno == ENOTTY)
+			ksft_exit_skip("UTS_NS_IDENTITY is unavailable\n");
+		ksft_exit_fail_msg("GET identity: %s\n", strerror(errno));
+	}
+	if (geteuid())
+		ksft_exit_skip("requires initial namespace root\n");
+	ksft_set_plan(5);
+	require(sizeof(identity) == 144, "fixed compat ABI size");
+	require(actual.abi_version == 1 && !actual.flags, "host unconfigured");
+	require(!uname(&before), "host uname");
+	text("/proc/version", banner_before, sizeof(banner_before));
+	require(ioctl(host, NS_UTS_SET_IDENTITY, &identity) == -1 && errno == EPERM,
+		"initial UTS is immutable");
+	wrong = nsfd("pid");
+	require(ioctl(wrong, NS_UTS_GET_IDENTITY, &actual) == -1 && errno == EINVAL,
+		"reject wrong namespace type");
+	close(wrong);
+	require(!unshare(CLONE_NEWUTS), "new UTS A");
+	a = nsfd("uts");
+	require(ioctl(a, NS_UTS_SET_IDENTITY, NULL) == -1 && errno == EFAULT,
+		"reject bad pointer");
+	invalid = identity;
+	invalid.abi_version++;
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject ABI mismatch");
+	invalid = identity;
+	invalid.flags = UTS_NS_IDENTITY_SEALED;
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject input flags");
+	invalid = identity;
+	invalid.reserved[0] = 1;
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject reserved bytes");
+	invalid = identity;
+	memset(invalid.release, 'x', sizeof(invalid.release));
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject unterminated release");
+	invalid = identity;
+	invalid.version[2] = '\n';
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject injected banner line");
+	invalid = identity;
+	invalid.release[0] = 0;
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &invalid) == -1 && errno == EINVAL,
+		"reject empty release");
+	require(!ioctl(a, NS_UTS_SET_IDENTITY, &identity), "seal UTS A");
+	require(ioctl(a, NS_UTS_SET_IDENTITY, &identity) == -1 && errno == EBUSY,
+		"reject reconfiguration");
+	ksft_test_result_pass("ABI validation and one-time sealing\n");
+
+	require(!setns(host, CLONE_NEWUTS), "host administrator can leave family");
+	require(!unshare(CLONE_NEWUTS), "new UTS B");
+	b = nsfd("uts");
+	require(!ioctl(b, NS_UTS_SET_IDENTITY, &identity), "seal UTS B");
+	require(!setns(host, CLONE_NEWUTS), "restore host UTS");
+	pid = fork();
+	require(pid >= 0, "fork instance A");
+	if (!pid) {
+		check_guest(a, b, host, &identity, argc > 1 ? argv[1] : NULL);
+		_exit(0);
+	}
+	wait_ok(pid);
+	ksft_test_result_pass("instance A views, inheritance and escape rejection\n");
+
+	pid = fork();
+	require(pid >= 0, "fork instance B");
+	if (!pid) {
+		check_guest(b, a, host, &identity, NULL);
+		_exit(0);
+	}
+	wait_ok(pid);
+	ksft_test_result_pass("sibling identity family isolation\n");
+
+	require(!uname(&after) && !memcmp(&before, &after, sizeof(before)),
+		"host uname unchanged");
+	text("/proc/version", banner_after, sizeof(banner_after));
+	require(!strcmp(banner_before, banner_after), "host banner unchanged");
+	ksft_test_result_pass("host identity unchanged\n");
+
+	pid = fork();
+	require(pid >= 0, "fork capability test");
+	if (!pid) {
+		struct __user_cap_header_struct header = {
+			.version = _LINUX_CAPABILITY_VERSION_3,
+		};
+		struct __user_cap_data_struct caps[2] = {};
+		pid_t child;
+
+		require(!unshare(CLONE_NEWPID), "new unconfigured guest PID namespace");
+		child = fork();
+		require(child >= 0, "fork unconfigured guest");
+		if (!child) {
+			require(ioctl(a, NS_UTS_GET_IDENTITY, &actual) == -1 && errno == EPERM,
+				"unconfigured guest cannot inspect a sealed family");
+			require(setns(a, CLONE_NEWUTS) == -1 && errno == EPERM,
+				"unconfigured guest cannot enter a sealed family");
+			_exit(0);
+		}
+		wait_ok(child);
+		require(!syscall(SYS_capset, &header, caps), "drop capabilities");
+		require(ioctl(a, NS_UTS_SET_IDENTITY, &identity) == -1 && errno == EPERM,
+			"initial namespace without capability cannot configure");
+		_exit(0);
+	}
+	wait_ok(pid);
+	ksft_test_result_pass("initial namespace capability requirement\n");
+	close(a);
+	close(b);
+	close(host);
+	ksft_exit_pass();
+}
-- 
