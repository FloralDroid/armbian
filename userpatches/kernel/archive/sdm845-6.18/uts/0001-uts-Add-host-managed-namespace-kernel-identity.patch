 		return open_related_ns(ns, ns_get_owner);
 	case NS_GET_PARENT:
diff --git a/fs/proc/version.c b/fs/proc/version.c
index 02e3c3cd4..ca33a6a19 100644
--- a/fs/proc/version.c
+++ b/fs/proc/version.c
@@ -9,10 +9,14 @@
 
 static int version_proc_show(struct seq_file *m, void *v)
 {
-	seq_printf(m, linux_proc_banner,
-		utsname()->sysname,
-		utsname()->release,
-		utsname()->version);
+	down_read(&uts_sem);
+	if (utsname_has_identity())
+		seq_printf(m, "%s version %s %s\n", utsname()->sysname,
+			   utsname()->release, utsname()->version);
+	else
+		seq_printf(m, linux_proc_banner, utsname()->sysname,
+			   utsname()->release, utsname()->version);
+	up_read(&uts_sem);
 	return 0;
 }
 
