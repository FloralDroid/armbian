diff --git a/include/linux/utsname.h b/include/linux/utsname.h
index 547bd4439..7202526f4 100644
--- a/include/linux/utsname.h
+++ b/include/linux/utsname.h
@@ -36,6 +36,16 @@ static inline struct new_utsname *init_utsname(void)
 	return &init_uts_ns.name;
 }
 
+/* Read together with name under uts_sem. */
+static inline bool utsname_has_identity(void)
+{
+#ifdef CONFIG_UTS_NS_IDENTITY
+	return current->nsproxy->uts_ns->identity_id != 0;
+#else
+	return false;
+#endif
+}
+
 extern struct rw_semaphore uts_sem;
 
 #endif /* _LINUX_UTSNAME_H */
diff --git a/include/uapi/linux/nsfs.h b/include/uapi/linux/nsfs.h
index e098759ec..61ef1665f 100644
--- a/include/uapi/linux/nsfs.h
+++ b/include/uapi/linux/nsfs.h
@@ -4,6 +4,7 @@
 
 #include <linux/ioctl.h>
 #include <linux/types.h>
+#include <linux/utsname.h>
 
 #define NSIO	0xb7
 
@@ -44,6 +45,21 @@ struct mnt_ns_info {
 #define NS_GET_MNTNS_ID		_IOR(NSIO, 5,  __u64)
 #define NS_GET_ID		_IOR(NSIO, 13, __u64)
 
+/* Project extension with the same fixed layout for native and compat ABIs. */
+#define UTS_NS_IDENTITY_VERSION	1
+#define UTS_NS_IDENTITY_SEALED	(1U << 0)
+
+struct uts_ns_identity {
+	__u32 abi_version;
+	__u32 flags;
+	char release[__NEW_UTS_LEN + 1];
+	char version[__NEW_UTS_LEN + 1];
+	__u8 reserved[6];
+};
+
+#define NS_UTS_GET_IDENTITY	_IOR(NSIO, 0x80, struct uts_ns_identity)
+#define NS_UTS_SET_IDENTITY	_IOW(NSIO, 0x81, struct uts_ns_identity)
+
 enum init_ns_ino {
 	IPC_NS_INIT_INO		= 0xEFFFFFFFU,
 	UTS_NS_INIT_INO		= 0xEFFFFFFEU,
diff --git a/init/Kconfig b/init/Kconfig
index 6ce315af4..20d082d0a 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1364,6 +1364,16 @@ config UTS_NS
 	  In this namespace tasks see different info provided with the
 	  uname() system call
 
+config UTS_NS_IDENTITY
+	bool "Host-managed UTS kernel identity"
+	depends on UTS_NS && PID_NS
+	help
+	  Allow an administrator in the initial user and PID namespaces to
+	  configure and seal the kernel release and version of a noninitial
+	  UTS namespace through its namespace file descriptor. Descendants
+	  inherit the identity, including restrictions on namespace switching.
+	  Unconfigured namespaces retain the normal kernel identity.
+
 config TIME_NS
 	bool "TIME namespace"
 	depends on GENERIC_GETTIMEOFDAY
diff --git a/kernel/sys.c b/kernel/sys.c
index c8376d7a0..fc88230dc 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1329,10 +1329,48 @@ static int override_release(char __user *release, size_t len)
 	if (current->personality & UNAME26) {
 		const char *rest = UTS_RELEASE;
 		char buf[65] = { 0 };
+		char identity_release[__NEW_UTS_LEN + 1];
 		int ndots = 0;
 		unsigned v;
 		size_t copy;
 
+		v = LINUX_VERSION_PATCHLEVEL + 60;
+		if (IS_ENABLED(CONFIG_UTS_NS_IDENTITY)) {
+			char *minor, *end;
+			unsigned int patchlevel;
+			bool configured;
+
+			down_read(&uts_sem);
+			configured = utsname_has_identity();
+			if (configured)
+				memcpy(identity_release, utsname()->release,
+				       sizeof(identity_release));
+			up_read(&uts_sem);
+
+			if (configured) {
+				/* Never use the build identity for a configured namespace. */
+				minor = strchr(identity_release, '.');
+				if (!minor)
+					return 0;
+				minor++;
+				end = minor;
+				while (isdigit(*end))
+					end++;
+				if (end == minor)
+					return 0;
+				copy = end - minor;
+				memcpy(buf, minor, copy);
+				if (kstrtouint(buf, 10, &patchlevel) ||
+				    patchlevel > UINT_MAX - 60)
+					return 0;
+				v = patchlevel + 60;
+				if (identity_release[0] == '3' &&
+				    identity_release[1] == '.')
+					v = patchlevel + 40;
+				rest = identity_release;
+			}
+		}
+
 		while (*rest) {
 			if (*rest == '.' && ++ndots >= 3)
 				break;
@@ -1340,7 +1378,6 @@ static int override_release(char __user *release, size_t len)
 				break;
 			rest++;
 		}
-		v = LINUX_VERSION_PATCHLEVEL + 60;
 		copy = clamp_t(size_t, len, 1, sizeof(buf));
 		copy = scnprintf(buf, copy, "2.6.%u%s", v, rest);
 		ret = copy_to_user(release, buf, copy + 1);
diff --git a/kernel/utsname.c b/kernel/utsname.c
index ebbfc578a..9638a908c 100644
--- a/kernel/utsname.c
+++ b/kernel/utsname.c
@@ -15,6 +15,11 @@
 #include <linux/proc_ns.h>
 #include <linux/nstree.h>
 #include <linux/sched/task.h>
+#ifdef CONFIG_UTS_NS_IDENTITY
+#include <linux/nsfs.h>
+#include <linux/pid_namespace.h>
+#include <linux/uaccess.h>
+#endif
 
 static struct kmem_cache *uts_ns_cache __ro_after_init;
 
@@ -57,6 +62,9 @@ static struct uts_namespace *clone_uts_ns(struct user_namespace *user_ns,
 	ns->ucounts = ucounts;
 	down_read(&uts_sem);
 	memcpy(&ns->name, &old_ns->name, sizeof(ns->name));
+#ifdef CONFIG_UTS_NS_IDENTITY
+	ns->identity_id = old_ns->identity_id;
+#endif
 	ns->user_ns = get_user_ns(user_ns);
 	up_read(&uts_sem);
 	ns_tree_add(ns);
@@ -124,6 +132,90 @@ static void utsns_put(struct ns_common *ns)
 	put_uts_ns(to_uts_ns(ns));
 }
 
+#ifdef CONFIG_UTS_NS_IDENTITY
+static bool uts_identity_admin(void)
+{
+	return current_user_ns() == &init_user_ns &&
+		task_active_pid_ns(current) == &init_pid_ns &&
+		capable(CAP_SYS_ADMIN);
+}
+
+/* Possession of a namespace FD does not allow leaving an identity family. */
+static bool uts_identity_accessible(struct uts_namespace *ns)
+{
+	u64 current_id = current->nsproxy->uts_ns->identity_id;
+
+	return current_id == ns->identity_id;
+}
+
+static bool uts_identity_string_valid(const char *str, bool release)
+{
+	size_t len = strnlen(str, __NEW_UTS_LEN + 1);
+	size_t i;
+
+	if (!len || len > __NEW_UTS_LEN)
+		return false;
+
+	for (i = 0; i < len; i++) {
+		if (str[i] < (release ? '!' : ' ') || str[i] > '~')
+			return false;
+	}
+
+	return true;
+}
+
+long uts_identity_ioctl(struct uts_namespace *ns, unsigned int cmd,
+			unsigned long arg)
+{
+	struct uts_ns_identity identity = {};
+	void __user *argp = (void __user *)arg;
+	bool admin = uts_identity_admin();
+	int ret = 0;
+
+	if (cmd == NS_UTS_GET_IDENTITY) {
+		down_read(&uts_sem);
+		if (!admin && !uts_identity_accessible(ns)) {
+			up_read(&uts_sem);
+			return -EPERM;
+		}
+
+		identity.abi_version = UTS_NS_IDENTITY_VERSION;
+		identity.flags = ns->identity_id ? UTS_NS_IDENTITY_SEALED : 0;
+		strscpy(identity.release, ns->name.release);
+		strscpy(identity.version, ns->name.version);
+		up_read(&uts_sem);
+
+		return copy_to_user(argp, &identity, sizeof(identity)) ? -EFAULT : 0;
+	}
+
+	if (!admin || ns == &init_uts_ns)
+		return -EPERM;
+
+	if (copy_from_user(&identity, argp, sizeof(identity)))
+		return -EFAULT;
+
+	if (identity.abi_version != UTS_NS_IDENTITY_VERSION || identity.flags ||
+	    memchr_inv(identity.reserved, 0, sizeof(identity.reserved)) ||
+	    !uts_identity_string_valid(identity.release, true) ||
+	    !uts_identity_string_valid(identity.version, false))
+		return -EINVAL;
+
+	down_write(&uts_sem);
+	if (ns->identity_id) {
+		ret = -EBUSY;
+	} else {
+		/* uname copies full arrays, so clear any old host identity bytes. */
+		strscpy_pad(ns->name.release, identity.release);
+		strscpy_pad(ns->name.version, identity.version);
+		/* Descendants retain this boot-unique identity family ID. */
+		ns->identity_id = ns->ns.ns_id;
+	}
+	up_write(&uts_sem);
+
+	return ret;
+}
+#endif
+
 static int utsns_install(struct nsset *nsset, struct ns_common *new)
 {
 	struct nsproxy *nsproxy = nsset->nsproxy;
@@ -133,6 +225,18 @@ static int utsns_install(struct nsset *nsset, struct ns_common *new)
 	    !ns_capable(nsset->cred->user_ns, CAP_SYS_ADMIN))
 		return -EPERM;
 
+#ifdef CONFIG_UTS_NS_IDENTITY
+	if (!uts_identity_admin()) {
+		bool accessible;
+
+		down_read(&uts_sem);
+		accessible = uts_identity_accessible(ns);
+		up_read(&uts_sem);
+		if (!accessible)
+			return -EPERM;
+	}
+#endif
+
 	get_uts_ns(ns);
 	put_uts_ns(nsproxy->uts_ns);
 	nsproxy->uts_ns = ns;
