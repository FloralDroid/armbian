+void uts_resources_put(struct uts_namespace *ns);
+bool uts_resources_may_enter(struct uts_namespace *old, struct uts_namespace *new);
+int uts_resources_sysinfo(struct sysinfo *info);
+int uts_resources_proc(struct seq_file *m, enum uts_resource_proc which);
+bool uts_resources_active(void);
+int uts_resources_cpu_visible(unsigned int cpu);
+void memory_resource_watermarks(u64 managed, u64 watermarks[3]);
+#else
+static inline void uts_resources_copy(struct uts_namespace *ns, struct uts_namespace *old) {}
+static inline void uts_resources_put(struct uts_namespace *ns) {}
+static inline bool uts_resources_may_enter(struct uts_namespace *old, struct uts_namespace *new)
+{
+	return true;
+}
+static inline int uts_resources_sysinfo(struct sysinfo *info) { return 0; }
+static inline int uts_resources_proc(struct seq_file *m, enum uts_resource_proc which) { return 0; }
+static inline bool uts_resources_active(void) { return false; }
+static inline int uts_resources_cpu_visible(unsigned int cpu) { return 1; }
