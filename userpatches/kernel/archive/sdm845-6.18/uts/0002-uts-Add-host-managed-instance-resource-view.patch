+	UR_SLAB_RECLAIMABLE, UR_SLAB_UNRECLAIMABLE, UR_KERNEL_STACK,
+	UR_PAGETABLES, UR_SOCK, UR_SWAP_TOTAL, UR_SWAP_CURRENT, UR_SWAP_FREE,
+	UR_SWAP_CACHED, UR_PGFAULT, UR_PGMAJFAULT, UR_PGPGIN, UR_PGPGOUT,
+	UR_PGSCAN, UR_PGSTEAL, UR_CPU_USAGE, UR_CPU_USER, UR_CPU_SYSTEM,
+	UR_CPUS, UR_THREADS, UR_RUNNING, UR_UNINTERRUPTIBLE,
+	UR_LOAD1, UR_LOAD5, UR_LOAD15, UR_UPTIME, UR_IDLE,
+	UR_READ_BYTES, UR_WRITE_BYTES, UR_READ_OPS, UR_WRITE_OPS,
+	UR_CPU_PRESSURE, UR_MEM_PRESSURE, UR_IO_PRESSURE,
+};
+
+struct uts_resource_binding {
+	__u32 abi;
+	__u32 flags;
+	__s32 cgroup_fd;
+	__u32 reserved0;
