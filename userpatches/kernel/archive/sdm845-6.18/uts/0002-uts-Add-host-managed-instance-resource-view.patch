+
+_Static_assert(sizeof(struct uts_resource_binding) == 48, "binding ABI");
+_Static_assert(sizeof(struct uts_resource_info) == 48, "info ABI");
+_Static_assert(sizeof(struct uts_resource_snapshot) == 512, "snapshot ABI");
+
+static pid_t owner_pid, child_pid;
+static char cleanup_root[256], cleanup_leaf[280];
+
+static void cleanup(void)
+{
+	if (getpid() != owner_pid)
+		return;
+	if (child_pid > 0) {
+		kill(child_pid, SIGKILL);
+		waitpid(child_pid, NULL, 0);
+	}
+	if (*cleanup_leaf)
+		rmdir(cleanup_leaf);
+	if (*cleanup_root)
+		rmdir(cleanup_root);
+}
+
+#define CHECK(test) do { \
+	if (!(test)) { \
+		fprintf(stderr, "FAIL line %d: %s (%s)\n", __LINE__, #test, strerror(errno)); \
+		exit(1); \
+	} \
+} while (0)
+
+static void put(const char *path, const char *value)
+{
+	int fd = open(path, O_WRONLY | O_CLOEXEC);
+
+	CHECK(fd >= 0);
+	CHECK(write(fd, value, strlen(value)) == (ssize_t)strlen(value));
+	CHECK(!close(fd));
+}
+
+static void check_file(const char *path, const char *required, const char *forbidden)
+{
+	char data[16384];
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	ssize_t size;
+
+	CHECK(fd >= 0);
+	size = read(fd, data, sizeof(data) - 1);
+	CHECK(size >= 0);
+	data[size] = 0;
+	if (required)
+		CHECK(strstr(data, required));
+	if (forbidden)
+		CHECK(!strstr(data, forbidden));
+	CHECK(!close(fd));
+}
+
+int main(int argc, char **argv)
+{
+	struct uts_resource_binding binding = { .abi = 1, .generation = { 1, 2 } };
+	struct uts_resource_info info;
+	struct uts_resource_snapshot snapshot;
+	struct uts_resource_memory memory;
+	struct sysinfo host, instance;
+	struct timespec now;
+	struct stat statbuf;
+	char root[256], leaf[280], path[320], text[64], byte;
+	int hostns, ns, cg, status, ready[2], finish[2];
+	pid_t child;
+
+	owner_pid = getpid();
+	CHECK(!atexit(cleanup));
+	CHECK(!syscall(SYS_sysinfo, &host));
+	hostns = open("/proc/self/ns/uts", O_RDONLY | O_CLOEXEC);
+	CHECK(hostns >= 0);
+	CHECK(!ioctl(hostns, NS_UTS_GET_RESOURCE_BINDING, &info));
+	CHECK(info.abi == 1 && !info.flags);
+	CHECK(!clock_gettime(CLOCK_BOOTTIME, &now));
+	binding.start_boottime_ns = (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+	snprintf(root, sizeof(root), "/sys/fs/cgroup/uts-resource-test-%d", getpid());
+	CHECK(!mkdir(root, 0700));
+	strcpy(cleanup_root, root);
+	cg = open(root, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	CHECK(cg >= 0 && !fstat(cg, &statbuf));
+	binding.cgroup_fd = cg;
+	CHECK(ioctl(hostns, NS_UTS_BIND_RESOURCES, &binding) == -1 && errno == EPERM);
+	snprintf(path, sizeof(path), "%s/memory.max", root);
+	put(path, "67108864");
+	snprintf(path, sizeof(path), "%s/memory.swap.max", root);
+	put(path, "33554432");
+	snprintf(path, sizeof(path), "%s/cgroup.subtree_control", root);
+	put(path, "+memory +cpu +cpuset +pids +io");
+	snprintf(leaf, sizeof(leaf), "%s/work", root);
+	CHECK(!mkdir(leaf, 0700));
+	strcpy(cleanup_leaf, leaf);
+	CHECK(!unshare(CLONE_NEWUTS));
+	ns = open("/proc/self/ns/uts", O_RDONLY | O_CLOEXEC);
+	CHECK(ns >= 0);
+	binding.flags = 2;
+	CHECK(ioctl(ns, NS_UTS_BIND_RESOURCES, &binding) == -1 && errno == EINVAL);
+	binding.flags = 0;
+	CHECK(!ioctl(ns, NS_UTS_BIND_RESOURCES, &binding));
+	CHECK(ioctl(ns, NS_UTS_BIND_RESOURCES, &binding) == -1 && errno == EBUSY);
+	CHECK(!ioctl(ns, NS_UTS_GET_RESOURCE_BINDING, &info));
+	CHECK(info.abi == 1 && info.flags == 1 && info.cgroup_id == statbuf.st_ino);
+	CHECK(info.generation[0] == 1 && info.generation[1] == 2);
+	CHECK(!pipe(ready) && !pipe(finish));
+	child = fork();
+	CHECK(child >= 0);
+	if (child > 0)
+		child_pid = child;
+	if (!child) {
+		/* Keep page touches observable so optimized tests still charge memory. */
+		volatile char *memory;
+		unsigned int i;
+
+		snprintf(path, sizeof(path), "%s/cgroup.procs", leaf);
+		snprintf(text, sizeof(text), "%d", getpid());
+		put(path, text);
+		memory = malloc(8 * 1024 * 1024);
+		CHECK(memory);
+		for (i = 0; i < 8 * 1024 * 1024; i++)
+			memory[i] = (char)i;
+		CHECK(write(ready[1], "x", 1) == 1);
+		CHECK(read(finish[0], &byte, 1) == 1);
+		_exit(0);
+	}
+	CHECK(read(ready[0], &byte, 1) == 1);
+	CHECK(!ioctl(ns, NS_UTS_GET_RESOURCE_SNAPSHOT, &snapshot));
+	CHECK(snapshot.abi == 1 && snapshot.size == 512 && snapshot.cgroup_id == info.cgroup_id);
+	CHECK(snapshot.values[UR_RAM_TOTAL] == 67108864);
+	CHECK(!ioctl(ns, NS_UTS_GET_RESOURCE_MEMORY, &memory));
+	CHECK(memory.abi == 1 && memory.size == 256 && memory.valid == 0xffff);
+	CHECK(memory.cgroup_id == info.cgroup_id && memory.values[URM_MANAGED] == 67108864ULL / (uint64_t)sysconf(_SC_PAGESIZE));
+	CHECK(memory.values[URM_MIN] <= memory.values[URM_LOW] &&
+	      memory.values[URM_LOW] <= memory.values[URM_HIGH]);
+	CHECK(snapshot.values[UR_RAM_CURRENT] >= 8 * 1024 * 1024);
+	CHECK(snapshot.values[UR_THREADS] >= 1 && snapshot.values[UR_CPUS] >= 1);
+	CHECK(snapshot.valid & (1ULL << UR_CPU_USAGE));
+	CHECK(!syscall(SYS_sysinfo, &instance));
+	CHECK((uint64_t)instance.totalram * instance.mem_unit == 67108864);
+	CHECK(instance.freeram <= instance.totalram && instance.bufferram == 0);
+	check_file("/proc/meminfo", "MemTotal:    65536 kB", NULL);
+	check_file("/proc/cpuinfo", "processor", "CPU implementer");
+	check_file("/proc/vmstat", "nr_free_pages ", NULL);
+	check_file("/proc/interrupts", NULL, "CPU");
+	check_file("/proc/zoneinfo", "Node 0, zone Normal", NULL);
+	check_file("/proc/buddyinfo", NULL, "Node");
+	check_file("/proc/swaps", "Filename", "/dev/");
+	if (argc > 1) {
+		pid_t compat = fork();
+
+		CHECK(compat >= 0);
+		if (!compat) {
+			execl(argv[1], argv[1], NULL);
+			_exit(127);
+		}
+		CHECK(waitpid(compat, &status, 0) == compat && WIFEXITED(status) && !WEXITSTATUS(status));
+	}
+	/* A guest root with CAP_SYS_ADMIN is still outside the initial PID namespace. */
+	CHECK(!unshare(CLONE_NEWPID));
+	{
+		pid_t guest = fork();
+
+		CHECK(guest >= 0);
+		if (!guest) {
+			CHECK(ioctl(ns, NS_UTS_BIND_RESOURCES, &binding) == -1 && errno == EPERM);
+			CHECK(setns(hostns, CLONE_NEWUTS) == -1 && errno == EPERM);
+			CHECK(!unshare(CLONE_NEWUTS));
+			CHECK(!syscall(SYS_sysinfo, &instance));
+			CHECK((uint64_t)instance.totalram * instance.mem_unit == 67108864);
+			_exit(0);
+		}
+		CHECK(waitpid(guest, &status, 0) == guest && WIFEXITED(status) && !WEXITSTATUS(status));
+	}
+	CHECK(write(finish[1], "x", 1) == 1);
+	CHECK(waitpid(child, &status, 0) == child && WIFEXITED(status) && !WEXITSTATUS(status));
+	child_pid = 0;
+	CHECK(!rmdir(leaf) && !rmdir(root));
+	CHECK(ioctl(ns, NS_UTS_GET_RESOURCE_SNAPSHOT, &snapshot) == -1 && errno == ENODEV);
+	CHECK(syscall(SYS_sysinfo, &instance) == -1 && errno == ENODEV);
+	CHECK(!setns(hostns, CLONE_NEWUTS));
+	CHECK(!syscall(SYS_sysinfo, &instance));
+	CHECK(instance.totalram == host.totalram && instance.mem_unit == host.mem_unit);
+	puts("PASS: resource ABI, descendant accounting, raw sysinfo/proc, guest root permissions, inheritance and offline failure");
+	return 0;
+}
