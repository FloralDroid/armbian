+
+struct uts_resource_view {
+	refcount_t refs;
+	struct mutex lock;
+	struct cgroup *root;
+	struct uts_resource_info binding;
+	u64 load_sample;
+	unsigned long loads[3];
+	unsigned long previous_active;
+};
+
+static struct uts_resource_view *current_resource_view(void)
+{
+	/* Pair with the host's one-time publication of fully initialized fields. */
+	return smp_load_acquire(&current->nsproxy->uts_ns->resources);
+}
+
+static bool resource_admin(void)
+{
+	return current_user_ns() == &init_user_ns &&
+		task_active_pid_ns(current) == &init_pid_ns && capable(CAP_SYS_ADMIN);
+}
+
+void uts_resources_copy(struct uts_namespace *ns, struct uts_namespace *old)
+{
+	ns->resources = old->resources;
+	if (ns->resources)
+		refcount_inc(&ns->resources->refs);
+}
+
+void uts_resources_put(struct uts_namespace *ns)
+{
+	struct uts_resource_view *view = ns->resources;
+
+	if (view && refcount_dec_and_test(&view->refs)) {
+		cgroup_put(view->root);
+		kfree(view);
+	}
+}
+
+bool uts_resources_may_enter(struct uts_namespace *old, struct uts_namespace *new)
+{
+	bool allowed;
+
+	down_read(&uts_sem);
+	allowed = old->resources == new->resources || resource_admin();
+	up_read(&uts_sem);
+	return allowed;
+}
+
+bool uts_resources_active(void)
+{
+	return current_resource_view() != NULL;
+}
+
+int uts_resources_cpu_visible(unsigned int cpu)
+{
+	struct uts_resource_view *view = current_resource_view();
+	cpumask_var_t cpus;
+	bool visible;
+
+	if (!view)
+		return 1;
+	if (css_is_dying(&view->root->self))
+		return -ENODEV;
+	if (!alloc_cpumask_var(&cpus, GFP_KERNEL))
+		return -ENOMEM;
+	cpuset_cgroup_cpus(view->root, cpus);
+	visible = cpumask_test_cpu(cpu, cpus);
+	free_cpumask_var(cpus);
+	return visible;
+}
+
+static void field(struct uts_resource_snapshot *s, unsigned int n, u64 value)
+{
+	s->values[n] = value;
+	s->valid |= BIT_ULL(n);
+}
+
+/* Counts charged to this memcg include its descendants, not a calling app leaf. */
+static int memory_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s,
+			   struct uts_resource_memory *memory)
+{
+	struct cgroup_subsys_state *css;
+	struct mem_cgroup *memcg, *parent;
+	u64 total, used, swap, swap_used, free, reclaim;
+	const int states[] = {
+		NR_ANON_MAPPED, NR_FILE_PAGES, NR_FILE_MAPPED, NR_SHMEM,
+		NR_FILE_DIRTY, NR_WRITEBACK, NR_INACTIVE_ANON, NR_ACTIVE_ANON,
+		NR_INACTIVE_FILE, NR_ACTIVE_FILE,
+	};
+	unsigned int i;
+
+	css = cgroup_get_e_css(view->root, &memory_cgrp_subsys);
+	if (!css)
+		return -ENODEV;
+	if (css->cgroup != view->root) {
+		css_put(css);
+		return -ENODEV;
+	}
+	memcg = mem_cgroup_from_css(css);
+	mem_cgroup_flush_stats(memcg);
+	total = (u64)totalram_pages() << PAGE_SHIFT;
+	swap = (u64)total_swap_pages << PAGE_SHIFT;
+	for (parent = memcg; parent; parent = parent_mem_cgroup(parent)) {
+		total = min(total, (u64)READ_ONCE(parent->memory.max) << PAGE_SHIFT);
+		swap = min(swap, (u64)READ_ONCE(parent->swap.max) << PAGE_SHIFT);
+	}
+	used = (u64)page_counter_read(&memcg->memory) << PAGE_SHIFT;
+	swap_used = (u64)page_counter_read(&memcg->swap) << PAGE_SHIFT;
+	free = total > used ? total - used : 0;
+	field(s, UR_RAM_TOTAL, total);
+	field(s, UR_RAM_CURRENT, used);
+	field(s, UR_RAM_FREE, free);
+	for (i = 0; i < ARRAY_SIZE(states); i++)
+		field(s, UR_ANON + i, (u64)memcg_page_state(memcg, states[i]) << PAGE_SHIFT);
+	field(s, UR_SLAB_RECLAIMABLE, memcg_page_state(memcg, NR_SLAB_RECLAIMABLE_B));
+	field(s, UR_SLAB_UNRECLAIMABLE, memcg_page_state(memcg, NR_SLAB_UNRECLAIMABLE_B));
+	field(s, UR_KERNEL_STACK, (u64)memcg_page_state(memcg, NR_KERNEL_STACK_KB) * 1024);
+	field(s, UR_PAGETABLES, (u64)memcg_page_state(memcg, NR_PAGETABLE) << PAGE_SHIFT);
+	field(s, UR_SOCK, (u64)memcg_page_state(memcg, MEMCG_SOCK) << PAGE_SHIFT);
+	field(s, UR_SWAP_CACHED, (u64)memcg_page_state(memcg, NR_SWAPCACHE) << PAGE_SHIFT);
+	field(s, UR_SWAP_TOTAL, swap);
+	field(s, UR_SWAP_CURRENT, swap_used);
+	field(s, UR_SWAP_FREE, swap > swap_used ? swap - swap_used : 0);
+	reclaim = s->values[UR_FILE] > s->values[UR_SHMEM] ?
+		s->values[UR_FILE] - s->values[UR_SHMEM] : 0;
+	field(s, UR_RAM_AVAILABLE, min(total, free + reclaim + s->values[UR_SLAB_RECLAIMABLE]));
+	field(s, UR_PGFAULT, memcg_events(memcg, PGFAULT));
+	field(s, UR_PGMAJFAULT, memcg_events(memcg, PGMAJFAULT));
+	field(s, UR_PGSCAN, memcg_events(memcg, PGSCAN_KSWAPD) + memcg_events(memcg, PGSCAN_DIRECT));
+	field(s, UR_PGSTEAL, memcg_events(memcg, PGSTEAL_KSWAPD) + memcg_events(memcg, PGSTEAL_DIRECT));
+	if (memory) {
+		u64 *v = memory->values;
+
+		v[URM_FREE] = free >> PAGE_SHIFT;
+		v[URM_INACTIVE_FILE] = s->values[UR_INACTIVE_FILE] >> PAGE_SHIFT;
+		v[URM_ACTIVE_FILE] = s->values[UR_ACTIVE_FILE] >> PAGE_SHIFT;
+		v[URM_REFAULT_ANON] = memcg_page_state(memcg, WORKINGSET_REFAULT_ANON);
+		v[URM_REFAULT_FILE] = memcg_page_state(memcg, WORKINGSET_REFAULT_FILE);
+		v[URM_SCAN_KSWAPD] = memcg_events(memcg, PGSCAN_KSWAPD);
+		v[URM_SCAN_DIRECT] = memcg_events(memcg, PGSCAN_DIRECT);
+		v[URM_DIRECT_THROTTLE] = memcg_events(memcg, PGSCAN_DIRECT_THROTTLE);
+		v[URM_STEAL_KSWAPD] = memcg_events(memcg, PGSTEAL_KSWAPD);
+		v[URM_STEAL_DIRECT] = memcg_events(memcg, PGSTEAL_DIRECT);
+		v[URM_MANAGED] = total >> PAGE_SHIFT;
+		v[URM_FILE] = s->values[UR_FILE] >> PAGE_SHIFT;
+		v[URM_SHMEM] = s->values[UR_SHMEM] >> PAGE_SHIFT;
+		memory_resource_watermarks(v[URM_MANAGED], &v[URM_MIN]);
+		memory->valid = GENMASK_ULL(15, 0);
+	}
+	css_put(css);
+	return 0;
+}
+
+static void task_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s)
+{
+	struct cgroup_subsys_state *css;
+	struct css_task_iter iter;
+	struct task_struct *task;
+	u64 threads = 0, running = 0, blocked = 0;
+	unsigned int state;
+
+	rcu_read_lock();
+	css_for_each_descendant_pre(css, &view->root->self) {
+		if (!css_tryget_online(css))
+			continue;
+		rcu_read_unlock();
+		css_task_iter_start(css, 0, &iter);
+		while ((task = css_task_iter_next(&iter))) {
+			state = READ_ONCE(task->__state);
+			threads++;
+			running += state == TASK_RUNNING;
+			blocked += !!(state & TASK_UNINTERRUPTIBLE);
+		}
+		css_task_iter_end(&iter);
+		rcu_read_lock();
+		css_put(css);
+	}
+	rcu_read_unlock();
+	field(s, UR_THREADS, threads);
+	field(s, UR_RUNNING, running);
+	field(s, UR_UNINTERRUPTIBLE, blocked);
+}
+
+static int resource_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s)
+{
+	struct task_cputime cpu;
+	u64 elapsed, unused;
+	unsigned long active, count;
+	cpumask_var_t cpus;
+	int ret, i;
+	static const unsigned long exps[] = { 2014, 2041, 2046 };
+
+	if (!alloc_cpumask_var(&cpus, GFP_KERNEL))
+		return -ENOMEM;
+	mutex_lock(&view->lock);
+	if (css_is_dying(&view->root->self)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	memset(s, 0, sizeof(*s));
+	s->abi = 1;
+	s->size = sizeof(*s);
+	s->sample_boottime_ns = ktime_get_boottime_ns();
+	s->cgroup_id = view->binding.cgroup_id;
+	memcpy(s->generation, view->binding.generation, sizeof(s->generation));
+	s->start_boottime_ns = view->binding.start_boottime_ns;
+	ret = memory_snapshot(view, s, NULL);
+	if (ret)
+		goto out;
+	cgroup_resource_cputime(view->root, &cpu);
+	field(s, UR_CPU_USAGE, cpu.sum_exec_runtime);
+	field(s, UR_CPU_USER, cpu.utime);
+	field(s, UR_CPU_SYSTEM, cpu.stime);
+	cpuset_cgroup_cpus(view->root, cpus);
+	field(s, UR_CPUS, cpumask_weight(cpus));
+	task_snapshot(view, s);
+	elapsed = s->sample_boottime_ns - s->start_boottime_ns;
+	field(s, UR_UPTIME, elapsed);
+	unused = elapsed * s->values[UR_CPUS];
+	field(s, UR_IDLE, unused > s->values[UR_CPU_USAGE] ? unused - s->values[UR_CPU_USAGE] : 0);
+	count = div_u64(s->sample_boottime_ns - view->load_sample, NSEC_PER_SEC);
+	if (count) {
+		active = view->previous_active;
+		for (i = 0; i < 3; i++)
+			view->loads[i] = calc_load_n(view->loads[i], exps[i], active, count);
+		view->load_sample += (u64)count * NSEC_PER_SEC;
+	}
+	view->previous_active = (s->values[UR_RUNNING] + s->values[UR_UNINTERRUPTIBLE]) * FIXED_1;
+	for (i = 0; i < 3; i++)
+		field(s, UR_LOAD1 + i, view->loads[i] << (SI_LOAD_SHIFT - FSHIFT));
+#ifdef CONFIG_BLK_CGROUP
+	{
+		u64 io[4];
+
+		if (!blkcg_resource_stats(view->root, io))
+			for (i = 0; i < ARRAY_SIZE(io); i++)
+				field(s, UR_READ_BYTES + i, io[i]);
+	}
+#endif
+#ifdef CONFIG_PSI
+	{
+		u64 totals[3];
+
+		if (!psi_resource_totals(view->root, totals))
+			for (i = 0; i < ARRAY_SIZE(totals); i++)
+				field(s, UR_CPU_PRESSURE + i, totals[i]);
+	}
+#endif
+
+out:
+	mutex_unlock(&view->lock);
+	free_cpumask_var(cpus);
+	return ret;
+}
+
+static int resource_memory_snapshot(struct uts_resource_view *view,
+				    struct uts_resource_memory *memory)
+{
+	struct uts_resource_snapshot primary = {};
+	int ret;
+
+	mutex_lock(&view->lock);
+	if (css_is_dying(&view->root->self)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	memset(memory, 0, sizeof(*memory));
+	memory->abi = 1;
+	memory->size = sizeof(*memory);
+	memory->sample_boottime_ns = ktime_get_boottime_ns();
+	memory->cgroup_id = view->binding.cgroup_id;
+	memcpy(memory->generation, view->binding.generation, sizeof(memory->generation));
+	memory->start_boottime_ns = view->binding.start_boottime_ns;
+	ret = memory_snapshot(view, &primary, memory);
+out:
+	mutex_unlock(&view->lock);
+	return ret;
+}
+
+long uts_resources_ioctl(struct uts_namespace *ns, unsigned int cmd, unsigned long arg)
+{
+	void __user *argp = (void __user *)arg;
+	struct uts_resource_view *view;
+	struct uts_resource_binding binding;
+	struct uts_resource_info info = { .abi = 1 };
+	struct uts_resource_snapshot *snapshot;
+	struct cgroup *cgroup;
+	long ret;
+
+	if (cmd == NS_UTS_BIND_RESOURCES) {
+		if (!resource_admin() || ns == &init_uts_ns)
+			return -EPERM;
+		if (copy_from_user(&binding, argp, sizeof(binding)))
+			return -EFAULT;
+		if (binding.abi != 1 || binding.flags || binding.reserved0 || binding.reserved1 ||
+		    !binding.start_boottime_ns || binding.start_boottime_ns > ktime_get_boottime_ns() ||
+		    !(binding.generation[0] | binding.generation[1]))
+			return -EINVAL;
+		cgroup = cgroup_get_from_fd(binding.cgroup_fd);
+		if (IS_ERR(cgroup))
+			return PTR_ERR(cgroup);
+		if (!cgroup_parent(cgroup) || cgroup->root != &cgrp_dfl_root || css_is_dying(&cgroup->self)) {
+			cgroup_put(cgroup);
+			return -EINVAL;
+		}
+		view = kzalloc(sizeof(*view), GFP_KERNEL);
+		if (!view) {
+			cgroup_put(cgroup);
+			return -ENOMEM;
+		}
+		refcount_set(&view->refs, 1);
+		mutex_init(&view->lock);
+		view->root = cgroup;
+		view->binding.abi = 1;
+		view->binding.flags = 1;
+		view->binding.cgroup_id = cgroup_id(cgroup);
+		memcpy(view->binding.generation, binding.generation, sizeof(binding.generation));
+		view->binding.start_boottime_ns = binding.start_boottime_ns;
+		view->load_sample = binding.start_boottime_ns;
+		down_write(&uts_sem);
+		ret = ns->resources ? -EBUSY : 0;
+		if (!ret)
+			/* Publish immutable binding fields to the lockless readers. */
+			smp_store_release(&ns->resources, view);
+		up_write(&uts_sem);
+		if (ret) {
+			cgroup_put(cgroup);
+			kfree(view);
+		}
+		return ret;
+	}
+	down_read(&uts_sem);
+	view = ns->resources;
+	if (!resource_admin() && current->nsproxy->uts_ns->resources != view) {
+		up_read(&uts_sem);
+		return -EPERM;
+	}
+	if (cmd == NS_UTS_GET_RESOURCE_BINDING) {
+		if (view)
+			info = view->binding;
+		up_read(&uts_sem);
+		return copy_to_user(argp, &info, sizeof(info)) ? -EFAULT : 0;
+	}
+	up_read(&uts_sem);
+	if (!view)
+		return -ENODATA;
+	if (cmd == NS_UTS_GET_RESOURCE_MEMORY) {
+		struct uts_resource_memory memory;
+
+		ret = resource_memory_snapshot(view, &memory);
+		if (!ret && copy_to_user(argp, &memory, sizeof(memory)))
+			ret = -EFAULT;
+		return ret;
+	}
+	snapshot = kmalloc(sizeof(*snapshot), GFP_KERNEL);
+	if (!snapshot)
+		return -ENOMEM;
+	ret = resource_snapshot(view, snapshot);
+	if (!ret && copy_to_user(argp, snapshot, sizeof(*snapshot)))
+		ret = -EFAULT;
+	kfree(snapshot);
+	return ret;
+}
+
+int uts_resources_sysinfo(struct sysinfo *info)
+{
+	struct uts_resource_view *view = current_resource_view();
+	struct uts_resource_snapshot s;
+	int ret;
+
+	if (!view)
+		return 0;
+	ret = resource_snapshot(view, &s);
+	if (ret)
+		return ret;
+	memset(info, 0, sizeof(*info));
+	info->mem_unit = PAGE_SIZE;
+	info->totalram = s.values[UR_RAM_TOTAL] >> PAGE_SHIFT;
+	info->freeram = s.values[UR_RAM_FREE] >> PAGE_SHIFT;
+	info->sharedram = s.values[UR_SHMEM] >> PAGE_SHIFT;
+	info->totalswap = s.values[UR_SWAP_TOTAL] >> PAGE_SHIFT;
+	info->freeswap = s.values[UR_SWAP_FREE] >> PAGE_SHIFT;
+	info->uptime = DIV_ROUND_UP_ULL(s.values[UR_UPTIME], NSEC_PER_SEC);
+	info->procs = min_t(u64, s.values[UR_THREADS], USHRT_MAX);
+	info->loads[0] = s.values[UR_LOAD1];
+	info->loads[1] = s.values[UR_LOAD5];
+	info->loads[2] = s.values[UR_LOAD15];
+	return 1;
+}
+
+int uts_resources_proc(struct seq_file *m, enum uts_resource_proc which)
+{
+	struct uts_resource_view *view = current_resource_view();
+	struct uts_resource_snapshot s;
+	const u64 *v = s.values;
+	int ret;
+	static const struct { const char *name; unsigned int n; } memory[] = {
+		{ "MemTotal", UR_RAM_TOTAL }, { "MemFree", UR_RAM_FREE },
+		{ "MemAvailable", UR_RAM_AVAILABLE }, { "Cached", UR_FILE },
+		{ "SwapCached", UR_SWAP_CACHED }, { "AnonPages", UR_ANON },
+		{ "Mapped", UR_FILE_MAPPED }, { "Shmem", UR_SHMEM },
+		{ "Active(anon)", UR_ACTIVE_ANON }, { "Inactive(anon)", UR_INACTIVE_ANON },
+		{ "Active(file)", UR_ACTIVE_FILE }, { "Inactive(file)", UR_INACTIVE_FILE },
+		{ "SwapTotal", UR_SWAP_TOTAL }, { "SwapFree", UR_SWAP_FREE },
+		{ "Dirty", UR_DIRTY }, { "Writeback", UR_WRITEBACK },
+		{ "SReclaimable", UR_SLAB_RECLAIMABLE }, { "SUnreclaim", UR_SLAB_UNRECLAIMABLE },
+		{ "KernelStack", UR_KERNEL_STACK }, { "PageTables", UR_PAGETABLES },
+	};
+	int i;
+
+	if (!view)
+		return 0;
+	#ifdef CONFIG_PSI
+	if (which >= UR_PROC_PSI_CPU && which <= UR_PROC_PSI_IO) {
+		static const enum psi_res resources[] = { PSI_CPU, PSI_MEM, PSI_IO };
+		struct psi_group *group = cgroup_psi(view->root);
+
+		if (css_is_dying(&view->root->self) || !group || !group->enabled)
+			return -ENODEV;
+		ret = psi_show(m, group, resources[which - UR_PROC_PSI_CPU]);
+		return ret ? ret : 1;
+	}
+#endif
+	if (which == UR_PROC_VMSTAT || which == UR_PROC_ZONEINFO) {
+		struct uts_resource_memory memory;
+		const u64 *values = memory.values;
+
+		ret = resource_memory_snapshot(view, &memory);
+		if (ret)
+			return ret;
+		if (which == UR_PROC_ZONEINFO) {
+			seq_printf(m, "Node 0, zone Normal\n  per-node stats\n"
+				   "      nr_inactive_file %llu\n      nr_active_file %llu\n"
+				   "  pages free %llu\n        nr_free_pages %llu\n"
+				   "        min %llu\n        low %llu\n        high %llu\n"
+				   "        spanned %llu\n        present %llu\n        managed %llu\n"
+				   "        nr_free_cma 0\n        protection: (0)\n  pagesets\n",
+				   values[URM_INACTIVE_FILE], values[URM_ACTIVE_FILE],
+				   values[URM_FREE], values[URM_FREE],
+				   values[URM_MIN], values[URM_LOW], values[URM_HIGH],
+				   values[URM_MANAGED], values[URM_MANAGED], values[URM_MANAGED]);
+			return 1;
+		}
+		seq_printf(m, "nr_free_pages %llu\nnr_inactive_file %llu\nnr_active_file %llu\n"
+			   "nr_file_pages %llu\nnr_shmem %llu\nworkingset_refault %llu\n"
+			   "workingset_refault_anon %llu\nworkingset_refault_file %llu\n"
+			   "pgscan_kswapd %llu\npgscan_direct %llu\npgscan_direct_throttle %llu\n"
+			   "pgsteal_kswapd %llu\npgsteal_direct %llu\n",
+			   values[URM_FREE], values[URM_INACTIVE_FILE], values[URM_ACTIVE_FILE],
+			   values[URM_FILE], values[URM_SHMEM],
+			   values[URM_REFAULT_ANON] + values[URM_REFAULT_FILE],
+			   values[URM_REFAULT_ANON], values[URM_REFAULT_FILE],
+			   values[URM_SCAN_KSWAPD], values[URM_SCAN_DIRECT], values[URM_DIRECT_THROTTLE],
+			   values[URM_STEAL_KSWAPD], values[URM_STEAL_DIRECT]);
+	}
+	ret = resource_snapshot(view, &s);
+	if (ret)
+		return ret;
+	switch (which) {
+	case UR_PROC_MEMINFO:
+		for (i = 0; i < ARRAY_SIZE(memory); i++)
+			seq_printf(m, "%s: %8llu kB\n", memory[i].name, v[memory[i].n] / 1024);
+		seq_printf(m, "Buffers: %8u kB\nSlab: %8llu kB\nActive: %8llu kB\nInactive: %8llu kB\n",
+			0, (v[UR_SLAB_RECLAIMABLE] + v[UR_SLAB_UNRECLAIMABLE]) / 1024,
+			(v[UR_ACTIVE_ANON] + v[UR_ACTIVE_FILE]) / 1024,
+			(v[UR_INACTIVE_ANON] + v[UR_INACTIVE_FILE]) / 1024);
+		break;
+	case UR_PROC_STAT:
+		seq_printf(m, "cpu  %llu 0 %llu %llu 0 0 0 0 0 0\nprocs_running %llu\nprocs_blocked %llu\n",
+			nsec_to_clock_t(v[UR_CPU_USER]), nsec_to_clock_t(v[UR_CPU_SYSTEM]),
+			nsec_to_clock_t(v[UR_IDLE]), v[UR_RUNNING], v[UR_UNINTERRUPTIBLE]);
+		break;
+	case UR_PROC_UPTIME:
+		seq_printf(m, "%llu.%02llu %llu.%02llu\n",
+			v[UR_UPTIME] / NSEC_PER_SEC, (v[UR_UPTIME] % NSEC_PER_SEC) / (NSEC_PER_SEC / 100),
+			v[UR_IDLE] / NSEC_PER_SEC, (v[UR_IDLE] % NSEC_PER_SEC) / (NSEC_PER_SEC / 100));
+		break;
+	case UR_PROC_VMSTAT:
+		seq_printf(m, "pgfault %llu\npgmajfault %llu\npgscan %llu\npgsteal %llu\n",
+			v[UR_PGFAULT], v[UR_PGMAJFAULT], v[UR_PGSCAN], v[UR_PGSTEAL]);
+		break;
+	case UR_PROC_LOADAVG:
+		for (i = UR_LOAD1; i <= UR_LOAD15; i++)
+			seq_printf(m, "%llu.%02llu ", v[i] >> SI_LOAD_SHIFT,
+				((v[i] & ((1 << SI_LOAD_SHIFT) - 1)) * 100) >> SI_LOAD_SHIFT);
+		seq_printf(m, "%llu/%llu %d\n", v[UR_RUNNING], v[UR_THREADS],
+			idr_get_cursor(&task_active_pid_ns(current)->idr) - 1);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	return 1;
+}
