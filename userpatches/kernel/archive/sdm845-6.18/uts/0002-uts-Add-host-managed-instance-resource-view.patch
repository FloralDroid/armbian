diff --git a/block/blk-cgroup.c b/block/blk-cgroup.c
index 171efbbd3..caca5d571 100644
--- a/block/blk-cgroup.c
+++ b/block/blk-cgroup.c
@@ -1231,6 +1231,47 @@ static void blkcg_print_one_stat(struct blkcg_gq *blkg, struct seq_file *s)
 	seq_puts(s, "\n");
 }
 
+/* Aggregate the same hierarchical counters exported by io.stat. */
+int blkcg_resource_stats(struct cgroup *cgrp, u64 values[4])
+{
+	struct cgroup_subsys_state *css;
+	struct blkcg *blkcg;
+	struct blkcg_gq *blkg;
+	unsigned int seq;
+	u64 sample[4];
+	int i;
+
+	css = cgroup_get_e_css(cgrp, &io_cgrp_subsys);
+	if (!css)
+		return -ENODEV;
+	if (css->cgroup != cgrp) {
+		css_put(css);
+		return -ENODEV;
+	}
+	blkcg = css_to_blkcg(css);
+	css_rstat_flush(css);
+	memset(values, 0, sizeof(sample));
+	spin_lock_irq(&blkcg->lock);
+	hlist_for_each_entry(blkg, &blkcg->blkg_list, blkcg_node) {
+		struct blkg_iostat_set *bis = &blkg->iostat;
+
+		if (!blkg->online)
+			continue;
+		do {
+			seq = u64_stats_fetch_begin(&bis->sync);
+			sample[0] = bis->cur.bytes[BLKG_IOSTAT_READ];
+			sample[1] = bis->cur.bytes[BLKG_IOSTAT_WRITE];
+			sample[2] = bis->cur.ios[BLKG_IOSTAT_READ];
+			sample[3] = bis->cur.ios[BLKG_IOSTAT_WRITE];
+		} while (u64_stats_fetch_retry(&bis->sync, seq));
+		for (i = 0; i < ARRAY_SIZE(sample); i++)
+			values[i] += sample[i];
+	}
+	spin_unlock_irq(&blkcg->lock);
+	css_put(css);
+	return 0;
+}
+
 static int blkcg_print_stat(struct seq_file *sf, void *v)
 {
 	struct blkcg *blkcg = css_to_blkcg(seq_css(sf));
