+#ifdef CONFIG_UTS_NS_RESOURCES
+/* Model one Normal zone using the instance capacity and the allocator policy. */
+void memory_resource_watermarks(u64 managed, u64 watermarks[3])
+{
+	u64 minimum, distance;
+
+	minimum = clamp_t(u64, int_sqrt64((managed << (PAGE_SHIFT - 10)) * 16),
+			  128, 262144) >> (PAGE_SHIFT - 10);
+	minimum = min(minimum, managed);
+	distance = max(minimum >> 2,
+		       mult_frac(managed, READ_ONCE(watermark_scale_factor), 10000));
+	watermarks[0] = minimum;
+	watermarks[1] = min(managed, minimum + distance);
+	watermarks[2] = min(managed, watermarks[1] + distance);
+}
+#endif
