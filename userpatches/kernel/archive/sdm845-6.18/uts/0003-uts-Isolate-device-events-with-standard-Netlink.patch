 static inline bool uts_resources_may_enter(struct uts_namespace *old, struct uts_namespace *new)
@@ -39,4 +51,14 @@ static inline int uts_resources_proc(struct seq_file *m, enum uts_resource_proc
 static inline bool uts_resources_active(void) { return false; }
 static inline int uts_resources_cpu_visible(unsigned int cpu) { return 1; }
 #endif
+
+#if defined(CONFIG_UTS_NS_RESOURCES) && defined(CONFIG_NET)
