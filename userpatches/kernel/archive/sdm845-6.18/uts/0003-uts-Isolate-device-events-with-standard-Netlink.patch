From 0a57951cfbae43770a10e358c9e0873bcf9b496a Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sat, 31 Oct 2026 00:27:47 +0800
Subject: [PATCH] uts: Isolate device events with standard Netlink

Bind the receiving netns and approved DRM/V4L2 nodes to the immutable
instance resource domain. Project only authorized device and own-network
events, remove physical parent metadata and use an instance sequence.
Inherit ownership into child netns and restrict cross-domain setns.

Keep AF_NETLINK, socketcall and io_uring entry points and credentials
unchanged. No private userspace event transport is required. Host-only
fixed-layout nsfs ioctls bind once and report the sealed event view.

Kernel base: e8694cdbd7db99fa26f6e8c80a2a337e0de29a2f (6.18.53)
---
 fs/nsfs.c                     |  11 ++
 include/linux/uts_resources.h |  22 +++
 include/uapi/linux/nsfs.h     |  38 ++++
 kernel/uts_resources.c        |  50 ++++-
 lib/kobject_uevent.c          | 342 +++++++++++++++++++++++++++++++++-
 net/core/net_namespace.c      |   4 +
 6 files changed, 453 insertions(+), 14 deletions(-)

diff --git a/fs/nsfs.c b/fs/nsfs.c
index 9f144e913..f56a89157 100644
--- a/fs/nsfs.c
+++ b/fs/nsfs.c
@@ -179,6 +179,10 @@ static bool nsfs_ioctl_valid(unsigned int cmd)
 	case NS_GET_PID_IN_PIDNS:
 	case NS_GET_TGID_IN_PIDNS:
 	case NS_GET_ID:
+#if defined(CONFIG_UTS_NS_RESOURCES) && defined(CONFIG_NET)
+	case NS_UTS_BIND_EVENTS:
+	case NS_UTS_GET_EVENTS:
+#endif
 #ifdef CONFIG_UTS_NS_RESOURCES
 	case NS_UTS_BIND_RESOURCES:
 	case NS_UTS_GET_RESOURCE_BINDING:
@@ -236,6 +240,13 @@ static long ns_ioctl(struct file *filp, unsigned int ioctl,
 
 	ns = get_proc_ns(file_inode(filp));
 	switch (ioctl) {
+#if defined(CONFIG_UTS_NS_RESOURCES) && defined(CONFIG_NET)
+	case NS_UTS_BIND_EVENTS:
+	case NS_UTS_GET_EVENTS:
+		if (ns->ns_type != CLONE_NEWUTS)
+			return -EINVAL;
+		return uts_uevent_ioctl(to_uts_ns(ns), ioctl, arg);
+#endif
 #ifdef CONFIG_UTS_NS_RESOURCES
 	case NS_UTS_BIND_RESOURCES:
 	case NS_UTS_GET_RESOURCE_BINDING:
