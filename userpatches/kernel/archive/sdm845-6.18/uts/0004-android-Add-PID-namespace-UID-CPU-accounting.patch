@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_UID_CPUTIME_H
+#define _LINUX_UID_CPUTIME_H
+
+struct pid_namespace;
+struct task_struct;
+struct uid_cpu_stats;
+
+#ifdef CONFIG_ANDROID_UID_CPUTIME
+int uid_cputime_ns_init(struct pid_namespace *ns);
+void uid_cputime_ns_free(struct pid_namespace *ns);
+void uid_cputime_exit(struct task_struct *task);
+#else
+static inline int uid_cputime_ns_init(struct pid_namespace *ns) { return 0; }
+static inline void uid_cputime_ns_free(struct pid_namespace *ns) {}
+static inline void uid_cputime_exit(struct task_struct *task) {}
+#endif
+#endif
diff --git a/init/Kconfig b/init/Kconfig
index b0e59d995..7fd7b8ebf 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1384,6 +1384,16 @@ config UTS_NS_RESOURCES
 	  Unbound namespaces retain the original kernel behavior.
 
 
+config ANDROID_UID_CPUTIME
+	bool "Android per-UID CPU time accounting"
+	depends on PROC_FS && PID_NS
+	help
+	  Provide the Android uid_cputime proc interface independently in each
+	  PID namespace. CPU time includes live and exited threads and child
+	  namespaces. Removing a UID range affects only that proc namespace.
+	  With task I/O accounting, also provide the uid_io statistics and
+	  uid_procstat foreground/background state interface.
+
 config TIME_NS
 	bool "TIME namespace"
 	depends on GENERIC_GETTIMEOFDAY
