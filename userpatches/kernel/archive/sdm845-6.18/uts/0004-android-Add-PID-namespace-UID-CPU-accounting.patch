diff --git a/kernel/uid_cputime.c b/kernel/uid_cputime.c
new file mode 100644
index 000000000..37d4d39be
--- /dev/null
+++ b/kernel/uid_cputime.c
@@ -0,0 +1,431 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Android UID accounting, including descendants of each proc PID namespace. */
+#include <linux/cred.h>
+#include <linux/hashtable.h>
+#include <linux/init.h>
+#include <linux/mutex.h>
+#include <linux/pid_namespace.h>
+#include <linux/proc_fs.h>
+#include <linux/sched/cputime.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/uid_cputime.h>
+#include <linux/user_namespace.h>
+#include <linux/uts_resources.h>
+
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+enum uid_io_field {
+	UID_IO_RCHAR,
+	UID_IO_WCHAR,
+	UID_IO_READ_BYTES,
+	UID_IO_WRITE_BYTES,
+	UID_IO_FSYNC,
+	UID_IO_FIELDS,
+};
+#endif
+
+struct uid_cpu_entry {
+	struct hlist_node node;
+	kuid_t uid;
+	u64 user, system;
+	u64 active_user, active_system;
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+	u64 io_dead[UID_IO_FIELDS];
+	u64 io_active[UID_IO_FIELDS];
+	u64 io_last[UID_IO_FIELDS];
+	u64 io[2][UID_IO_FIELDS];
+	unsigned int state;
+#endif
+};
+
+struct uid_cpu_stats {
+	struct mutex lock;
+	DECLARE_HASHTABLE(entries, 6);
+	int error;
+};
+
+static bool uid_stats_live(struct pid_namespace *ns)
+{
+#ifdef CONFIG_UTS_NS_VIEWS
+	return !ns->uts_view || uts_resources_live(ns->uts_view);
+#else
+	return true;
+#endif
+}
+
+int uid_cputime_ns_init(struct pid_namespace *ns)
+{
+	struct uid_cpu_stats *stats;
+
+	stats = kzalloc(sizeof(*stats), GFP_KERNEL_ACCOUNT);
+	if (!stats)
+		return -ENOMEM;
+	mutex_init(&stats->lock);
+	hash_init(stats->entries);
+	smp_store_release(&ns->uid_cputime, stats);
+	return 0;
+}
+
+void uid_cputime_ns_free(struct pid_namespace *ns)
+{
+	struct uid_cpu_stats *stats = ns->uid_cputime;
+	struct uid_cpu_entry *entry;
+	struct hlist_node *next;
+	unsigned int bucket;
+
+	if (!stats)
+		return;
+	hash_for_each_safe(stats->entries, bucket, next, entry, node) {
+		hash_del(&entry->node);
+		kfree(entry);
+	}
+	kfree(stats);
+}
+
+static struct uid_cpu_entry *uid_cpu_entry(struct uid_cpu_stats *stats,
+					 kuid_t uid, gfp_t flags)
+{
+	struct uid_cpu_entry *entry;
+
+	hash_for_each_possible(stats->entries, entry, node, __kuid_val(uid))
+		if (uid_eq(entry->uid, uid))
+			return entry;
+	entry = kzalloc(sizeof(*entry), flags | __GFP_ACCOUNT);
+	if (entry) {
+		entry->uid = uid;
+		hash_add(stats->entries, &entry->node, __kuid_val(uid));
+	}
+	return entry;
+}
+
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+static void uid_io_add(u64 *target, struct task_struct *task)
+{
+	u64 written = READ_ONCE(task->ioac.write_bytes);
+	u64 cancelled = READ_ONCE(task->ioac.cancelled_write_bytes);
+
+	target[UID_IO_RCHAR] += READ_ONCE(task->ioac.rchar);
+	target[UID_IO_WCHAR] += READ_ONCE(task->ioac.wchar);
+	target[UID_IO_READ_BYTES] += READ_ONCE(task->ioac.read_bytes);
+	target[UID_IO_WRITE_BYTES] += written - min(written, cancelled);
+	target[UID_IO_FSYNC] += READ_ONCE(task->uid_fsync);
+}
+
+static void uid_io_update(struct uid_cpu_entry *entry)
+{
+	unsigned int i;
+
+	for (i = 0; i < UID_IO_FIELDS; i++) {
+		u64 total = entry->io_dead[i] + entry->io_active[i];
+
+		entry->io[entry->state][i] += total - min(total, entry->io_last[i]);
+		entry->io_last[i] = total;
+	}
+}
+#endif
+
+void uid_cputime_exit(struct task_struct *task)
+{
+	struct pid_namespace *ns;
+	kuid_t uid = task_uid(task);
+
+	for (ns = task_active_pid_ns(task); ns; ns = ns->parent) {
+		struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+		struct uid_cpu_entry *entry;
+		u64 user, system;
+
+		if (!stats)
+			continue;
+		mutex_lock(&stats->lock);
+		if (atomic64_read(&task->uid_cputime_accounted) & BIT_ULL(ns->level))
+			goto unlock;
+		entry = uid_cpu_entry(stats, uid, GFP_KERNEL);
+		if (!entry) {
+			stats->error = -ENOMEM;
+			goto unlock;
+		}
+		task_cputime_adjusted(task, &user, &system);
+		entry->user += user;
+		entry->system += system;
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+		uid_io_add(entry->io_dead, task);
+#endif
+		/* Readers hold this namespace's lock when checking the bit. */
+		atomic64_or(BIT_ULL(ns->level), &task->uid_cputime_accounted);
+unlock:
+		mutex_unlock(&stats->lock);
+	}
+}
+
+static int uid_stats_collect(struct uid_cpu_stats *stats,
+			     struct pid_namespace *ns)
+{
+	struct task_struct *group, *task;
+	struct uid_cpu_entry *entry;
+	unsigned int bucket;
+	u64 user, system;
+	int ret = stats->error;
+
+	if (ret)
+		return ret;
+	hash_for_each(stats->entries, bucket, entry, node) {
+		entry->active_user = 0;
+		entry->active_system = 0;
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+		memset(entry->io_active, 0, sizeof(entry->io_active));
+#endif
+	}
+	rcu_read_lock();
+	for_each_process_thread(group, task) {
+		if (!task_pid_nr_ns(task, ns) ||
+		    (atomic64_read(&task->uid_cputime_accounted) & BIT_ULL(ns->level)))
+			continue;
+		entry = uid_cpu_entry(stats, task_uid(task), GFP_ATOMIC);
+		if (!entry) {
+			ret = -ENOMEM;
+			break;
+		}
+		task_cputime_adjusted(task, &user, &system);
+		entry->active_user += user;
+		entry->active_system += system;
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+		uid_io_add(entry->io_active, task);
+#endif
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+static int uid_cputime_show(struct seq_file *m, void *unused)
+{
+	struct pid_namespace *ns = m->private;
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct user_namespace *user_ns = current_user_ns();
+	struct uid_cpu_entry *entry;
+	unsigned int bucket;
+	int ret;
+
+	if (!stats || !uid_stats_live(ns))
+		return -ENODEV;
+	mutex_lock(&stats->lock);
+	ret = uid_stats_collect(stats, ns);
+	if (ret)
+		goto out;
+	hash_for_each(stats->entries, bucket, entry, node) {
+		if (!kuid_has_mapping(user_ns, entry->uid))
+			continue;
+		seq_printf(m, "%u: %llu %llu\n", from_kuid(user_ns, entry->uid),
+			   div_u64(entry->user + entry->active_user, NSEC_PER_USEC),
+			   div_u64(entry->system + entry->active_system, NSEC_PER_USEC));
+	}
+out:
+	mutex_unlock(&stats->lock);
+	return ret;
+}
+
+static int uid_cputime_open(struct inode *inode, struct file *file)
+{
+	struct pid_namespace *ns = get_pid_ns(proc_pid_ns(inode->i_sb));
+	int ret = single_open(file, uid_cputime_show, ns);
+
+	if (ret)
+		put_pid_ns(ns);
+	return ret;
+}
+
+static int uid_cputime_release(struct inode *inode, struct file *file)
+{
+	struct pid_namespace *ns = ((struct seq_file *)file->private_data)->private;
+	int ret = single_release(inode, file);
+
+	put_pid_ns(ns);
+	return ret;
+}
+
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+static int uid_io_show(struct seq_file *m, void *unused)
+{
+	struct pid_namespace *ns = m->private;
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct user_namespace *user_ns = current_user_ns();
+	struct uid_cpu_entry *entry;
+	unsigned int bucket;
+	int ret;
+
+	if (!stats || !uid_stats_live(ns))
+		return -ENODEV;
+	mutex_lock(&stats->lock);
+	ret = uid_stats_collect(stats, ns);
+	if (ret)
+		goto out;
+	hash_for_each(stats->entries, bucket, entry, node) {
+		const u64 *fg = entry->io[0], *bg = entry->io[1];
+
+		if (!kuid_has_mapping(user_ns, entry->uid))
+			continue;
+		uid_io_update(entry);
+		seq_printf(m, "%u %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n",
+			   from_kuid(user_ns, entry->uid),
+			   fg[UID_IO_RCHAR], fg[UID_IO_WCHAR],
+			   fg[UID_IO_READ_BYTES], fg[UID_IO_WRITE_BYTES],
+			   bg[UID_IO_RCHAR], bg[UID_IO_WCHAR],
+			   bg[UID_IO_READ_BYTES], bg[UID_IO_WRITE_BYTES],
+			   fg[UID_IO_FSYNC], bg[UID_IO_FSYNC]);
+	}
+out:
+	mutex_unlock(&stats->lock);
+	return ret;
+}
+
+static int uid_io_open(struct inode *inode, struct file *file)
+{
+	struct pid_namespace *ns = get_pid_ns(proc_pid_ns(inode->i_sb));
+	int ret = single_open(file, uid_io_show, ns);
+
+	if (ret)
+		put_pid_ns(ns);
+	return ret;
+}
+
+static ssize_t uid_io_set_state(struct file *file, const char __user *buffer,
+				 size_t count, loff_t *position)
+{
+	struct pid_namespace *ns = proc_pid_ns(file_inode(file)->i_sb);
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct uid_cpu_entry *entry;
+	unsigned int uid, state;
+	char text[64], *cursor, *first;
+	kuid_t kuid;
+	int ret;
+
+	if (!stats || !uid_stats_live(ns))
+		return -ENODEV;
+	if (!count || count >= sizeof(text))
+		return -EINVAL;
+	if (copy_from_user(text, buffer, count))
+		return -EFAULT;
+	text[count] = '\0';
+	cursor = strim(text);
+	first = strsep(&cursor, " \t");
+	if (!cursor || kstrtouint(first, 10, &uid) ||
+	    kstrtouint(skip_spaces(cursor), 10, &state) || state > 1)
+		return -EINVAL;
+	kuid = make_kuid(current_user_ns(), uid);
+	if (!uid_valid(kuid))
+		return -EINVAL;
+
+	mutex_lock(&stats->lock);
+	ret = uid_stats_collect(stats, ns);
+	if (ret)
+		goto out;
+	entry = uid_cpu_entry(stats, kuid, GFP_KERNEL);
+	if (!entry) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	uid_io_update(entry);
+	entry->state = state;
+out:
+	mutex_unlock(&stats->lock);
+	return ret ? ret : count;
+}
+
+static const struct proc_ops uid_io_ops = {
+	.proc_open = uid_io_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = uid_cputime_release,
+};
+
+static const struct proc_ops uid_io_state_ops = {
+	.proc_write = uid_io_set_state,
+	.proc_lseek = noop_llseek,
+};
+#endif
+
+static ssize_t uid_cputime_remove(struct file *file, const char __user *buffer,
+				 size_t count, loff_t *position)
+{
+	struct pid_namespace *ns = proc_pid_ns(file_inode(file)->i_sb);
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct user_namespace *user_ns = current_user_ns();
+	struct uid_cpu_entry *entry;
+	struct hlist_node *next;
+	char text[64], *first, *last;
+	unsigned int begin, end, uid, bucket;
+
+	if (!stats || !uid_stats_live(ns))
+		return -ENODEV;
+	if (!count || count >= sizeof(text))
+		return -EINVAL;
+	if (copy_from_user(text, buffer, count))
+		return -EFAULT;
+	text[count] = '\0';
+	last = strim(text);
+	first = strsep(&last, "-");
+	if (!last || kstrtouint(first, 10, &begin) ||
+	    kstrtouint(last, 10, &end) || begin > end)
+		return -EINVAL;
+	mutex_lock(&stats->lock);
+	hash_for_each_safe(stats->entries, bucket, next, entry, node) {
+		if (!kuid_has_mapping(user_ns, entry->uid))
+			continue;
+		uid = from_kuid(user_ns, entry->uid);
+		if (uid >= begin && uid <= end) {
+			hash_del(&entry->node);
+			kfree(entry);
+		}
+	}
+	mutex_unlock(&stats->lock);
+	return count;
+}
+
+static const struct proc_ops uid_cputime_ops = {
+	.proc_open = uid_cputime_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = uid_cputime_release,
+};
+
+static const struct proc_ops uid_cputime_remove_ops = {
+	.proc_write = uid_cputime_remove,
+	.proc_lseek = noop_llseek,
+};
+
+static int __init uid_cputime_init(void)
+{
+	struct proc_dir_entry *parent;
+	int ret;
+
+	ret = uid_cputime_ns_init(&init_pid_ns);
+	if (ret)
+		return ret;
+	parent = proc_mkdir("uid_cputime", NULL);
+	if (!parent)
+		return -ENOMEM;
+	if (!proc_create("show_uid_stat", 0444, parent, &uid_cputime_ops) ||
+	    !proc_create("remove_uid_range", 0222, parent, &uid_cputime_remove_ops)) {
+		remove_proc_subtree("uid_cputime", NULL);
+		return -ENOMEM;
+	}
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+	parent = proc_mkdir("uid_io", NULL);
+	if (!parent || !proc_create("stats", 0444, parent, &uid_io_ops))
+		goto remove_stats;
+	parent = proc_mkdir("uid_procstat", NULL);
+	if (!parent || !proc_create("set", 0222, parent, &uid_io_state_ops))
+		goto remove_stats;
+#endif
+	return 0;
+#ifdef CONFIG_TASK_IO_ACCOUNTING
+remove_stats:
