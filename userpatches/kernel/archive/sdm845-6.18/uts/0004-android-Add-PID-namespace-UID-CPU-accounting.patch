diff --git a/kernel/uid_cputime.c b/kernel/uid_cputime.c
new file mode 100644
index 000000000..b4d5339d8
--- /dev/null
+++ b/kernel/uid_cputime.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Android UID CPU time, including descendants of each proc PID namespace. */
+#include <linux/cred.h>
+#include <linux/hashtable.h>
+#include <linux/init.h>
+#include <linux/mutex.h>
+#include <linux/pid_namespace.h>
+#include <linux/proc_fs.h>
+#include <linux/sched/cputime.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/uid_cputime.h>
+#include <linux/user_namespace.h>
+
+struct uid_cpu_entry {
+	struct hlist_node node;
+	kuid_t uid;
+	u64 user, system;
+	u64 active_user, active_system;
+};
+
+struct uid_cpu_stats {
+	struct mutex lock;
+	DECLARE_HASHTABLE(entries, 6);
+	int error;
+};
+
+int uid_cputime_ns_init(struct pid_namespace *ns)
+{
+	struct uid_cpu_stats *stats;
+
+	stats = kzalloc(sizeof(*stats), GFP_KERNEL_ACCOUNT);
+	if (!stats)
+		return -ENOMEM;
+	mutex_init(&stats->lock);
+	hash_init(stats->entries);
+	smp_store_release(&ns->uid_cputime, stats);
+	return 0;
+}
+
+void uid_cputime_ns_free(struct pid_namespace *ns)
+{
+	struct uid_cpu_stats *stats = ns->uid_cputime;
+	struct uid_cpu_entry *entry;
+	struct hlist_node *next;
+	unsigned int bucket;
+
+	if (!stats)
+		return;
+	hash_for_each_safe(stats->entries, bucket, next, entry, node) {
+		hash_del(&entry->node);
+		kfree(entry);
+	}
+	kfree(stats);
+}
+
+static struct uid_cpu_entry *uid_cpu_entry(struct uid_cpu_stats *stats,
+					 kuid_t uid, gfp_t flags)
+{
+	struct uid_cpu_entry *entry;
+
+	hash_for_each_possible(stats->entries, entry, node, __kuid_val(uid))
+		if (uid_eq(entry->uid, uid))
+			return entry;
+	entry = kzalloc(sizeof(*entry), flags | __GFP_ACCOUNT);
+	if (entry) {
+		entry->uid = uid;
+		hash_add(stats->entries, &entry->node, __kuid_val(uid));
+	}
+	return entry;
+}
+
+void uid_cputime_exit(struct task_struct *task)
+{
+	struct pid_namespace *ns;
+	kuid_t uid = task_uid(task);
+
+	for (ns = task_active_pid_ns(task); ns; ns = ns->parent) {
+		struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+		struct uid_cpu_entry *entry;
+		u64 user, system;
+
+		if (!stats)
+			continue;
+		mutex_lock(&stats->lock);
+		if (atomic64_read(&task->uid_cputime_accounted) & BIT_ULL(ns->level))
+			goto unlock;
+		entry = uid_cpu_entry(stats, uid, GFP_KERNEL);
+		if (!entry) {
+			stats->error = -ENOMEM;
+			goto unlock;
+		}
+		task_cputime_adjusted(task, &user, &system);
+		entry->user += user;
+		entry->system += system;
+		/* Readers hold this namespace's lock when checking the bit. */
+		atomic64_or(BIT_ULL(ns->level), &task->uid_cputime_accounted);
+unlock:
+		mutex_unlock(&stats->lock);
+	}
+}
+
+static int uid_cputime_show(struct seq_file *m, void *unused)
+{
+	struct pid_namespace *ns = m->private;
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct user_namespace *user_ns = current_user_ns();
+	struct task_struct *group, *task;
+	struct uid_cpu_entry *entry;
+	unsigned int bucket;
+	u64 user, system;
+	int ret;
+
+	if (!stats)
+		return -ENODEV;
+	mutex_lock(&stats->lock);
+	ret = stats->error;
+	if (ret)
+		goto out;
+	hash_for_each(stats->entries, bucket, entry, node) {
+		entry->active_user = 0;
+		entry->active_system = 0;
+	}
+	rcu_read_lock();
+	for_each_process_thread(group, task) {
+		if (!task_pid_nr_ns(task, ns) ||
+		    (atomic64_read(&task->uid_cputime_accounted) & BIT_ULL(ns->level)))
+			continue;
+		entry = uid_cpu_entry(stats, task_uid(task), GFP_ATOMIC);
+		if (!entry) {
+			ret = -ENOMEM;
+			break;
+		}
+		task_cputime_adjusted(task, &user, &system);
+		entry->active_user += user;
+		entry->active_system += system;
+	}
+	rcu_read_unlock();
+	if (ret)
+		goto out;
+	hash_for_each(stats->entries, bucket, entry, node) {
+		if (!kuid_has_mapping(user_ns, entry->uid))
+			continue;
+		seq_printf(m, "%u: %llu %llu\n", from_kuid(user_ns, entry->uid),
+			   div_u64(entry->user + entry->active_user, NSEC_PER_USEC),
+			   div_u64(entry->system + entry->active_system, NSEC_PER_USEC));
+	}
+out:
+	mutex_unlock(&stats->lock);
+	return ret;
+}
+
+static int uid_cputime_open(struct inode *inode, struct file *file)
+{
+	struct pid_namespace *ns = get_pid_ns(proc_pid_ns(inode->i_sb));
+	int ret = single_open(file, uid_cputime_show, ns);
+
+	if (ret)
+		put_pid_ns(ns);
+	return ret;
+}
+
+static int uid_cputime_release(struct inode *inode, struct file *file)
+{
+	struct pid_namespace *ns = ((struct seq_file *)file->private_data)->private;
+	int ret = single_release(inode, file);
+
+	put_pid_ns(ns);
+	return ret;
+}
+
+static ssize_t uid_cputime_remove(struct file *file, const char __user *buffer,
+				 size_t count, loff_t *position)
+{
+	struct pid_namespace *ns = proc_pid_ns(file_inode(file)->i_sb);
+	struct uid_cpu_stats *stats = smp_load_acquire(&ns->uid_cputime);
+	struct user_namespace *user_ns = current_user_ns();
+	struct uid_cpu_entry *entry;
+	struct hlist_node *next;
+	char text[64], *first, *last;
+	unsigned int begin, end, uid, bucket;
+
+	if (!stats)
+		return -ENODEV;
+	if (!count || count >= sizeof(text))
+		return -EINVAL;
+	if (copy_from_user(text, buffer, count))
+		return -EFAULT;
+	text[count] = '\0';
+	last = strim(text);
+	first = strsep(&last, "-");
+	if (!last || kstrtouint(first, 10, &begin) ||
+	    kstrtouint(last, 10, &end) || begin > end)
+		return -EINVAL;
+	mutex_lock(&stats->lock);
+	hash_for_each_safe(stats->entries, bucket, next, entry, node) {
+		if (!kuid_has_mapping(user_ns, entry->uid))
+			continue;
+		uid = from_kuid(user_ns, entry->uid);
+		if (uid >= begin && uid <= end) {
+			hash_del(&entry->node);
+			kfree(entry);
+		}
+	}
+	mutex_unlock(&stats->lock);
+	return count;
+}
+
+static const struct proc_ops uid_cputime_ops = {
+	.proc_open = uid_cputime_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = uid_cputime_release,
+};
+
+static const struct proc_ops uid_cputime_remove_ops = {
+	.proc_write = uid_cputime_remove,
+	.proc_lseek = noop_llseek,
+};
+
+static int __init uid_cputime_init(void)
+{
+	struct proc_dir_entry *parent;
+	int ret;
+
+	ret = uid_cputime_ns_init(&init_pid_ns);
+	if (ret)
+		return ret;
+	parent = proc_mkdir("uid_cputime", NULL);
+	if (!parent)
+		return -ENOMEM;
+	if (!proc_create("show_uid_stat", 0444, parent, &uid_cputime_ops) ||
+	    !proc_create("remove_uid_range", 0222, parent, &uid_cputime_remove_ops)) {
+		remove_proc_subtree("uid_cputime", NULL);
+		return -ENOMEM;
+	}
+	return 0;
+}
+subsys_initcall(uid_cputime_init);
