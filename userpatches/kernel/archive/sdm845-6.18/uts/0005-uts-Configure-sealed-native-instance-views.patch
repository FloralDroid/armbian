diff --git a/kernel/uts_views.c b/kernel/uts_views.c
new file mode 100644
index 000000000..b2a22f000
--- /dev/null
+++ b/kernel/uts_views.c
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/build_bug.h>
+#include <linux/cgroup.h>
+#include <linux/ctype.h>
+#include <linux/file.h>
+#include <linux/export.h>
+#include <linux/device.h>
+#include <linux/kobject.h>
+#include <linux/ktime.h>
+#include <linux/mm.h>
+#include <linux/timekeeping.h>
+#include <linux/nsproxy.h>
+#include <linux/nsfs.h>
+#include <linux/pid_namespace.h>
+#include <linux/perf_event.h>
+#include <linux/printk.h>
+#include <linux/proc_ns.h>
+#include <linux/proc_fs.h>
+#include <linux/random.h>
+#include <linux/rtnetlink.h>
+#include <linux/psi.h>
+#include <linux/slab.h>
+#include <linux/time_namespace.h>
+#include <linux/uaccess.h>
+#include <linux/utsname.h>
+#include <linux/uts_resources.h>
+#include <linux/uts_views.h>
+#include <net/net_namespace.h>
+
+static DEFINE_MUTEX(uts_view_lock);
+
+static_assert(sizeof(struct uts_view_config) == 4304);
+static_assert(offsetof(struct uts_view_config, cmdline) == 208);
+static_assert(sizeof(struct uts_view_info) == 128);
+static_assert(sizeof(struct uts_view_interfaces) == 64);
+static_assert(offsetof(struct uts_view_info, capabilities) == 112);
+
+static bool native_devices_live(struct uts_native_view *native)
+{
+	unsigned int i;
+
+	if (!native)
+		return true;
+	for (i = 0; i < ARRAY_SIZE(native->devices); i++) {
+		if (native->devices[i] &&
+		    (!device_is_registered(native->devices[i]) ||
+		     (native->parents[i] &&
+		      !device_is_registered(native->parents[i])) ||
+		     (native->gpu_parents[i] &&
+		      !device_is_registered(native->gpu_parents[i])) ||
+		     READ_ONCE(native->devices[i]->parent) !=
+			     native->parents[i]))
+			WRITE_ONCE(native->dead, true);
+		if (native->gpu_parents[i] &&
+		    (!native->parents[i] ||
+		     !READ_ONCE(native->gpu_parents[i]->driver) ||
+		     !READ_ONCE(native->parents[i]->driver) ||
+		     READ_ONCE(native->gpu_parents[i]->uts_bind_generation) !=
+			    native->driver_generations[i] ||
+		     READ_ONCE(native->parents[i]->uts_bind_generation) !=
+			    native->parent_driver_generations[i]))
+			WRITE_ONCE(native->dead, true);
+	}
+	return !READ_ONCE(native->dead);
+}
+
+bool uts_views_live(struct uts_resource_view *view)
+{
+	return native_devices_live(uts_resources_native(view));
+}
+
+bool uts_views_may_enter(struct uts_resource_view *old,
+			 struct uts_resource_view *new)
+{
+	return old == new || uts_resources_admin();
+}
+
+int uts_views_sysctl_value(enum uts_view_sysctl sysctl, int fallback)
+{
+	struct uts_resource_view *view;
+	struct uts_native_view *native;
+	int value = fallback;
+
+	if (!current->nsproxy)
+		return fallback;
+	view = smp_load_acquire(&current->nsproxy->uts_ns->resources);
+	native = uts_resources_native(view);
+	if (!native)
+		return fallback;
+
+	switch (sysctl) {
+	case UTS_VIEW_SYSCTL_KPTR_RESTRICT:
+		value = max(fallback, READ_ONCE(native->kptr_restrict));
+		break;
+	case UTS_VIEW_SYSCTL_DMESG_RESTRICT:
+		value = max(fallback, READ_ONCE(native->dmesg_restrict));
+		break;
+	case UTS_VIEW_SYSCTL_PERF_EVENT_PARANOID:
+#ifdef CONFIG_PERF_EVENTS
+		value = max(fallback, READ_ONCE(native->perf_event_paranoid));
+#endif
+		break;
+	case UTS_VIEW_SYSCTL_RANDOMIZE_VA_SPACE:
+#ifdef CONFIG_ARCH_HAS_ELF_RANDOMIZE
+		value = READ_ONCE(native->randomize_va_space);
+#endif
+		break;
+	case UTS_VIEW_SYSCTL_MMAP_RND_BITS:
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_BITS
+		value = READ_ONCE(native->mmap_rnd_bits);
+#endif
+		break;
+	case UTS_VIEW_SYSCTL_MMAP_RND_COMPAT_BITS:
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_COMPAT_BITS
+		value = READ_ONCE(native->mmap_rnd_compat_bits);
+#endif
+		break;
+	}
+	return value;
+}
+EXPORT_SYMBOL_GPL(uts_views_sysctl_value);
+
+void uts_views_copy(struct uts_resource_view **target,
+		    struct uts_resource_view **source)
+{
+	mutex_lock(&uts_view_lock);
+	*target = uts_resources_get(*source);
+	mutex_unlock(&uts_view_lock);
+}
+
+void uts_views_pid_exit(struct pid_namespace *ns)
+{
+	struct uts_native_view *native;
+
+	mutex_lock(&uts_view_lock);
+	ns->uts_view_dead = true;
+	native = uts_resources_native(ns->uts_view);
+
+	if (native && native->info.pidns_id == ns->ns.ns_id)
+		WRITE_ONCE(native->dead, true);
+	mutex_unlock(&uts_view_lock);
+}
+
+void uts_views_destroy(struct uts_native_view *native)
+{
+	unsigned int i;
+
+	if (!native)
+		return;
+	uts_sysfs_destroy(native);
+	for (i = 0; i < ARRAY_SIZE(native->devices); i++) {
+		put_device(native->devices[i]);
+		put_device(native->parents[i]);
+		put_device(native->gpu_parents[i]);
+		kfree(native->devpaths[i]);
+	}
+	kfree(native);
+}
+
+static struct ns_common *view_namespace(int fd, unsigned int type,
+					struct file **file)
+{
+	struct ns_common *ns;
+
+	*file = fget(fd);
+	if (!*file)
+		return ERR_PTR(-EBADF);
+	if (!proc_ns_file(*file))
+		return ERR_PTR(-EINVAL);
+	ns = get_proc_ns(file_inode(*file));
+	return ns->ns_type == type ? ns : ERR_PTR(-EINVAL);
+}
+
+static bool view_string(const char *value, size_t size, bool line)
+{
+	size_t length = strnlen(value, size), i;
+
+	if (length == size || memchr_inv(value + length, 0, size - length))
+		return false;
+	for (i = 0; i < length; i++)
+		if ((unsigned char)value[i] < ' ' || value[i] == 127)
+			return false;
+	return !line || length;
+}
+
+static int configure_view(struct uts_resource_view *view, void __user *argp)
+{
+	struct uts_native_view *native;
+	struct file *pidfile = NULL, *timefile = NULL, *netfile = NULL;
+	struct pid_namespace *pid;
+	struct time_namespace *time;
+	struct net *net;
+	struct ns_common *ns;
+	const struct uts_resource_info *binding = uts_resources_binding(view);
+	int ret = -EINVAL;
+
+	native = kzalloc(sizeof(*native), GFP_KERNEL);
+	if (!native)
+		return -ENOMEM;
+	native->kptr_restrict = READ_ONCE(kptr_restrict);
+	native->dmesg_restrict = READ_ONCE(dmesg_restrict);
+#ifdef CONFIG_PERF_EVENTS
+	native->perf_event_paranoid = READ_ONCE(sysctl_perf_event_paranoid);
+#endif
+#ifdef CONFIG_ARCH_HAS_ELF_RANDOMIZE
+	native->randomize_va_space = READ_ONCE(randomize_va_space);
+#endif
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_BITS
+	native->mmap_rnd_bits = READ_ONCE(mmap_rnd_bits);
+#endif
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_COMPAT_BITS
+	native->mmap_rnd_compat_bits = READ_ONCE(mmap_rnd_compat_bits);
+#endif
+	if (copy_from_user(&native->config, argp, sizeof(native->config))) {
+		ret = -EFAULT;
+		goto out;
+	}
+	if (native->config.abi != 1 || native->config.flags ||
+	    native->config.reserved0 ||
+	    memchr_inv(native->config.reserved1, 0,
+		       sizeof(native->config.reserved1)) ||
+	    memcmp(native->config.generation, binding->generation,
+		   sizeof(binding->generation)) ||
+	    !view_string(native->config.cpu_vendor,
+			 sizeof(native->config.cpu_vendor), false) ||
+	    !view_string(native->config.cpu_model,
+			 sizeof(native->config.cpu_model), false) ||
+	    !view_string(native->config.cmdline, sizeof(native->config.cmdline),
+			 true))
+		goto out;
+
+	ns = view_namespace(native->config.pidns_fd, CLONE_NEWPID, &pidfile);
+	if (IS_ERR(ns)) {
+		ret = PTR_ERR(ns);
+		goto out;
+	}
+	pid = to_pid_ns(ns);
+	ns = view_namespace(native->config.timens_fd, CLONE_NEWTIME, &timefile);
+	if (IS_ERR(ns)) {
+		ret = PTR_ERR(ns);
+		goto out;
+	}
+	time = to_time_ns(ns);
+	ns = view_namespace(native->config.netns_fd, CLONE_NEWNET, &netfile);
+	if (IS_ERR(ns)) {
+		ret = PTR_ERR(ns);
+		goto out;
+	}
+	net = to_net_ns(ns);
+	if (pid == &init_pid_ns || time == &init_time_ns || net == &init_net) {
+		ret = -EPERM;
+		goto out;
+	}
+	if (!uts_resources_events(view) || !uts_uevent_matches(view, net))
+		goto out;
+
+	mutex_lock(&uts_view_lock);
+	mutex_lock(&timens_offset_lock);
+	if (uts_resources_native(view) || pid->uts_view || time->uts_view) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if (!uts_resources_live(view) || pid->uts_view_dead ||
+	    !READ_ONCE(pid->child_reaper)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (binding->start_boottime_ns > S64_MAX ||
+	    timespec64_to_ns(&time->offsets.boottime) !=
+		    -(s64)binding->start_boottime_ns ||
+	    timespec64_to_ns(&time->offsets.monotonic) > 0 ||
+	    timespec64_to_ns(&time->offsets.monotonic) <
+		    -(s64)binding->start_boottime_ns) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	if (!cgroup_psi(uts_resources_cgroup(view)) ||
+	    !cgroup_psi(uts_resources_cgroup(view))->enabled) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	native->suspend_origin_ns = binding->start_boottime_ns +
+				    timespec64_to_ns(&time->offsets.monotonic);
+	/* The offset is kernel-managed once associated with a Run. */
+	if (native->suspend_origin_ns >
+	    ktime_to_ns(ktime_mono_to_any(0, TK_OFFS_BOOT))) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	native->resources = view;
+	native->info.abi = 1;
+	native->info.flags = UTS_VIEW_BOUND;
+	native->info.cgroup_id = binding->cgroup_id;
+	memcpy(native->info.generation, binding->generation,
+	       sizeof(binding->generation));
+	native->info.start_boottime_ns = binding->start_boottime_ns;
+	native->info.pidns_id = pid->ns.ns_id;
+	native->info.netns_id = net->ns.ns_id;
+	native->info.timens_id = time->ns.ns_id;
+	generate_random_uuid(native->info.boot_id);
+	memcpy(native->info.profile_sha256, native->config.profile_sha256,
+	       sizeof(native->info.profile_sha256));
+	native->info.capabilities = UTS_VIEW_SYSINFO | UTS_VIEW_EVENTS |
+				    UTS_VIEW_PROC | UTS_VIEW_PROC_FILTER |
+				    UTS_VIEW_PSI | UTS_VIEW_CPU_STAT;
+	if (IS_ENABLED(CONFIG_ANDROID_UID_CPUTIME))
+		native->info.capabilities |= UTS_VIEW_UID_CPU;
+	rtnl_lock();
+	ret = uts_sysfs_create(native, net);
+	if (!ret && !native_devices_live(native))
+		ret = -ENODEV;
+	if (ret) {
+		rtnl_unlock();
+		goto unlock;
+	}
+	native->info.capabilities |= UTS_VIEW_SYSFS;
+	cgroup_instance_enable();
+	pid->uts_view = uts_resources_get(view);
+	time->uts_view = uts_resources_get(view);
+	uts_resources_publish_native(view, native);
+	rtnl_unlock();
+	native = NULL;
+	ret = 0;
+unlock:
+	mutex_unlock(&timens_offset_lock);
+	mutex_unlock(&uts_view_lock);
+out:
+	if (pidfile)
+		fput(pidfile);
+	if (timefile)
+		fput(timefile);
+	if (netfile)
+		fput(netfile);
+	uts_views_destroy(native);
+	return ret;
+}
+
+long uts_views_ioctl(struct uts_namespace *ns, unsigned int cmd,
+		     unsigned long arg)
+{
+	struct uts_resource_view *view = uts_resources_acquire(ns);
+	struct uts_resource_view *caller;
+	struct uts_native_view *native;
+	struct uts_view_info info = { .abi = 1 };
+	void __user *argp = (void __user *)arg;
+	long ret;
+
+	if (cmd == NS_UTS_CONFIG_VIEW) {
+		if (!uts_resources_admin() || ns == &init_uts_ns)
+			ret = -EPERM;
+		else if (!view)
+			ret = -ENODATA;
+		else
+			ret = configure_view(view, argp);
+	} else {
+		caller = uts_resources_acquire(current->nsproxy->uts_ns);
+		ret = !uts_resources_admin() && caller != view ? -EPERM : 0;
+		uts_resources_release(caller);
+		if (!ret && cmd == NS_UTS_GET_INTERFACES) {
+			struct uts_view_interfaces interfaces = {
+				.abi = 1,
+				.size = sizeof(interfaces),
+				.device_classes = (1ULL << UTS_EVENT_MISC),
+				.interfaces = UTS_INTERFACE_HARDWARE_IDENTITY |
+					      UTS_INTERFACE_MEDIA_BUS,
+			};
+
+			if (IS_ENABLED(CONFIG_DRM)) {
+				interfaces.device_classes |= 1ULL << UTS_EVENT_DRM;
+				interfaces.interfaces |= UTS_INTERFACE_GPU_DRIVER;
+			}
+			if (IS_ENABLED(CONFIG_VIDEO_DEV))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_VIDEO;
+			if (IS_ENABLED(CONFIG_MEDIA_CONTROLLER))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_MEDIA;
+			if (IS_ENABLED(CONFIG_DMABUF_HEAPS))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_DMA_HEAP;
+			if (IS_ENABLED(CONFIG_INPUT_EVDEV))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_INPUT;
+			if (IS_ENABLED(CONFIG_INPUT) && IS_ENABLED(CONFIG_PROC_FS))
+				interfaces.interfaces |= UTS_INTERFACE_INPUT_PROC;
+			if (IS_ENABLED(CONFIG_SND))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_SOUND;
+			if (IS_ENABLED(CONFIG_RFKILL))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_RFKILL;
+			if (IS_ENABLED(CONFIG_THERMAL))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_THERMAL;
+			if (IS_ENABLED(CONFIG_POWER_SUPPLY))
+				interfaces.device_classes |= 1ULL << UTS_EVENT_POWER_SUPPLY;
+			if (IS_ENABLED(CONFIG_BLOCK)) {
+				interfaces.device_classes |= 1ULL << UTS_EVENT_BLOCK;
+				interfaces.interfaces |= UTS_INTERFACE_BLOCK_SYSFS;
+			}
+			if (IS_ENABLED(CONFIG_FUSE_FS))
+				interfaces.interfaces |= UTS_INTERFACE_FUSECTL;
+			ret = copy_to_user(argp, &interfaces, sizeof(interfaces)) ? -EFAULT : 0;
+			uts_resources_release(view);
+			return ret;
+		}
+		if (!ret) {
+			native = uts_resources_native(view);
+			if (native) {
+				info = native->info;
+				if (uts_resources_live(view))
+					info.flags |= UTS_VIEW_LIVE;
+			}
+			ret = copy_to_user(argp, &info, sizeof(info)) ?
+					    -EFAULT :
+					    0;
+		}
+	}
+	uts_resources_release(view);
+	return ret;
+}
