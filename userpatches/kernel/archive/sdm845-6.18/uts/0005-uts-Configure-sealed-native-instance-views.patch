From 2a6dc3f92b0491d263ded2265992e68894e53972 Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sun, 1 Nov 2026 23:34:17 +0800
Subject: [PATCH] uts: Configure sealed native instance views

---
 fs/nsfs.c                      |  14 ++
 include/linux/device.h         |   4 +
 include/linux/pid_namespace.h  |   4 +
 include/linux/time_namespace.h |   5 +
 include/linux/uts_resources.h  |  13 ++
 include/linux/uts_views.h      |  95 ++++++++
 include/uapi/linux/nsfs.h      |  61 +++++
 kernel/Makefile                |   1 +
 kernel/pid_namespace.c         |  16 ++
 kernel/time/namespace.c        |  18 +-
 kernel/uts_resources.c         |  72 ++++--
 kernel/uts_views.c             | 414 +++++++++++++++++++++++++++++++++
 12 files changed, 703 insertions(+), 14 deletions(-)
 create mode 100644 include/linux/uts_views.h
 create mode 100644 kernel/uts_views.c

diff --git a/fs/nsfs.c b/fs/nsfs.c
index f56a89157..64b2f689a 100644
--- a/fs/nsfs.c
+++ b/fs/nsfs.c
@@ -17,6 +17,7 @@
 #include <linux/time_namespace.h>
 #include <linux/utsname.h>
 #include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 #include <linux/exportfs.h>
 #include <linux/nstree.h>
 #include <net/net_namespace.h>
@@ -183,6 +184,11 @@ static bool nsfs_ioctl_valid(unsigned int cmd)
 	case NS_UTS_BIND_EVENTS:
 	case NS_UTS_GET_EVENTS:
 #endif
+#ifdef CONFIG_UTS_NS_VIEWS
+	case NS_UTS_CONFIG_VIEW:
+	case NS_UTS_GET_VIEW:
+	case NS_UTS_GET_INTERFACES:
+#endif
 #ifdef CONFIG_UTS_NS_RESOURCES
 	case NS_UTS_BIND_RESOURCES:
 	case NS_UTS_GET_RESOURCE_BINDING:
@@ -240,6 +246,14 @@ static long ns_ioctl(struct file *filp, unsigned int ioctl,
 
 	ns = get_proc_ns(file_inode(filp));
 	switch (ioctl) {
+#ifdef CONFIG_UTS_NS_VIEWS
+	case NS_UTS_CONFIG_VIEW:
+	case NS_UTS_GET_VIEW:
+	case NS_UTS_GET_INTERFACES:
+		if (ns->ns_type != CLONE_NEWUTS)
+			return -EINVAL;
+		return uts_views_ioctl(to_uts_ns(ns), ioctl, arg);
+#endif
 #if defined(CONFIG_UTS_NS_RESOURCES) && defined(CONFIG_NET)
 	case NS_UTS_BIND_EVENTS:
 	case NS_UTS_GET_EVENTS:
diff --git a/include/linux/device.h b/include/linux/device.h
index 56e5a9314..23ac37e61 100644
--- a/include/linux/device.h
+++ b/include/linux/device.h
@@ -600,6 +600,10 @@ enum struct_device_flags {
  * a higher-level representation of the device.
  */
 struct device {
+#ifdef CONFIG_UTS_NS_VIEWS
+	/* Changes on bind/unbind so a sealed view cannot adopt a new driver. */
+	unsigned long uts_bind_generation;
+#endif
 	struct kobject kobj;
 	struct device		*parent;
 
diff --git a/include/linux/pid_namespace.h b/include/linux/pid_namespace.h
index 465b56ec3..a4e648de7 100644
--- a/include/linux/pid_namespace.h
+++ b/include/linux/pid_namespace.h
@@ -24,6 +24,10 @@ struct fs_pin;
 #endif
 
 struct pid_namespace {
+#ifdef CONFIG_UTS_NS_VIEWS
+	struct uts_resource_view *uts_view;
+	bool uts_view_dead;
+#endif
 	struct idr idr;
 	struct rcu_head rcu;
 	unsigned int pid_allocated;
diff --git a/include/linux/time_namespace.h b/include/linux/time_namespace.h
index 06a83e198..508d26c9c 100644
--- a/include/linux/time_namespace.h
+++ b/include/linux/time_namespace.h
@@ -16,12 +16,17 @@ extern struct user_namespace init_user_ns;
 struct seq_file;
 struct vm_area_struct;
 
+extern struct mutex timens_offset_lock;
+
 struct timens_offsets {
 	struct timespec64 monotonic;
 	struct timespec64 boottime;
 };
 
 struct time_namespace {
+#ifdef CONFIG_UTS_NS_VIEWS
+	struct uts_resource_view *uts_view;
+#endif
 	struct user_namespace	*user_ns;
 	struct ucounts		*ucounts;
 	struct ns_common	ns;
diff --git a/include/linux/uts_resources.h b/include/linux/uts_resources.h
index 396fe8c0b..08d774282 100644
--- a/include/linux/uts_resources.h
+++ b/include/linux/uts_resources.h
@@ -12,6 +12,7 @@ struct sysinfo;
 struct net;
 struct uts_resource_view;
 struct uts_event_projection;
+struct uts_native_view;
 
 /* Fixed ABI class numbers, shared by sysfs and standard uevent projection. */
 static inline const char *uts_event_class_name(unsigned int class)
@@ -100,11 +101,18 @@ void uts_resources_put(struct uts_namespace *ns);
 bool uts_resources_may_enter(struct uts_namespace *old, struct uts_namespace *new);
 int uts_resources_sysinfo(struct sysinfo *info);
 int uts_resources_proc(struct seq_file *m, enum uts_resource_proc which);
+struct uts_resource_view *uts_resources_proc_source(struct seq_file *m);
+int uts_resources_cpu_visible_in(struct uts_resource_view *view, unsigned int cpu);
+int uts_resources_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s);
 bool uts_resources_active(void);
 int uts_resources_cpu_visible(unsigned int cpu);
 bool uts_resources_admin(void);
 struct uts_resource_view *uts_resources_acquire(struct uts_namespace *ns);
 void uts_resources_release(struct uts_resource_view *view);
+struct uts_resource_view *uts_resources_get(struct uts_resource_view *view);
+struct cgroup *uts_resources_cgroup(struct uts_resource_view *view);
+struct uts_native_view *uts_resources_native(struct uts_resource_view *view);
+void uts_resources_publish_native(struct uts_resource_view *view, struct uts_native_view *native);
 const struct uts_resource_info *uts_resources_binding(struct uts_resource_view *view);
 bool uts_resources_live(struct uts_resource_view *view);
 struct uts_event_projection *uts_resources_events(struct uts_resource_view *view);
@@ -122,10 +130,15 @@ static inline bool uts_resources_may_enter(struct uts_namespace *old, struct uts
 static inline int uts_resources_sysinfo(struct sysinfo *info) { return 0; }
 static inline int uts_resources_proc(struct seq_file *m, enum uts_resource_proc which) { return 0; }
 static inline bool uts_resources_active(void) { return false; }
+static inline struct uts_resource_view *uts_resources_proc_source(struct seq_file *m) { return NULL; }
+static inline int uts_resources_cpu_visible_in(struct uts_resource_view *view, unsigned int cpu) { return 1; }
 static inline int uts_resources_cpu_visible(unsigned int cpu) { return 1; }
 #endif
 
 #if defined(CONFIG_UTS_NS_RESOURCES) && defined(CONFIG_NET)
+struct uts_resource_view *uts_uevent_resources(struct net *net);
+bool uts_uevent_matches(struct uts_resource_view *view, struct net *net);
+const struct uts_event_info *uts_resources_event_info(struct uts_resource_view *view);
 long uts_uevent_ioctl(struct uts_namespace *ns, unsigned int cmd, unsigned long arg);
 bool uts_uevent_may_enter(struct uts_namespace *uts, struct net *net);
 #else
diff --git a/include/linux/uts_views.h b/include/linux/uts_views.h
new file mode 100644
index 000000000..24f3a32f3
--- /dev/null
+++ b/include/linux/uts_views.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_UTS_VIEWS_H
+#define _LINUX_UTS_VIEWS_H
+
+#include <linux/types.h>
+#include <uapi/linux/nsfs.h>
+
+struct uts_resource_view;
+struct uts_namespace;
+struct pid_namespace;
+struct time_namespace;
+struct net;
+struct seq_file;
+struct inode;
+struct file;
+struct proc_dir_entry;
+struct kernfs_root;
+struct psi_group;
+struct uts_sysfs;
+struct device;
+struct net_device;
+struct uts_resource_snapshot;
+
+enum uts_view_sysctl {
+	UTS_VIEW_SYSCTL_KPTR_RESTRICT,
+	UTS_VIEW_SYSCTL_DMESG_RESTRICT,
+	UTS_VIEW_SYSCTL_PERF_EVENT_PARANOID,
+	UTS_VIEW_SYSCTL_RANDOMIZE_VA_SPACE,
+	UTS_VIEW_SYSCTL_MMAP_RND_BITS,
+	UTS_VIEW_SYSCTL_MMAP_RND_COMPAT_BITS,
+};
+
+#ifdef CONFIG_UTS_NS_VIEWS
+struct uts_native_view {
+	struct uts_resource_view *resources;
+	struct uts_view_config config;
+	struct uts_view_info info;
+	int kptr_restrict;
+	int dmesg_restrict;
+	int perf_event_paranoid;
+	int randomize_va_space;
+	int mmap_rnd_bits;
+	int mmap_rnd_compat_bits;
+	struct kernfs_root *sysfs;
+	struct uts_sysfs *sysfs_data;
+	struct device *devices[UTS_EVENT_MAX_DEVICES];
+	struct device *parents[UTS_EVENT_MAX_DEVICES];
+	struct device *gpu_parents[UTS_EVENT_MAX_DEVICES];
+	s64 suspend_origin_ns;
+	bool dead;
+};
+
+long uts_views_ioctl(struct uts_namespace *ns, unsigned int cmd,
+		     unsigned long arg);
+void uts_views_destroy(struct uts_native_view *native);
+bool uts_views_live(struct uts_resource_view *view);
+bool uts_views_may_enter(struct uts_resource_view *old,
+			 struct uts_resource_view *target);
+void uts_views_copy(struct uts_resource_view **target,
+		    struct uts_resource_view **source);
+void uts_views_pid_exit(struct pid_namespace *ns);
+struct device *uts_device_get_by_devt(dev_t devt);
+int uts_views_emit_event(struct uts_resource_view *view, struct net *net,
+			 const struct uts_event_device *device,
+			 struct net_device *netdev, const char *action,
+			 size_t count);
+int uts_sysfs_create(struct uts_native_view *native, struct net *net);
+void uts_sysfs_destroy(struct uts_native_view *native);
+struct kernfs_root *uts_sysfs_get_root(struct net *net);
+struct uts_resource_view *uts_sysfs_resources(struct kernfs_root *root);
+void uts_sysfs_refresh_cpus(void);
+void uts_views_cpu_identity(struct seq_file *m);
+struct psi_group *uts_views_psi(struct file *file);
+int uts_views_stat(struct seq_file *m, struct uts_resource_view *view,
+		   struct uts_resource_snapshot *snapshot);
+int uts_views_sysctl_value(enum uts_view_sysctl sysctl, int fallback);
+#else
+struct uts_native_view;
+static inline int uts_views_sysctl_value(enum uts_view_sysctl sysctl,
+					 int fallback)
+{
+	return fallback;
+}
+static inline void uts_sysfs_refresh_cpus(void)
+{
+}
+static inline bool uts_views_live(struct uts_resource_view *view)
+{
+	return true;
+}
+static inline void uts_views_destroy(struct uts_native_view *native)
+{
+}
+#endif
+#endif
diff --git a/include/uapi/linux/nsfs.h b/include/uapi/linux/nsfs.h
index caeac89b9..74e36e2c3 100644
--- a/include/uapi/linux/nsfs.h
+++ b/include/uapi/linux/nsfs.h
@@ -183,6 +183,67 @@ struct uts_event_info {
 #define NS_UTS_BIND_EVENTS _IOW(NSIO, 0x86, struct uts_event_binding)
 #define NS_UTS_GET_EVENTS _IOR(NSIO, 0x87, struct uts_event_info)
 
+/* One-time host configuration of native instance filesystems. */
+struct uts_view_config {
+	__u32 abi;
+	__u32 flags;
+	__s32 pidns_fd;
+	__s32 netns_fd;
+	__s32 timens_fd;
+	__u32 reserved0;
+	__u64 generation[2];
+	__u8 profile_sha256[32];
+	char cpu_vendor[65];
+	char cpu_model[65];
+	__u8 reserved1[6];
+	char cmdline[4096];
+};
+
+#define UTS_VIEW_BOUND 1
+#define UTS_VIEW_LIVE  2
+#define UTS_VIEW_PROC (1ULL << 0)
+#define UTS_VIEW_SYSFS (1ULL << 1)
+#define UTS_VIEW_SYSINFO (1ULL << 2)
+#define UTS_VIEW_EVENTS (1ULL << 3)
+#define UTS_VIEW_UID_CPU (1ULL << 4)
+#define UTS_VIEW_PSI (1ULL << 5)
+#define UTS_VIEW_CPU_STAT (1ULL << 6)
+#define UTS_VIEW_PROC_FILTER (1ULL << 7)
+
+struct uts_view_info {
+	__u32 abi;
+	__u32 flags;
+	__u64 cgroup_id;
+	__u64 generation[2];
+	__u64 start_boottime_ns;
+	__u64 pidns_id;
+	__u64 netns_id;
+	__u64 timens_id;
+	__u8 boot_id[16];
+	__u8 profile_sha256[32];
+	__u64 capabilities;
+	__u64 reserved;
+};
+
+#define NS_UTS_CONFIG_VIEW _IOW(NSIO, 0x88, struct uts_view_config)
+#define NS_UTS_GET_VIEW _IOR(NSIO, 0x89, struct uts_view_info)
+
+/* Compiled interface support, not authorization of any particular device. */
+#define UTS_INTERFACE_FUSECTL (1ULL << 0)
+#define UTS_INTERFACE_INPUT_PROC (1ULL << 1)
+#define UTS_INTERFACE_BLOCK_SYSFS (1ULL << 2)
+#define UTS_INTERFACE_GPU_DRIVER (1ULL << 3)
+#define UTS_INTERFACE_HARDWARE_IDENTITY (1ULL << 4)
+#define UTS_INTERFACE_MEDIA_BUS (1ULL << 5)
+struct uts_view_interfaces {
+	__u32 abi;
+	__u32 size;
+	__u64 device_classes;
+	__u64 interfaces;
+	__u64 reserved[5];
+};
+#define NS_UTS_GET_INTERFACES _IOR(NSIO, 0x8a, struct uts_view_interfaces)
+
 enum init_ns_ino {
 	IPC_NS_INIT_INO		= 0xEFFFFFFFU,
 	UTS_NS_INIT_INO		= 0xEFFFFFFEU,
diff --git a/kernel/Makefile b/kernel/Makefile
index fa0f5ba34..fde18567b 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -209,4 +209,5 @@ $(obj)/kheaders.md5: $(obj)/kheaders-srclist FORCE
 clean-files := kheaders.md5 kheaders-srclist kheaders-objlist
 
 obj-$(CONFIG_UTS_NS_RESOURCES) += uts_resources.o
+obj-$(CONFIG_UTS_NS_VIEWS) += uts_views.o
 obj-$(CONFIG_ANDROID_UID_CPUTIME) += uid_cputime.o
diff --git a/kernel/pid_namespace.c b/kernel/pid_namespace.c
index 700299a3c..7fa08b4ca 100644
--- a/kernel/pid_namespace.c
+++ b/kernel/pid_namespace.c
@@ -11,6 +11,8 @@
 
 #include <linux/pid.h>
 #include <linux/pid_namespace.h>
+#include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 #include <linux/uid_cputime.h>
 #include <linux/user_namespace.h>
 #include <linux/syscalls.h>
@@ -127,6 +129,9 @@ static struct pid_namespace *create_pid_namespace(struct user_namespace *user_ns
 	ns->memfd_noexec_scope = pidns_memfd_noexec_scope(parent_pid_ns);
 #endif
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_views_copy(&ns->uts_view, &parent_pid_ns->uts_view);
+#endif
 	ns_tree_add(ns);
 	return ns;
 
@@ -154,6 +159,9 @@ static void delayed_free_pidns(struct rcu_head *p)
 
 static void destroy_pid_namespace(struct pid_namespace *ns)
 {
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_resources_release(ns->uts_view);
+#endif
 	uid_cputime_ns_free(ns);
 	ns_tree_remove(ns);
 	unregister_pidns_sysctls(ns);
@@ -203,6 +211,10 @@ void zap_pid_ns_processes(struct pid_namespace *pid_ns)
 	int init_pids = thread_group_leader(me) ? 1 : 2;
 	struct pid *pid;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_views_pid_exit(pid_ns);
+#endif
+
 	/* Don't allow any more processes into the pid namespace */
 	disable_pid_allocation(pid_ns);
 
@@ -425,6 +437,10 @@ static int pidns_install(struct nsset *nsset, struct ns_common *ns)
 	if (!pidns_is_ancestor(new, active))
 		return -EINVAL;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (!uts_views_may_enter(active->uts_view, new->uts_view))
+		return -EPERM;
+#endif
 	put_pid_ns(nsproxy->pid_ns_for_children);
 	nsproxy->pid_ns_for_children = get_pid_ns(new);
 	return 0;
diff --git a/kernel/time/namespace.c b/kernel/time/namespace.c
index 51d2fcba7..44e5e9486 100644
--- a/kernel/time/namespace.c
+++ b/kernel/time/namespace.c
@@ -5,6 +5,8 @@
  */
 
 #include <linux/time_namespace.h>
+#include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 #include <linux/user_namespace.h>
 #include <linux/sched/signal.h>
 #include <linux/sched/task.h>
@@ -106,6 +108,9 @@ static struct time_namespace *clone_time_ns(struct user_namespace *user_ns,
 	ns->user_ns = get_user_ns(user_ns);
 	ns->offsets = old_ns->offsets;
 	ns->frozen_offsets = false;
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_views_copy(&ns->uts_view, &old_ns->uts_view);
+#endif
 	ns_tree_add(ns);
 	return ns;
 
@@ -143,6 +148,9 @@ DEFINE_MUTEX(timens_offset_lock);
 
 void free_time_ns(struct time_namespace *ns)
 {
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_resources_release(ns->uts_view);
+#endif
 	ns_tree_remove(ns);
 	dec_time_namespaces(ns->ucounts);
 	put_user_ns(ns->user_ns);
@@ -201,6 +209,10 @@ static int timens_install(struct nsset *nsset, struct ns_common *new)
 	    !ns_capable(nsset->cred->user_ns, CAP_SYS_ADMIN))
 		return -EPERM;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (!uts_views_may_enter(nsproxy->time_ns->uts_view, ns->uts_view))
+		return -EPERM;
+#endif
 	get_time_ns(ns);
 	put_time_ns(nsproxy->time_ns);
 	nsproxy->time_ns = ns;
@@ -310,7 +322,11 @@ int proc_timens_set_offset(struct file *file, struct task_struct *p,
 	}
 
 	mutex_lock(&timens_offset_lock);
-	if (time_ns->frozen_offsets) {
+	if (time_ns->frozen_offsets
+#ifdef CONFIG_UTS_NS_VIEWS
+	    || time_ns->uts_view
+#endif
+	   ) {
 		err = -EACCES;
 		goto out_unlock;
 	}
diff --git a/kernel/uts_resources.c b/kernel/uts_resources.c
index 180d54e51..2a0a2ed68 100644
--- a/kernel/uts_resources.c
+++ b/kernel/uts_resources.c
@@ -22,6 +22,9 @@
 #include <linux/uts_namespace.h>
 #include <linux/uts_resources.h>
 #include <linux/utsname.h>
+#include <linux/uts_views.h>
+#include <linux/proc_fs.h>
+#include <linux/fs.h>
 
 struct uts_resource_view {
 	refcount_t refs;
@@ -29,6 +32,7 @@ struct uts_resource_view {
 	struct cgroup *root;
 	struct uts_resource_info binding;
 	struct uts_event_projection *events;
+	struct uts_native_view *native;
 	u64 load_sample;
 	unsigned long loads[3];
 	unsigned long previous_active;
@@ -68,12 +72,35 @@ struct uts_resource_view *uts_resources_acquire(struct uts_namespace *ns)
 void uts_resources_release(struct uts_resource_view *view)
 {
 	if (view && refcount_dec_and_test(&view->refs)) {
+		uts_views_destroy(view->native);
 		cgroup_put(view->root);
 		kfree(view->events);
 		kfree(view);
 	}
 }
 
+struct uts_resource_view *uts_resources_get(struct uts_resource_view *view)
+{
+	if (view)
+		refcount_inc(&view->refs);
+	return view;
+}
+
+struct cgroup *uts_resources_cgroup(struct uts_resource_view *view)
+{
+	return view->root;
+}
+
+struct uts_native_view *uts_resources_native(struct uts_resource_view *view)
+{
+	return view ? smp_load_acquire(&view->native) : NULL;
+}
+
+void uts_resources_publish_native(struct uts_resource_view *view, struct uts_native_view *native)
+{
+	smp_store_release(&view->native, native);
+}
+
 void uts_resources_put(struct uts_namespace *ns)
 {
 	uts_resources_release(ns->resources);
@@ -86,7 +113,7 @@ const struct uts_resource_info *uts_resources_binding(struct uts_resource_view *
 
 bool uts_resources_live(struct uts_resource_view *view)
 {
-	return !css_is_dying(&view->root->self);
+	return !css_is_dying(&view->root->self) && uts_views_live(view);
 }
 
 struct uts_event_projection *uts_resources_events(struct uts_resource_view *view)
@@ -115,15 +142,25 @@ bool uts_resources_active(void)
 	return current_resource_view() != NULL;
 }
 
-int uts_resources_cpu_visible(unsigned int cpu)
+struct uts_resource_view *uts_resources_proc_source(struct seq_file *m)
+{
+#ifdef CONFIG_UTS_NS_VIEWS
+	struct uts_resource_view *view = proc_sb_info(file_inode(m->file)->i_sb)->uts_view;
+
+	if (view || uts_resources_native(current_resource_view()))
+		return view;
+#endif
+	return current_resource_view();
+}
+
+int uts_resources_cpu_visible_in(struct uts_resource_view *view, unsigned int cpu)
 {
-	struct uts_resource_view *view = current_resource_view();
 	cpumask_var_t cpus;
 	bool visible;
 
 	if (!view)
 		return 1;
-	if (css_is_dying(&view->root->self))
+	if (!uts_resources_live(view))
 		return -ENODEV;
 	if (!alloc_cpumask_var(&cpus, GFP_KERNEL))
 		return -ENOMEM;
@@ -133,6 +170,11 @@ int uts_resources_cpu_visible(unsigned int cpu)
 	return visible;
 }
 
+int uts_resources_cpu_visible(unsigned int cpu)
+{
+	return uts_resources_cpu_visible_in(current_resource_view(), cpu);
+}
+
 static void field(struct uts_resource_snapshot *s, unsigned int n, u64 value)
 {
 	s->values[n] = value;
@@ -245,7 +287,7 @@ static void task_snapshot(struct uts_resource_view *view, struct uts_resource_sn
 	field(s, UR_UNINTERRUPTIBLE, blocked);
 }
 
-static int resource_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s)
+int uts_resources_snapshot(struct uts_resource_view *view, struct uts_resource_snapshot *s)
 {
 	struct task_cputime cpu;
 	u64 elapsed, unused;
@@ -257,7 +299,7 @@ static int resource_snapshot(struct uts_resource_view *view, struct uts_resource
 	if (!alloc_cpumask_var(&cpus, GFP_KERNEL))
 		return -ENOMEM;
 	mutex_lock(&view->lock);
-	if (css_is_dying(&view->root->self)) {
+	if (!uts_resources_live(view)) {
 		ret = -ENODEV;
 		goto out;
 	}
@@ -324,7 +366,7 @@ static int resource_memory_snapshot(struct uts_resource_view *view,
 	int ret;
 
