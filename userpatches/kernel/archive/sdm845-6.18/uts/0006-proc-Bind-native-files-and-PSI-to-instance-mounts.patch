 {
-	if (!(current->personality & ADDR_NO_RANDOMIZE) && randomize_va_space)
+	if (!(current->personality & ADDR_NO_RANDOMIZE) &&
+	    uts_views_sysctl_value(UTS_VIEW_SYSCTL_RANDOMIZE_VA_SPACE,
