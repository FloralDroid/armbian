+		cpus[cpu].system = stat->cputime.stime;
+		cpus[cpu].usage = stat->cputime.sum_exec_runtime;
+		cpus[cpu].switches = stat->instance_switches;
+		cpus[cpu].forks = stat->instance_forks;
+	}
