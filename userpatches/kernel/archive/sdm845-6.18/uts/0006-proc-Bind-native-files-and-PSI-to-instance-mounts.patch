diff --git a/arch/arm64/kernel/cpuinfo.c b/arch/arm64/kernel/cpuinfo.c
index 803d58d31..516024c96 100644
--- a/arch/arm64/kernel/cpuinfo.c
+++ b/arch/arm64/kernel/cpuinfo.c
@@ -22,6 +22,7 @@
 #include <linux/printk.h>
 #include <linux/seq_file.h>
 #include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 #include <linux/sched.h>
 #include <linux/smp.h>
 #include <linux/delay.h>
@@ -218,8 +219,8 @@ static int c_show(struct seq_file *m, void *v)
 	bool compat = personality(current->personality) == PER_LINUX32;
 	struct cpuinfo_arm64 *cpuinfo = v;
 	u32 midr = cpuinfo->reg_midr;
-	bool instance = uts_resources_active();
-	int visible = uts_resources_cpu_visible(cpu);
+	bool instance = uts_resources_proc_source(m) != NULL;
+	int visible = uts_resources_cpu_visible_in(uts_resources_proc_source(m), cpu);
 
 	if (visible <= 0)
 		return visible;
@@ -230,6 +231,9 @@ static int c_show(struct seq_file *m, void *v)
 	 * "processor".  Give glibc what it expects.
 	 */
 	seq_printf(m, "processor\t: %d\n", cpu);
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_views_cpu_identity(m);
+#endif
 	if (compat && !instance)
 		seq_printf(m, "model name\t: ARMv8 Processor rev %d (%s)\n",
 			   MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
