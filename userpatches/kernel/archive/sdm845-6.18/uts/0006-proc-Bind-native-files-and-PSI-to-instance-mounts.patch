+static unsigned int mmap_rnd_bits_value(bool compat)
+{
 #ifdef CONFIG_COMPAT
-# define mmap32_rnd_bits  mmap_rnd_compat_bits
-# define mmap64_rnd_bits  mmap_rnd_bits
-#else
-# define mmap32_rnd_bits  mmap_rnd_bits
-# define mmap64_rnd_bits  mmap_rnd_bits
+	if (compat)
+		return uts_views_sysctl_value(UTS_VIEW_SYSCTL_MMAP_RND_COMPAT_BITS,
+					     READ_ONCE(mmap_rnd_compat_bits));
 #endif
+	return uts_views_sysctl_value(UTS_VIEW_SYSCTL_MMAP_RND_BITS,
+				     READ_ONCE(mmap_rnd_bits));
+}
 
 #define SIZE_128M    (128 * 1024 * 1024UL)
 
@@ -76,7 +80,7 @@ static unsigned long arch_rnd(unsigned int rndbits)
 
 unsigned long arch_mmap_rnd(void)
 {
-	return arch_rnd(mmap_is_ia32() ? mmap32_rnd_bits : mmap64_rnd_bits);
+	return arch_rnd(mmap_rnd_bits_value(mmap_is_ia32()));
 }
 
 static unsigned long mmap_base(unsigned long rnd, unsigned long task_size,
@@ -127,7 +131,7 @@ void arch_pick_mmap_layout(struct mm_struct *mm, const struct rlimit *rlim_stack
 		mm_flags_set(MMF_TOPDOWN, mm);
 
 	arch_pick_mmap_base(&mm->mmap_base, &mm->mmap_legacy_base,
-			arch_rnd(mmap64_rnd_bits), task_size_64bit(0),
+			arch_rnd(mmap_rnd_bits_value(false)), task_size_64bit(0),
 			rlim_stack);
 
 #ifdef CONFIG_HAVE_ARCH_COMPAT_MMAP_BASES
@@ -138,7 +142,7 @@ void arch_pick_mmap_layout(struct mm_struct *mm, const struct rlimit *rlim_stack
 	 * mmap_base, the compat syscall uses mmap_compat_base.
 	 */
 	arch_pick_mmap_base(&mm->mmap_compat_base, &mm->mmap_compat_legacy_base,
-			arch_rnd(mmap32_rnd_bits), task_size_32bit(),
+			arch_rnd(mmap_rnd_bits_value(true)), task_size_32bit(),
 			rlim_stack);
 #endif
 }
