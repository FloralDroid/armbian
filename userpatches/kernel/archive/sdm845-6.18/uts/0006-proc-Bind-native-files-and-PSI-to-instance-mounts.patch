--- a/fs/proc/generic.c
+++ b/fs/proc/generic.c
@@ -130,6 +130,10 @@ static int proc_notify_change(struct mnt_idmap *idmap,
 
 	setattr_copy(&nop_mnt_idmap, inode, iattr);
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (proc_sb_info(inode->i_sb)->uts_view)
