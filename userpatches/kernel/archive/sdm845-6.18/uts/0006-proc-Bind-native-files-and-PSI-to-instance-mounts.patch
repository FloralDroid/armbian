diff --git a/arch/x86/kernel/cpu/proc.c b/arch/x86/kernel/cpu/proc.c
index 6571d432c..8b6cafb29 100644
--- a/arch/x86/kernel/cpu/proc.c
+++ b/arch/x86/kernel/cpu/proc.c
@@ -6,6 +6,8 @@
 #include <linux/cpufreq.h>
 #include <asm/prctl.h>
 #include <linux/proc_fs.h>
+#include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 
 #include "cpu.h"
 
@@ -67,6 +69,22 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 	int i;
 
 	cpu = c->cpu_index;
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (uts_resources_native(uts_resources_proc_source(m))) {
+		int visible = uts_resources_cpu_visible_in(uts_resources_proc_source(m), cpu);
+
+		if (visible <= 0)
+			return visible;
+		seq_printf(m, "processor\t: %u\n", cpu);
+		uts_views_cpu_identity(m);
+		seq_puts(m, "flags\t\t:");
+		for (i = 0; i < 32 * NCAPINTS; i++)
+			if (cpu_has(c, i) && x86_cap_flags[i])
+				seq_printf(m, " %s", x86_cap_flags[i]);
+		seq_puts(m, "\n\n");
+		return 0;
+	}
