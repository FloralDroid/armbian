From 4947ad87ef3937d251305add4b07831c88d0357d Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sun, 1 Nov 2026 23:34:20 +0800
Subject: [PATCH] proc: Bind native files and PSI to instance mounts

---
 arch/arm64/kernel/cpuinfo.c |   8 +-
 arch/x86/kernel/cpu/proc.c  |  18 +++
 fs/proc/Makefile            |   1 +
 fs/proc/generic.c           |  11 +-
 fs/proc/inode.c             |   1 +
 fs/proc/internal.h          |  19 +++
 fs/proc/native.c            | 311 ++++++++++++++++++++++++++++++++++++
 fs/proc/proc_sysctl.c       |  11 +-
 fs/proc/root.c              |  41 +++++
 include/linux/cgroup-defs.h |   4 +
 include/linux/cgroup.h      |  13 ++
 include/linux/proc_fs.h     |   4 +
 kernel/cgroup/rstat.c       |  55 +++++++
 kernel/fork.c               |   1 +
 kernel/sched/core.c         |   1 +
 kernel/sched/psi.c          |  19 ++-
 16 files changed, 508 insertions(+), 10 deletions(-)
 create mode 100644 fs/proc/native.c

diff --git a/arch/arm64/kernel/cpuinfo.c b/arch/arm64/kernel/cpuinfo.c
index 803d58d31..516024c96 100644
--- a/arch/arm64/kernel/cpuinfo.c
+++ b/arch/arm64/kernel/cpuinfo.c
@@ -22,6 +22,7 @@
 #include <linux/printk.h>
 #include <linux/seq_file.h>
 #include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 #include <linux/sched.h>
 #include <linux/smp.h>
 #include <linux/delay.h>
@@ -218,8 +219,8 @@ static int c_show(struct seq_file *m, void *v)
 	bool compat = personality(current->personality) == PER_LINUX32;
 	struct cpuinfo_arm64 *cpuinfo = v;
 	u32 midr = cpuinfo->reg_midr;
-	bool instance = uts_resources_active();
-	int visible = uts_resources_cpu_visible(cpu);
+	bool instance = uts_resources_proc_source(m) != NULL;
+	int visible = uts_resources_cpu_visible_in(uts_resources_proc_source(m), cpu);
 
 	if (visible <= 0)
 		return visible;
@@ -230,6 +231,9 @@ static int c_show(struct seq_file *m, void *v)
 	 * "processor".  Give glibc what it expects.
 	 */
 	seq_printf(m, "processor\t: %d\n", cpu);
+#ifdef CONFIG_UTS_NS_VIEWS
+	uts_views_cpu_identity(m);
+#endif
 	if (compat && !instance)
 		seq_printf(m, "model name\t: ARMv8 Processor rev %d (%s)\n",
 			   MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
diff --git a/arch/x86/kernel/cpu/proc.c b/arch/x86/kernel/cpu/proc.c
index 6571d432c..8b6cafb29 100644
--- a/arch/x86/kernel/cpu/proc.c
+++ b/arch/x86/kernel/cpu/proc.c
@@ -6,6 +6,8 @@
 #include <linux/cpufreq.h>
 #include <asm/prctl.h>
 #include <linux/proc_fs.h>
+#include <linux/uts_resources.h>
+#include <linux/uts_views.h>
 
 #include "cpu.h"
 
@@ -67,6 +69,22 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 	int i;
 
 	cpu = c->cpu_index;
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (uts_resources_native(uts_resources_proc_source(m))) {
+		int visible = uts_resources_cpu_visible_in(uts_resources_proc_source(m), cpu);
+
+		if (visible <= 0)
+			return visible;
+		seq_printf(m, "processor\t: %u\n", cpu);
+		uts_views_cpu_identity(m);
+		seq_puts(m, "flags\t\t:");
+		for (i = 0; i < 32 * NCAPINTS; i++)
+			if (cpu_has(c, i) && x86_cap_flags[i])
+				seq_printf(m, " %s", x86_cap_flags[i]);
+		seq_puts(m, "\n\n");
+		return 0;
+	}
+#endif
 	seq_printf(m, "processor\t: %u\n"
 		   "vendor_id\t: %s\n"
 		   "cpu family\t: %d\n"
