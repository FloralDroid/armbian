@@ -250,7 +254,7 @@ struct dentry *proc_lookup_de(struct inode *dir, struct dentry *dentry,
 
 	read_lock(&proc_subdir_lock);
 	de = pde_subdir_find(de, dentry->d_name.name, dentry->d_name.len);
-	if (de) {
