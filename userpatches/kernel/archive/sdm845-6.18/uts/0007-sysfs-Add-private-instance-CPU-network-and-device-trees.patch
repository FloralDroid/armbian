+
+struct device;
+struct net_device;
+
+enum uts_sysfs_kind {
+	UV_DIRECTORY,
+	UV_CPU_LIST,
+	UV_CPU,
+	UV_NET,
+	UV_NET_STATS,
+	UV_DEVICE,
+	UV_HARDWARE,
+	UV_INPUT,
+	UV_INPUT_ID,
+	UV_INPUT_CAPS,
+	UV_BLOCK_QUEUE,
+};
+
+struct uts_sysfs_node {
+	struct kobject kobj;
+	struct list_head list;
+	struct uts_native_view *native;
+	enum uts_sysfs_kind kind;
+	bool net_children;
+	unsigned int cpu;
