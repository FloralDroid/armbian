 	if (!strcmp(top->name, "pressure"))
 		return !strcmp(de->name, "cpu") ||
 		       !strcmp(de->name, "memory") || !strcmp(de->name, "io");
@@ -58,6 +65,66 @@ bool proc_native_visible(struct super_block *sb, struct proc_dir_entry *de)
 	return false;
 }
 
+static void __maybe_unused native_input_bitmap(struct seq_file *m, const char *name,
+				const unsigned long *bits, unsigned int nbits)
+{
+	int i;
+
+	seq_printf(m, "B: %s=", name);
+	for (i = BITS_TO_LONGS(nbits) - 1; i > 0 && !bits[i]; i--)
+		;
+	for (; i >= 0; i--)
+		seq_printf(m, "%lx%s", bits[i], i ? " " : "\n");
+}
+
+static void native_devices(struct seq_file *m, struct uts_native_view *native,
+			   bool input_devices)
+{
+	const struct uts_event_info *info = uts_resources_event_info(native->resources);
+	unsigned int i;
+
+	if (!input_devices)
+		seq_puts(m, "major minor  #blocks  name\n\n");
+	for (i = 0; info && i < info->count; i++) {
+		const struct uts_event_device *entry = &info->devices[i];
+		struct device *dev = native->devices[i];
+
+		if (!dev || !device_is_registered(dev))
+			continue;
+#ifdef CONFIG_BLOCK
+		if (!input_devices && entry->class == UTS_EVENT_BLOCK)
+			seq_printf(m, "%4u %7u %10llu %s\n", entry->major, entry->minor,
+				   (unsigned long long)bdev_nr_sectors(dev_to_bdev(dev)) >> 1,
+				   entry->name);
+#endif
+#if IS_ENABLED(CONFIG_INPUT)
+		if (input_devices && entry->class == UTS_EVENT_INPUT && native->parents[i]) {
+			struct input_dev *input = to_input_dev(native->parents[i]);
+
+			if (!device_is_registered(&input->dev))
+				continue;
+			seq_printf(m, "I: Bus=%04x Vendor=%04x Product=%04x Version=%04x\n",
+				   input->id.bustype, input->id.vendor, input->id.product, input->id.version);
+			seq_printf(m, "N: Name=\"%s\"\n", input->name ?: "");
+			/* No host phys/uniq strings or unauthorized handler names. */
+			seq_printf(m, "P: Phys=\nS: Sysfs=/devices/virtual/lupine/input/%s\nU: Uniq=\nH: Handlers=%s\n",
+				   dev_name(&input->dev), entry->name);
+			native_input_bitmap(m, "PROP", input->propbit, INPUT_PROP_CNT);
+			native_input_bitmap(m, "EV", input->evbit, EV_CNT);
+			native_input_bitmap(m, "KEY", input->keybit, KEY_CNT);
+			native_input_bitmap(m, "REL", input->relbit, REL_CNT);
+			native_input_bitmap(m, "ABS", input->absbit, ABS_CNT);
+			native_input_bitmap(m, "MSC", input->mscbit, MSC_CNT);
+			native_input_bitmap(m, "LED", input->ledbit, LED_CNT);
+			native_input_bitmap(m, "SND", input->sndbit, SND_CNT);
+			native_input_bitmap(m, "FF", input->ffbit, FF_CNT);
+			native_input_bitmap(m, "SW", input->swbit, SW_CNT);
+			seq_putc(m, '\n');
+		}
+#endif
+	}
+}
+
 static int native_show(struct seq_file *m, void *unused)
 {
 	struct proc_fs_info *fs = proc_sb_info(file_inode(m->file)->i_sb);
@@ -67,7 +134,9 @@ static int native_show(struct seq_file *m, void *unused)
 
 	if (!uts_resources_live(fs->uts_view))
 		return -ENODEV;
-	if (!strcmp(name, "cmdline"))
+	if (!strcmp(name, "partitions") || !strcmp(name, "devices"))
+		native_devices(m, native, !strcmp(name, "devices"));
+	else if (!strcmp(name, "cmdline"))
 		seq_printf(m, "%s\n", native->config.cmdline);
 	else if (!strcmp(name, "version")) {
 		down_read(&uts_sem);
@@ -120,12 +189,16 @@ void proc_native_inode(struct inode *inode, struct proc_dir_entry *de)
 {
 	static const char *const files[] = {
 		"cmdline",   "version",	   "swaps",    "diskstats", "slabinfo",
-		"buddyinfo", "interrupts", "softirqs", "cgroups",
+		"buddyinfo", "interrupts", "softirqs", "cgroups", "partitions",
 	};
 
 	if (proc_sb_info(inode->i_sb)->uts_view && de->parent == &proc_root &&
 	    named(de->name, files, ARRAY_SIZE(files)))
 		inode->i_fop = &native_file_ops;
+	if (proc_sb_info(inode->i_sb)->uts_view && !strcmp(de->name, "devices") &&
+	    !strcmp(de->parent->name, "input") && de->parent->parent &&
+	    !strcmp(de->parent->parent->name, "bus"))
+		inode->i_fop = &native_file_ops;
 }
 
