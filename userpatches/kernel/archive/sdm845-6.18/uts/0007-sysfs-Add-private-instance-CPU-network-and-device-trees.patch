diff --git a/fs/fuse/control.c b/fs/fuse/control.c
index 2e300f6d6..34dcc990b 100644
--- a/fs/fuse/control.c
+++ b/fs/fuse/control.c
@@ -12,18 +12,95 @@
 #include <linux/module.h>
 #include <linux/fs_context.h>
 #include <linux/namei.h>
+#include <linux/uts_resources.h>
+#include <linux/nsproxy.h>
+#include <linux/slab.h>
 
 #define FUSE_CTL_SUPER_MAGIC 0x65735543
 
-/*
- * This is non-NULL when the single instance of the control filesystem
- * exists.  Protected by fuse_mutex
- */
-static struct super_block *fuse_control_sb;
+/* One control tree per immutable resource domain; NULL is the host tree. */
+struct fuse_ctl_mount {
+	struct list_head list;
+	struct super_block *sb;
+};
+static LIST_HEAD(fuse_control_mounts); /* protected by fuse_mutex */
+
+static bool fuse_ctl_visible(struct super_block *sb, struct fuse_conn *fc)
+{
+	return !sb->s_fs_info || sb->s_fs_info == fc->uts_view;
+}
+
+static int fuse_ctl_access_view(struct uts_resource_view *owner)
+{
+	struct uts_resource_view *caller = uts_resources_acquire(current->nsproxy->uts_ns);
+	int ret = 0;
+
+	if (caller && caller != owner)
+		ret = -EACCES;
+	else if (owner && !uts_resources_live(owner))
+		ret = -ENODEV;
+	uts_resources_release(caller);
+	return ret;
+}
+
+static int fuse_ctl_access(struct super_block *sb)
+{
+	return fuse_ctl_access_view(sb->s_fs_info);
+}
+
+static int fuse_ctl_permission(struct mnt_idmap *idmap, struct inode *inode, int mask)
+{
+	int ret;
+
+	/* Resource-domain lookup may sleep; restart RCU pathwalk in ref mode. */
+	if (mask & MAY_NOT_BLOCK)
+		return -ECHILD;
+	ret = fuse_ctl_access(inode->i_sb);
+	return ret ?: generic_permission(idmap, inode, mask);
+}
+
+static int fuse_ctl_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
+			   struct iattr *attr)
+{
+	int ret = fuse_ctl_access(d_inode(dentry)->i_sb);
+
+	return ret ?: simple_setattr(idmap, dentry, attr);
+}
+
+static const struct inode_operations fuse_ctl_file_iops = {
+	.permission = fuse_ctl_permission,
+	.setattr = fuse_ctl_setattr,
+};
+
+static const struct inode_operations fuse_ctl_dir_iops = {
+	.lookup = simple_lookup,
+	.permission = fuse_ctl_permission,
+	.setattr = fuse_ctl_setattr,
+};
+
+static int fuse_ctl_readdir(struct file *file, struct dir_context *ctx)
+{
+	int ret = fuse_ctl_access(file_inode(file)->i_sb);
+
+	return ret ?: dcache_readdir(file, ctx);
+}
+
+static const struct file_operations fuse_ctl_dir_ops = {
+	.open = dcache_dir_open,
+	.release = dcache_dir_close,
+	.llseek = dcache_dir_lseek,
+	.read = generic_read_dir,
+	.iterate_shared = fuse_ctl_readdir,
+	.fsync = noop_fsync,
+};
 
 static struct fuse_conn *fuse_ctl_file_conn_get(struct file *file)
 {
 	struct fuse_conn *fc;
+	int ret = fuse_ctl_access(file_inode(file)->i_sb);
+
+	if (ret)
+		return ERR_PTR(ret);
 	mutex_lock(&fuse_mutex);
 	fc = file_inode(file)->i_private;
 	if (fc)
@@ -36,6 +113,8 @@ static ssize_t fuse_conn_abort_write(struct file *file, const char __user *buf,
 				     size_t count, loff_t *ppos)
 {
 	struct fuse_conn *fc = fuse_ctl_file_conn_get(file);
+	if (IS_ERR(fc))
+		return PTR_ERR(fc);
 	if (fc) {
 		if (fc->abort_err)
 			fc->aborted = true;
@@ -50,10 +129,17 @@ static ssize_t fuse_conn_waiting_read(struct file *file, char __user *buf,
 {
 	char tmp[32];
 	size_t size;
+	int ret = fuse_ctl_access(file_inode(file)->i_sb);
+
+	/* Cached partial reads must obey the same domain check as the first read. */
+	if (ret)
+		return ret;
 
 	if (!*ppos) {
 		long value;
 		struct fuse_conn *fc = fuse_ctl_file_conn_get(file);
+		if (IS_ERR(fc))
+			return PTR_ERR(fc);
 		if (!fc)
 			return 0;
 
@@ -108,6 +194,8 @@ static ssize_t fuse_conn_max_background_read(struct file *file,
 	unsigned val;
 
 	fc = fuse_ctl_file_conn_get(file);
+	if (IS_ERR(fc))
+		return PTR_ERR(fc);
 	if (!fc)
 		return 0;
 
@@ -128,6 +216,8 @@ static ssize_t fuse_conn_max_background_write(struct file *file,
 				    max_user_bgreq);
 	if (ret > 0) {
 		struct fuse_conn *fc = fuse_ctl_file_conn_get(file);
+		if (IS_ERR(fc))
+			return PTR_ERR(fc);
 		if (fc) {
 			spin_lock(&fc->bg_lock);
 			fc->max_background = val;
@@ -150,6 +240,8 @@ static ssize_t fuse_conn_congestion_threshold_read(struct file *file,
 	unsigned val;
 
 	fc = fuse_ctl_file_conn_get(file);
+	if (IS_ERR(fc))
+		return PTR_ERR(fc);
 	if (!fc)
 		return 0;
 
@@ -172,6 +264,8 @@ static ssize_t fuse_conn_congestion_threshold_write(struct file *file,
 	if (ret <= 0)
 		goto out;
 	fc = fuse_ctl_file_conn_get(file);
+	if (IS_ERR(fc))
+		return PTR_ERR(fc);
 	if (!fc)
 		goto out;
 
@@ -216,7 +310,7 @@ static struct dentry *fuse_ctl_add_dentry(struct dentry *parent,
 	if (!dentry)
 		return NULL;
 
-	inode = new_inode(fuse_control_sb);
+	inode = new_inode(parent->d_sb);
 	if (!inode) {
 		dput(dentry);
 		return NULL;
@@ -228,8 +322,7 @@ static struct dentry *fuse_ctl_add_dentry(struct dentry *parent,
 	inode->i_gid = fc->group_id;
 	simple_inode_init_ts(inode);
 	/* setting ->i_op to NULL is not allowed */
-	if (iop)
-		inode->i_op = iop;
+	inode->i_op = iop ?: &fuse_ctl_file_iops;
 	inode->i_fop = fop;
 	if (S_ISDIR(mode)) {
 		inc_nlink(d_inode(parent));
@@ -245,19 +338,19 @@ static struct dentry *fuse_ctl_add_dentry(struct dentry *parent,
  * Add a connection to the control filesystem (if it exists).  Caller
  * must hold fuse_mutex
  */
-int fuse_ctl_add_conn(struct fuse_conn *fc)
+static int fuse_ctl_add_conn_sb(struct super_block *sb, struct fuse_conn *fc)
 {
 	struct dentry *parent;
 	char name[32];
 
-	if (!fuse_control_sb || fc->no_control)
+	if (fc->no_control || !fuse_ctl_visible(sb, fc))
 		return 0;
 
-	parent = fuse_control_sb->s_root;
+	parent = sb->s_root;
 	sprintf(name, "%u", fc->dev);
 	parent = fuse_ctl_add_dentry(parent, fc, name, S_IFDIR | 0500,
-				     &simple_dir_inode_operations,
-				     &simple_dir_operations);
+				     &fuse_ctl_dir_iops,
+				     &fuse_ctl_dir_ops);
 	if (!parent)
 		goto err;
 
@@ -275,10 +368,24 @@ int fuse_ctl_add_conn(struct fuse_conn *fc)
 	return 0;
 
  err:
-	fuse_ctl_remove_conn(fc);
 	return -ENOMEM;
 }
 
+int fuse_ctl_add_conn(struct fuse_conn *fc)
+{
+	struct fuse_ctl_mount *mount;
+	int ret;
+
+	list_for_each_entry(mount, &fuse_control_mounts, list) {
+		ret = fuse_ctl_add_conn_sb(mount->sb, fc);
+		if (ret) {
+			fuse_ctl_remove_conn(fc);
+			return ret;
+		}
+	}
+	return 0;
+}
+
 static void remove_one(struct dentry *dentry)
 {
 	d_inode(dentry)->i_private = NULL;
@@ -291,31 +398,41 @@ static void remove_one(struct dentry *dentry)
 void fuse_ctl_remove_conn(struct fuse_conn *fc)
 {
 	char name[32];
+	struct fuse_ctl_mount *mount;
 
-	if (!fuse_control_sb || fc->no_control)
+	if (fc->no_control)
 		return;
 
 	sprintf(name, "%u", fc->dev);
-	simple_remove_by_name(fuse_control_sb->s_root, name, remove_one);
+	list_for_each_entry(mount, &fuse_control_mounts, list)
+		if (fuse_ctl_visible(mount->sb, fc))
+			simple_remove_by_name(mount->sb->s_root, name, remove_one);
 }
 
 static int fuse_ctl_fill_super(struct super_block *sb, struct fs_context *fsc)
 {
 	static const struct tree_descr empty_descr = {""};
 	struct fuse_conn *fc;
+	struct fuse_ctl_mount *mount;
 	int err;
 
 	err = simple_fill_super(sb, FUSE_CTL_SUPER_MAGIC, &empty_descr);
 	if (err)
 		return err;
+	sb->s_root->d_inode->i_fop = &fuse_ctl_dir_ops;
+	sb->s_root->d_inode->i_op = &fuse_ctl_dir_iops;
+	mount = kzalloc(sizeof(*mount), GFP_KERNEL);
+	if (!mount)
+		return -ENOMEM;
+	mount->sb = sb;
 
 	mutex_lock(&fuse_mutex);
-	BUG_ON(fuse_control_sb);
-	fuse_control_sb = sb;
+	list_add_tail(&mount->list, &fuse_control_mounts);
 	list_for_each_entry(fc, &fuse_conn_list, entry) {
-		err = fuse_ctl_add_conn(fc);
+		err = fuse_ctl_add_conn_sb(sb, fc);
 		if (err) {
-			fuse_control_sb = NULL;
+			list_del(&mount->list);
+			kfree(mount);
 			mutex_unlock(&fuse_mutex);
 			return err;
 		}
@@ -327,26 +444,58 @@ static int fuse_ctl_fill_super(struct super_block *sb, struct fs_context *fsc)
 
 static int fuse_ctl_get_tree(struct fs_context *fsc)
 {
-	return get_tree_single(fsc, fuse_ctl_fill_super);
+	struct uts_resource_view *view = fsc->fs_private;
+	int ret;
+
+	/* fsopen/fsconfig FDs must not carry a host control tree into a guest. */
+	ret = fuse_ctl_access_view(view);
+	if (ret)
+		return ret;
+	if (view && !uts_resources_live(view))
+		return -ENODEV;
+	/* A new superblock consumes this reference, even on fill_super failure. */
+	ret = get_tree_keyed(fsc, fuse_ctl_fill_super, uts_resources_get(view));
+	if (fsc->s_fs_info) {
+		uts_resources_release(fsc->s_fs_info);
+		fsc->s_fs_info = NULL;
+	}
+	return ret;
+}
+
+static void fuse_ctl_free_context(struct fs_context *fsc)
+{
+	uts_resources_release(fsc->fs_private);
 }
 
 static const struct fs_context_operations fuse_ctl_context_ops = {
 	.get_tree	= fuse_ctl_get_tree,
+	.free		= fuse_ctl_free_context,
 };
 
 static int fuse_ctl_init_fs_context(struct fs_context *fsc)
 {
 	fsc->ops = &fuse_ctl_context_ops;
+	fsc->fs_private = uts_resources_acquire(current->nsproxy->uts_ns);
 	return 0;
 }
 
 static void fuse_ctl_kill_sb(struct super_block *sb)
 {
+	struct fuse_ctl_mount *mount, *next;
+	struct uts_resource_view *view = sb->s_fs_info;
+
 	mutex_lock(&fuse_mutex);
-	fuse_control_sb = NULL;
+	list_for_each_entry_safe(mount, next, &fuse_control_mounts, list) {
+		if (mount->sb == sb) {
+			list_del(&mount->list);
+			kfree(mount);
+			break;
+		}
+	}
 	mutex_unlock(&fuse_mutex);
 
 	kill_litter_super(sb);
+	uts_resources_release(view);
 }
 
 static struct file_system_type fuse_ctl_fs_type = {
diff --git a/fs/fuse/fuse_i.h b/fs/fuse/fuse_i.h
index 7d26159af..21d59dd5f 100644
--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -580,6 +580,9 @@ struct fuse_sync_bucket {
  * fuse_mount is destroyed.
  */
 struct fuse_conn {
+	/* Immutable resource-domain ownership, independent of shared root UIDs. */
+	struct uts_resource_view *uts_view;
+	struct work_struct uts_release_work;
 	/** Lock protecting accessess to  members of this structure */
 	spinlock_t lock;
 
diff --git a/fs/fuse/inode.c b/fs/fuse/inode.c
index a0a64dfff..168e654cd 100644
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -26,6 +26,8 @@
 #include <linux/exportfs.h>
 #include <linux/posix_acl.h>
 #include <linux/pid_namespace.h>
+#include <linux/uts_resources.h>
+#include <linux/nsproxy.h>
 #include <uapi/linux/magic.h>
 
 MODULE_AUTHOR("Miklos Szeredi <miklos@szeredi.hu>");
@@ -33,6 +35,7 @@ MODULE_DESCRIPTION("Filesystem in Userspace");
 MODULE_LICENSE("GPL");
 
 static struct kmem_cache *fuse_inode_cachep;
+static struct workqueue_struct *fuse_uts_release_wq;
 struct list_head fuse_conn_list;
 DEFINE_MUTEX(fuse_mutex);
 DECLARE_WAIT_QUEUE_HEAD(fuse_dev_waitq);
@@ -966,6 +969,16 @@ void fuse_pqueue_init(struct fuse_pqueue *fpq)
 	fpq->connected = 1;
 }
 
+static void fuse_uts_release(struct work_struct *work)
+{
+	struct fuse_conn *fc = container_of(work, struct fuse_conn, uts_release_work);
+
+	/* A last domain reference can drain sysfs: release in sleepable context. */
+	uts_resources_release(fc->uts_view);
+	put_user_ns(fc->user_ns);
+	fc->release(fc);
+}
+
 void fuse_conn_init(struct fuse_conn *fc, struct fuse_mount *fm,
 		    struct user_namespace *user_ns,
 		    const struct fuse_iqueue_ops *fiq_ops, void *fiq_priv)
@@ -995,6 +1008,8 @@ void fuse_conn_init(struct fuse_conn *fc, struct fuse_mount *fm,
 	get_random_bytes(&fc->scramble_key, sizeof(fc->scramble_key));
 	fc->pid_ns = get_pid_ns(task_active_pid_ns(current));
 	fc->user_ns = get_user_ns(user_ns);
+	fc->uts_view = uts_resources_acquire(current->nsproxy->uts_ns);
+	INIT_WORK(&fc->uts_release_work, fuse_uts_release);
 	fc->max_pages = FUSE_DEFAULT_MAX_PAGES_PER_REQ;
 	fc->max_pages_limit = fuse_max_pages_limit;
 	fc->name_max = FUSE_NAME_LOW_MAX;
@@ -1015,6 +1030,10 @@ static void delayed_release(struct rcu_head *p)
 
 	fuse_uring_destruct(fc);
 
+	if (fc->uts_view) {
+		queue_work(fuse_uts_release_wq, &fc->uts_release_work);
+		return;
+	}
 	put_user_ns(fc->user_ns);
 	fc->release(fc);
 }
@@ -2284,6 +2303,9 @@ static int __init fuse_init(void)
 		FUSE_KERNEL_VERSION, FUSE_KERNEL_MINOR_VERSION);
 
 	INIT_LIST_HEAD(&fuse_conn_list);
+	fuse_uts_release_wq = alloc_workqueue("fuse_uts_release", WQ_UNBOUND | WQ_MEM_RECLAIM, 0);
+	if (!fuse_uts_release_wq)
+		return -ENOMEM;
 	res = fuse_fs_init();
 	if (res)
 		goto err;
@@ -2312,6 +2334,7 @@ static int __init fuse_init(void)
  err_fs_cleanup:
 	fuse_fs_cleanup();
  err:
+	destroy_workqueue(fuse_uts_release_wq);
 	return res;
 }
 
@@ -2323,6 +2346,8 @@ static void __exit fuse_exit(void)
 	fuse_sysfs_cleanup();
 	fuse_fs_cleanup();
 	fuse_dev_cleanup();
+	/* fuse_fs_cleanup has drained RCU callbacks that enqueue domain releases. */
+	destroy_workqueue(fuse_uts_release_wq);
 }
 
 module_init(fuse_init);
