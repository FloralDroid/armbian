+	struct net_device *netdev;
+	struct device *device;
+	unsigned int device_index;
+	const char *bus;
+};
+
+struct uts_sysfs {
+	struct list_head global;
+	struct list_head nodes;
+	struct uts_native_view *native;
+	struct uts_sysfs_node *anchor, *cpus, *net, *class_net;
+	struct uts_sysfs_node *classes, *dev_char, *virtual;
+	struct uts_sysfs_node *dev_block, *blocks;
+	unsigned int failed_device;
+	const char *device_stage;
+};
+
+struct uts_sysfs_node *uts_sysfs_node(struct uts_sysfs *tree,
+				      struct uts_sysfs_node *parent,
+				      const char *name,
