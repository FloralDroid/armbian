+/* Only the native view's fixed read-only allowlists use these helpers. */
+struct kernfs_node *uts_sysfs_source_attr(struct kobject *kobj, const char *name)
+{
+	struct kernfs_node *parent, *kn;
+
+	spin_lock(&sysfs_symlink_target_lock);
+	parent = kobj->sd;
+	if (parent)
+		kernfs_get(parent);
+	spin_unlock(&sysfs_symlink_target_lock);
+	if (!parent)
+		return NULL;
+	kn = sysfs_get_dirent(parent, name);
+	kernfs_put(parent);
+	return kn;
+}
+
+ssize_t uts_sysfs_read_source(struct kobject *kobj, const char *name, char *buf)
+{
+	struct kernfs_node *kn = uts_sysfs_source_attr(kobj, name);
+	const struct sysfs_ops *ops;
+	ssize_t ret = -ENODEV;
+
+	if (!kn)
+		return -ENOENT;
+	if (!kernfs_get_active(kn))
+		goto out;
+	/* Never call a binary attribute or an unrecognized file implementation. */
+	if (kernfs_type(kn) != KERNFS_FILE ||
+	    kn->attr.ops->seq_show != sysfs_kf_seq_show || !(kn->mode & 0444)) {
+		ret = -EACCES;
+		goto inactive;
+	}
+	ops = sysfs_file_ops(kn);
+	ret = ops && ops->show ? ops->show(sysfs_file_kobj(kn), kn->priv, buf) : -EIO;
+	if (ret >= PAGE_SIZE)
+		ret = -EOVERFLOW;
+inactive:
+	kernfs_put_active(kn);
+out:
+	kernfs_put(kn);
+	return ret;
+}
