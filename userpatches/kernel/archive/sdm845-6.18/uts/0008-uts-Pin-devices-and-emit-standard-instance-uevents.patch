+		return 0;
+	/* Deliver the pinned object's final removal, never authorize its replacement. */
+	if (!uts_resources_live(view) && strcmp(action, "remove"))
 		return 0;
 	for (i = 0; i < ARRAY_SIZE(kobject_actions); i++)
 		if (!strcmp(action, kobject_actions[i]))
@@ -522,24 +557,57 @@ static int uevent_project(struct uevent_sock *socket, struct kobj_uevent_env *so
 		if (!name || !minor || !*name || strlen(name) >= IFNAMSIZ ||
 		    strchr(name, '/') || kstrtouint(minor, 10, &index) || !index)
 			return 0;
-		snprintf(path, sizeof(path), "/devices/virtual/net/%s", name);
+		snprintf(netpath, sizeof(netpath), "/devices/virtual/net/%s", name);
 	} else {
 		major = uevent_value(source, "MAJOR");
 		minor = uevent_value(source, "MINOR");
-		if (!major || !minor || kstrtouint(major, 10, &maj) || kstrtouint(minor, 10, &min))
+		if ((major || minor) && (!major || !minor ||
+		    kstrtouint(major, 10, &maj) || kstrtouint(minor, 10, &min)))
 			return 0;
 		for (i = 0; i < projection->info.count; i++) {
 			const struct uts_event_device *candidate = &projection->info.devices[i];
 			const char *class = uts_event_class_name(candidate->class);
 
 			if (candidate->major == maj && candidate->minor == min && !strcmp(class, subsystem)) {
+#ifdef CONFIG_UTS_NS_VIEWS
+				struct uts_native_view *native = uts_resources_native(view);
+
+				/* Named sysfs-only objects all have dev_t 0:0. Select by
+				 * pinned identity before committing to a candidate. */
+				if (!native || !native->devices[i] || &native->devices[i]->kobj != kobj)
+					continue;
+#else
+				continue;
+#endif
 				device = candidate;
 				break;
 			}
 		}
 		if (!device)
 			return 0;
-		snprintf(path, sizeof(path), "/devices/virtual/lupine/%s/%s", subsystem, device->name);
+		/* A recycled dev_t must not authorize the replacement device. */
+#ifdef CONFIG_UTS_NS_VIEWS
+		{
+			struct uts_native_view *native = uts_resources_native(view);
+
+			if (!native || !native->devices[i] ||
+			    &native->devices[i]->kobj != kobj)
+				return 0;
+		}
+#else
+		return 0;
+#endif
+		{
+#ifdef CONFIG_UTS_NS_VIEWS
+			struct uts_native_view *native = uts_resources_native(view);
+
+			if (!native || !native->devpaths[i])
+				return -ENODEV;
+			path = native->devpaths[i];
+#else
+			return 0;
+#endif
+		}
 	}
 	env = kzalloc(sizeof(*env), GFP_KERNEL);
 	if (!env)
@@ -548,23 +616,51 @@ static int uevent_project(struct uevent_sock *socket, struct kobj_uevent_env *so
 	ret = ret ?: add_uevent_var(env, "DEVPATH=%s", path);
 	ret = ret ?: add_uevent_var(env, "SUBSYSTEM=%s", subsystem);
 	if (device) {
-		ret = ret ?: add_uevent_var(env, "MAJOR=%u", device->major);
-		ret = ret ?: add_uevent_var(env, "MINOR=%u", device->minor);
-		ret = ret ?: add_uevent_var(env, "DEVNAME=%s%s",
-			uts_event_dev_prefix(device->class), device->name);
-		/* These DRM UAPI payloads carry object IDs, not physical parent paths. */
-		if (device->class == UTS_EVENT_DRM) {
-			const char *keys[] = { "HOTPLUG", "CONNECTOR", "PROPERTY", "LEASE" };
-
-			ret = ret ?: add_uevent_var(env, "DEVTYPE=drm_minor");
-			for (i = 0; !ret && i < ARRAY_SIZE(keys); i++) {
-				const char *value = uevent_value(source, keys[i]);
-				unsigned int number;
-
-				if (value && !kstrtouint(value, 10, &number))
-					ret = add_uevent_var(env, "%s=%u", keys[i], number);
+		if (!uts_event_sysfs_only(device->class)) {
+			const char *devname = NULL;
+
+#ifdef CONFIG_UTS_NS_VIEWS
+			devname = uts_resources_native(view)->devnames[i];
+#endif
+			if (!devname || !*devname) {
+				kfree(env);
+				return -ENODEV;
+			}
+			ret = ret ?: add_uevent_var(env, "MAJOR=%u", device->major);
+			ret = ret ?: add_uevent_var(env, "MINOR=%u", device->minor);
+			ret = ret ?: add_uevent_var(env, "DEVNAME=%s", devname);
+		} else {
+			unsigned int j;
+
+			for (j = 0; !ret && j < source->envp_idx; j++)
+				if (uts_event_payload(device->class, source->envp[j]))
+					ret = add_uevent_var(env, "%s", source->envp[j]);
+		}
+		if (device->class == UTS_EVENT_DRM || device->class == UTS_EVENT_VIDEO ||
+		    device->class == UTS_EVENT_MEDIA) {
+			unsigned int j;
+
+			/* Identity and driver-specific payload remain real. Routing fields
+			 * are supplied only by the selected instance projection above. */
+			for (j = 0; !ret && j < source->envp_idx; j++) {
+				const char *field = source->envp[j];
+
+				if (!strncmp(field, "ACTION=", 7) || !strncmp(field, "DEVPATH=", 8) ||
+				    !strncmp(field, "SUBSYSTEM=", 10) || !strncmp(field, "MAJOR=", 6) ||
+				    !strncmp(field, "MINOR=", 6) || !strncmp(field, "DEVNAME=", 8) ||
+				    !strncmp(field, "SEQNUM=", 7))
+					continue;
+				ret = add_uevent_var(env, "%s", field);
 			}
 		}
+#if defined(CONFIG_UTS_NS_VIEWS) && defined(CONFIG_BLOCK)
+		if (device->class == UTS_EVENT_BLOCK) {
+			struct uts_native_view *native = uts_resources_native(view);
+
+			ret = ret ?: add_uevent_var(env, "DEVTYPE=%s",
+				bdev_is_partition(dev_to_bdev(native->devices[i])) ? "partition" : "disk");
+		}
+#endif
 	} else {
 		ret = ret ?: add_uevent_var(env, "INTERFACE=%s", name);
 		ret = ret ?: add_uevent_var(env, "IFINDEX=%u", index);
@@ -576,6 +672,86 @@ static int uevent_project(struct uevent_sock *socket, struct kobj_uevent_env *so
 	return ret;
 }
 
+#ifdef CONFIG_UTS_NS_VIEWS
+int uts_views_emit_event(struct uts_resource_view *view, struct net *net,
+		const struct uts_event_device *device, struct net_device *netdev,
+		const char *action, size_t count)
+{
+	struct kobj_uevent_env *env;
+	struct kobject *kobj = NULL;
+	enum kobject_action type;
+	int ret;
+
+	ret = kobject_action_type(action, count, &type, NULL);
+	if (ret)
+		return ret;
+	if (!uts_resources_live(view))
+		return -ENODEV;
+	env = kzalloc(sizeof(*env), GFP_KERNEL);
+	if (!env)
+		return -ENOMEM;
+	ret = add_uevent_var(env, "ACTION=%s", kobject_actions[type]);
+	if (device) {
+		const struct uts_event_info *info = uts_resources_event_info(view);
+		struct uts_native_view *native = uts_resources_native(view);
+		unsigned int i;
+
+		for (i = 0; native && info && i < info->count; i++)
+			if (device == &info->devices[i] && native->devices[i] &&
+			    device_is_registered(native->devices[i])) {
+				kobj = &native->devices[i]->kobj;
+				break;
+			}
+		if (!kobj) {
+			kfree(env);
+			return -ENODEV;
+		}
+		ret = ret ?: add_uevent_var(env, "SUBSYSTEM=%s", uts_event_class_name(device->class));
+		if (!uts_event_sysfs_only(device->class)) {
+			ret = ret ?: add_uevent_var(env, "MAJOR=%u", device->major);
+			ret = ret ?: add_uevent_var(env, "MINOR=%u", device->minor);
+		}
+		if (device->class == UTS_EVENT_DRM || device->class == UTS_EVENT_VIDEO ||
+		    device->class == UTS_EVENT_MEDIA || uts_event_sysfs_only(device->class)) {
+			char *storage = kzalloc(PAGE_SIZE, GFP_KERNEL);
+			char *text, *line;
+			ssize_t len;
+
+			if (!storage) {
+				kfree(env);
+				return -ENOMEM;
+			}
+			len = uts_sysfs_read_source(kobj, "uevent", storage);
+			if (len < 0 && !(device->class == UTS_EVENT_THERMAL && len == -ENOENT))
+				ret = len;
+			text = storage;
+			while (!ret && len > 0 && (line = strsep(&text, "\n"))) {
+				if (!*line || !strncmp(line, "MAJOR=", 6) ||
+				    !strncmp(line, "MINOR=", 6))
+					continue;
+				ret = add_uevent_var(env, "%s", line);
+			}
+			kfree(storage);
+		}
+	} else if (netdev && dev_net(netdev) == net) {
+		ret = ret ?: add_uevent_var(env, "SUBSYSTEM=net");
+		ret = ret ?: add_uevent_var(env, "INTERFACE=%s", netdev->name);
+		ret = ret ?: add_uevent_var(env, "IFINDEX=%u", netdev->ifindex);
+	} else {
+		ret = -EPERM;
+	}
+	mutex_lock(&uevent_sock_mutex);
+	if (!ret && (!net->uevent_sock || net->uevent_sock->view != view))
+		ret = -EPERM;
+	if (!ret)
+		ret = uevent_project(net->uevent_sock, env, !device, kobj);
+	mutex_unlock(&uevent_sock_mutex);
+	kfree(env);
+	return ret;
+}
+
+#endif
+
