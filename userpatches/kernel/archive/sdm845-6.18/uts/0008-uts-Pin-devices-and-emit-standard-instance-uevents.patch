 {
 	return 0;
 }
@@ -618,7 +795,7 @@ static int uevent_project_user(struct uevent_sock *socket, struct sk_buff *skb)
 }
 #endif
 
-static int uevent_net_broadcast_untagged(struct kobj_uevent_env *env,
