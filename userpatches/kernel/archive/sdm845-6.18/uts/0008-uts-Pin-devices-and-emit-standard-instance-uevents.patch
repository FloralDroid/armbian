From aae8560a83b82504d2c0d5c3ff08f0405ad6815e Mon Sep 17 00:00:00 2001
From: 5656565566 <contact@home56.top>
Date: Sun, 1 Nov 2026 23:34:22 +0800
Subject: [PATCH] uts: Pin devices and emit standard instance uevents

---
 drivers/base/core.c  |  45 ++++++++
 drivers/base/dd.c    |   6 ++
 init/Kconfig         |  10 ++
 lib/kobject_uevent.c | 237 +++++++++++++++++++++++++++++++++++++------
 4 files changed, 268 insertions(+), 30 deletions(-)

diff --git a/drivers/base/core.c b/drivers/base/core.c
index 5ba783e50..ed7e7fc9f 100644
--- a/drivers/base/core.c
+++ b/drivers/base/core.c
@@ -13,6 +13,8 @@
 #include <linux/cleanup.h>
 #include <linux/cpufreq.h>
 #include <linux/device.h>
+#include <linux/uts_views.h>
+#include <linux/uts_resources.h>
 #include <linux/dma-map-ops.h> /* for dma_default_coherent */
 #include <linux/err.h>
 #include <linux/fwnode.h>
@@ -3056,6 +3058,46 @@ static DEVICE_ATTR_RO(dev);
 /* /sys/devices/ */
 struct kset *devices_kset;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+bool uts_device_matches_event(struct device *dev,
+			      const struct uts_event_device *entry)
+{
+	const char *kind = uts_event_class_name(entry->class);
+	const char *subsystem = dev->bus ? dev->bus->name :
+		(dev->class ? dev->class->name : NULL);
+
+	return kind && subsystem && !strcmp(kind, subsystem) &&
+	       dev->devt == MKDEV(entry->major, entry->minor) &&
+	       !strcmp(dev_name(dev), entry->name) && device_is_registered(dev);
+}
+
+/* Pin a registered device, rather than trusting a reusable major/minor pair. */
+struct device *uts_device_get_by_event(const struct uts_event_device *entry)
+{
+	struct kobject *kobj;
+	struct device *dev, *found = NULL;
+
+	if (!uts_event_class_name(entry->class))
+		return NULL;
+	spin_lock(&devices_kset->list_lock);
+	list_for_each_entry(kobj, &devices_kset->list, entry) {
+		if (kobj->ktype != &device_ktype)
+			continue;
+		dev = kobj_to_dev(kobj);
+		if (uts_device_matches_event(dev, entry) && kobject_get_unless_zero(kobj)) {
+			found = dev;
+			break;
+		}
+	}
+	spin_unlock(&devices_kset->list_lock);
+	if (found && !uts_device_matches_event(found, entry)) {
+		put_device(found);
+		found = NULL;
+	}
+	return found;
+}
+#endif
+
 /**
  * devices_kset_move_before - Move device in the devices_kset's list.
  * @deva: Device to move.
@@ -3222,6 +3264,9 @@ static void klist_children_put(struct klist_node *n)
  */
 void device_initialize(struct device *dev)
 {
+#ifdef CONFIG_UTS_NS_VIEWS
+	dev->uts_bind_generation = 0;
+#endif
 	dev->kobj.kset = devices_kset;
 	kobject_init(&dev->kobj, &device_ktype);
 	INIT_LIST_HEAD(&dev->dma_pools);
diff --git a/drivers/base/dd.c b/drivers/base/dd.c
index d019d0f98..c2727bc2d 100644
--- a/drivers/base/dd.c
+++ b/drivers/base/dd.c
@@ -466,6 +466,9 @@ static void driver_bound(struct device *dev)
 		__func__);
 
 	klist_add_tail(&dev->p->knode_driver, &dev->driver->p->klist_devices);
+#ifdef CONFIG_UTS_NS_VIEWS
+	WRITE_ONCE(dev->uts_bind_generation, dev->uts_bind_generation + 1);
+#endif
 	device_links_driver_bound(dev);
 
 	device_pm_check_callbacks(dev);
@@ -1325,6 +1328,9 @@ static void __device_release_driver(struct device *dev, struct device *parent)
 
 	drv = dev->driver;
 	if (drv) {
+#ifdef CONFIG_UTS_NS_VIEWS
+		WRITE_ONCE(dev->uts_bind_generation, dev->uts_bind_generation + 1);
+#endif
 		pm_runtime_get_sync(dev);
 
 		while (device_links_busy(dev)) {
diff --git a/init/Kconfig b/init/Kconfig
index 7fd7b8ebf..6fab07e7c 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1384,6 +1384,16 @@ config UTS_NS_RESOURCES
 	  Unbound namespaces retain the original kernel behavior.
 
 
+config UTS_NS_VIEWS
+	bool "Host-managed native instance procfs and sysfs"
+	depends on ARM64 || X86
+	depends on UTS_NS_RESOURCES && PROC_FS && SYSFS
+	depends on PID_NS && NET_NS && TIME_NS && PSI
+	help
+	  Bind native proc and sysfs mounts to the host-configured UTS instance
+	  domain. Keep Android's standard filesystem and syscall interfaces.
+	  A namespace without a native configuration retains normal behavior.
+
 config ANDROID_UID_CPUTIME
 	bool "Android per-UID CPU time accounting"
 	depends on PROC_FS && PID_NS
diff --git a/lib/kobject_uevent.c b/lib/kobject_uevent.c
index 36cf9c01d..0ce86edbb 100644
--- a/lib/kobject_uevent.c
+++ b/lib/kobject_uevent.c
@@ -30,6 +30,9 @@
 #include <linux/uaccess.h>
 #include <linux/uts_namespace.h>
 #include <linux/uts_resources.h>
+#include <linux/uts_views.h>
+#include <linux/device.h>
+#include <linux/blkdev.h>
 #include <net/sock.h>
 #include <net/netlink.h>
 #include <net/net_namespace.h>
@@ -320,6 +323,33 @@ struct uts_event_projection {
 	atomic64_t sequence;
 };
 
+struct uts_resource_view *uts_uevent_resources(struct net *net)
+{
+	struct uts_resource_view *view;
+
+	mutex_lock(&uevent_sock_mutex);
+	view = net->uevent_sock ? uts_resources_get(net->uevent_sock->view) : NULL;
+	mutex_unlock(&uevent_sock_mutex);
+	return view;
+}
+
+bool uts_uevent_matches(struct uts_resource_view *view, struct net *net)
+{
+	bool match;
+
+	mutex_lock(&uevent_sock_mutex);
+	match = net->uevent_sock && net->uevent_sock->view == view;
+	mutex_unlock(&uevent_sock_mutex);
+	return match;
+}
+
+const struct uts_event_info *uts_resources_event_info(struct uts_resource_view *view)
+{
+	struct uts_event_projection *projection = uts_resources_events(view);
+
+	return projection ? &projection->info : NULL;
+}
+
 static const char *uevent_value(const struct kobj_uevent_env *env, const char *key)
 {
 	size_t length = strlen(key);
@@ -335,11 +365,12 @@ static bool uevent_name_valid(const char *name, size_t size)
 {
 	size_t i, length = strnlen(name, size);
 
-	if (!length || length == size || !isalnum(name[0]))
+	if (!length || length == size || !strcmp(name, ".") || !strcmp(name, ".."))
 		return false;
 	for (i = 0; i < length; i++)
 		if (!isalnum(name[i]) && name[i] != '_' && name[i] != '-' &&
-		    name[i] != '.' && name[i] != ',')
+		    name[i] != '.' && name[i] != ',' && name[i] != ':' &&
+		    name[i] != '@' && name[i] != '+')
 			return false;
 	return !memchr_inv(name + length, 0, size - length);
 }
@@ -495,7 +526,7 @@ long uts_uevent_ioctl(struct uts_namespace *ns, unsigned int cmd, unsigned long
 }
 
 static int uevent_project(struct uevent_sock *socket, struct kobj_uevent_env *source,
-			 bool tagged)
+			 bool tagged, struct kobject *kobj)
