 		}
 		if (!skb) {
@@ -703,7 +880,7 @@ static int uevent_net_broadcast_tagged(struct sock *usk, struct kobj_uevent_env
 	struct uevent_sock *socket = sock_net(usk)->uevent_sock;
 
 	if (smp_load_acquire(&socket->view))
-		return uevent_project(socket, env, true);
+		return uevent_project(socket, env, true, NULL);
 	return uevent_net_deliver(usk, env, action, path);
 }
 #endif
@@ -736,7 +913,7 @@ static int kobject_uevent_net_broadcast(struct kobject *kobj,
 			net = kobj->ktype->namespace(kobj);
 
 	if (!net)
-		ret = uevent_net_broadcast_untagged(env, action_string,
+		ret = uevent_net_broadcast_untagged(kobj, env, action_string,
 						    devpath);
 	else
 		ret = uevent_net_broadcast_tagged(net->uevent_sock->sk, env,
