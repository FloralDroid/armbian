 {
@@ -635,7 +812,7 @@ static int uevent_net_broadcast_untagged(struct kobj_uevent_env *env,
 			continue;
 
 		if (smp_load_acquire(&ue_sk->view)) {
-			retval = uevent_project(ue_sk, env, false);
+			retval = uevent_project(ue_sk, env, false, kobj);
