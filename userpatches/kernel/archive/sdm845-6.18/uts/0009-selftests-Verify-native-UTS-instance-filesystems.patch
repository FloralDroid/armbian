+int main(int argc, char **argv)
+{
+	struct instance instances[2];
+	struct uts_view_info info;
+	char path[512], buffer[4096];
+	struct stat before, after;
+	int files[2], fd, status;
+
+	setbuf(stdout, NULL);
+	compat_helper = argc > 1 ? argv[1] : NULL;
+	fd = open("/proc/self/ns/uts", O_RDONLY | O_CLOEXEC);
+	CHECK(fd >= 0);
+	if (ioctl(fd, NS_UTS_GET_VIEW, &info) && errno == ENOTTY) {
+		puts("SKIP: CONFIG_UTS_NS_VIEWS is unavailable");
+		return 4;
+	}
+	CHECK(info.abi == 1 && info.flags == 0);
+	{
+		struct uts_view_interfaces interfaces;
+
+		memset(&interfaces, 0xa5, sizeof(interfaces));
+		CHECK(!ioctl(fd, NS_UTS_GET_INTERFACES, &interfaces));
+		CHECK(interfaces.abi == 1 && interfaces.size == sizeof(interfaces));
+		CHECK(interfaces.device_classes & (1ULL << UTS_EVENT_MISC));
+		CHECK(interfaces.interfaces & UTS_INTERFACE_HARDWARE_IDENTITY);
+		CHECK(interfaces.interfaces & UTS_INTERFACE_MEDIA_BUS);
+		for (size_t i = 0; i < sizeof(interfaces.reserved) / sizeof(interfaces.reserved[0]); i++)
+			CHECK(!interfaces.reserved[i]);
+	}
+	close(fd);
+	host_net = open("/proc/self/ns/net", O_RDONLY | O_CLOEXEC);
+	host_pid = open("/proc/self/ns/pid", O_RDONLY | O_CLOEXEC);
+	CHECK(host_net >= 0 && host_pid >= 0);
+	get("/proc/sys/kernel/random/boot_id", host_boot, sizeof(host_boot));
+	for (size_t i = 0; i < 6; i++) {
+		sysctl_present[i] = access(native_sysctls[i], F_OK) == 0;
+		if (sysctl_present[i])
+			host_sysctls[i] = read_integer(native_sysctls[i]);
+	}
+	CHECK(!stat("/proc/meminfo", &before));
+	origin = clockns(CLOCK_BOOTTIME);
+	mono_offset = (int64_t)clockns(CLOCK_BOOTTIME) -
+		      (int64_t)clockns(CLOCK_MONOTONIC);
+	if (mono_offset < 0)
+		mono_offset = 0;
+	mono_offset -= origin;
+	snprintf(fixture, sizeof(fixture), "/sys/fs/cgroup/uts-views-%d",
+		 getpid());
+	CHECK(!mkdir(fixture, 0700));
+	snprintf(path, sizeof(path), "%s/cgroup.subtree_control", fixture);
+	put(path, "+cpu +memory +cpuset +pids +io");
+	for (unsigned int i = 0; i < 2; i++) {
+		launch(&instances[i], i);
+		configure(&instances[i], i);
+		send_byte(instances[i].channel[0], 'g');
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		files[i] = receive_fd(instances[i].channel[0]);
+		expect_byte(instances[i].channel[0], 'p');
+		CHECK(read(files[i], buffer, sizeof(buffer)) > 0);
+		CHECK(lseek(files[i], 0, SEEK_SET) == 0);
+	}
+	check_deleted_cgroup(&instances[0]);
+	puts("PASS: two native proc/sysfs mounts, fixed FDs, syscall/time/identity views and remounts");
+	for (unsigned int i = 0; i < 2; i++)
+		send_byte(instances[i].channel[0], 'p');
+	for (unsigned int i = 0; i < 2; i++)
+		expect_byte(instances[i].channel[0], 'd');
+	puts("PASS: instance PSI triggers/poll, standard Netlink coldboot and descendant netns");
+	for (unsigned int i = 0; i < 2; i++) {
+		send_byte(instances[i].channel[0], 'x');
+		CHECK(waitpid(instances[i].shim, &status, 0) ==
+			      instances[i].shim &&
+		      WIFEXITED(status) && !WEXITSTATUS(status));
+		CHECK(!ioctl(instances[i].ns[0], NS_UTS_GET_VIEW, &info) &&
+		      info.flags == UTS_VIEW_BOUND);
+		CHECK(lseek(files[i], 0, SEEK_SET) == 0);
+		CHECK(read(files[i], buffer, sizeof(buffer)) == -1 &&
+		      errno == ENODEV);
+		close(files[i]);
+		for (int j = 0; j < NS_COUNT; j++)
+			close(instances[i].ns[j]);
+		close(instances[i].cgroup);
+		close(instances[i].channel[0]);
+		CHECK(!rmdir(instances[i].path));
+	}
+	CHECK(!rmdir(fixture));
+	CHECK(!stat("/proc/meminfo", &after) &&
+	      (before.st_mode & 0777) == (after.st_mode & 0777));
+	get("/proc/sys/kernel/random/boot_id", buffer, sizeof(buffer));
+	CHECK(!strcmp(buffer, host_boot));
+	for (size_t i = 0; i < 6; i++)
+		if (sysctl_present[i])
+			CHECK(read_integer(native_sysctls[i]) == host_sysctls[i]);
+	puts("PASS: init exit revokes LIVE and stale file reads; host identity and permissions unchanged");
+	return 0;
+}
