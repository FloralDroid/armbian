+int proc_native_sysctl_permission(struct inode *inode, const struct ctl_table *table,
+				 int mask)
+{
+	static const char *const paths[] = {
+		"/sys/kernel/pid_max", "/sys/kernel/kptr_restrict",
+		"/sys/kernel/dmesg_restrict", "/sys/kernel/perf_event_paranoid",
+		"/sys/kernel/randomize_va_space", "/sys/vm/mmap_rnd_bits",
+		"/sys/vm/mmap_rnd_compat_bits", "/sys/kernel/hostname",
+		"/sys/kernel/domainname",
+	};
+	struct proc_fs_info *fs = proc_sb_info(inode->i_sb);
+	struct user_namespace *user_ns;
+	struct dentry *dentry;
+	char buffer[128], *path;
+	int mode = table->mode;
+	bool private;
+
+	if (!fs->uts_view)
+		return 1;
+	if (mask & MAY_NOT_BLOCK)
+		return -ECHILD;
+	dentry = d_find_alias(inode);
+	if (!dentry)
+		return -ENOENT;
+	path = dentry_path_raw(dentry, buffer, sizeof(buffer));
+	private = !IS_ERR(path) && named(path, paths, ARRAY_SIZE(paths));
+	dput(dentry);
+	if (!private)
+		return 1;
+	if (!uts_resources_live(fs->uts_view))
+		return -ENODEV;
+	if (smp_load_acquire(&current->nsproxy->uts_ns->resources) != fs->uts_view)
+		return -EPERM;
+
+	/* Only existing private handlers use namespace-relative owner bits. */
+	user_ns = fs->uts_ns->user_ns;
+	if (uid_eq(current_euid(), make_kuid(user_ns, 0)))
+		mode >>= 6;
+	else if (in_egroup_p(make_kgid(user_ns, 0)))
+		mode >>= 3;
+	return (mask & ~mode & (MAY_READ | MAY_WRITE | MAY_EXEC)) ? -EACCES : 0;
+}
+
 static int native_restrict_sysctl(const struct ctl_table *table, int *value,
+				 struct user_namespace *user_ns, bool sysadmin,
 				 int write, void *buffer, size_t *length,
 				 loff_t *pos)
 {
@@ -281,7 +328,13 @@ static int native_restrict_sysctl(const struct ctl_table *table, int *value,
 
 	/* Instance policy may tighten a shared kernel's restrictions. */
 	local.data = &result;
-	ret = table->proc_handler(&local, write, buffer, length, pos);
+	if (sysadmin) {
+		if (write && !ns_capable(user_ns, CAP_SYS_ADMIN))
+			return -EPERM;
+		ret = proc_dointvec_minmax(&local, write, buffer, length, pos);
+	} else {
+		ret = table->proc_handler(&local, write, buffer, length, pos);
+	}
 	if (!ret && write) {
 		if (result < minimum)
 			return -EPERM;
@@ -323,14 +376,17 @@ int proc_native_sysctl(struct file *file, const struct ctl_table *table,
 	}
 	if (!strcmp(path, "/sys/kernel/kptr_restrict")) {
 		return native_restrict_sysctl(table, &native->kptr_restrict,
+					      fs->uts_ns->user_ns, true,
 					      write, buffer, length, pos);
 	}
 	if (!strcmp(path, "/sys/kernel/dmesg_restrict")) {
 		return native_restrict_sysctl(table, &native->dmesg_restrict,
+					      fs->uts_ns->user_ns, true,
 					      write, buffer, length, pos);
 	}
 	if (!strcmp(path, "/sys/kernel/perf_event_paranoid")) {
 		return native_restrict_sysctl(table, &native->perf_event_paranoid,
+					      fs->uts_ns->user_ns, false,
 					      write, buffer, length, pos);
 	}
 	if (!strcmp(path, "/sys/kernel/randomize_va_space")) {
diff --git a/fs/proc/proc_sysctl.c b/fs/proc/proc_sysctl.c
index a27ff61c9babedb7f55aaaff0799e201cf5c644b..4764cc883cd2e4b66a4eb258c29eb346ebeb92c3 100644
--- a/fs/proc/proc_sysctl.c
+++ b/fs/proc/proc_sysctl.c
@@ -569,8 +569,10 @@ static ssize_t proc_sys_call_handler(struct kiocb *iocb, struct iov_iter *iter,
 	 * At this point we know that the sysctl was not unregistered
 	 * and won't be until we finish.
 	 */
-	error = -EPERM;
-	if (sysctl_perm(head, table, write ? MAY_WRITE : MAY_READ))
+	error = proc_native_sysctl_permission(inode, table, write ? MAY_WRITE : MAY_READ);
+	if (error == 1)
+		error = sysctl_perm(head, table, write ? MAY_WRITE : MAY_READ);
+	if (error)
 		goto out;
 
 	/* if that can happen at all, it should be -EINVAL, not -EISDIR */
@@ -818,8 +820,11 @@ static int proc_sys_permission(struct mnt_idmap *idmap,
 	table = PROC_I(inode)->sysctl_entry;
 	if (!table) /* global root - r-xr-xr-x */
 		error = mask & MAY_WRITE ? -EACCES : 0;
-	else /* Use the permissions on the sysctl table entry */
-		error = sysctl_perm(head, table, mask & ~MAY_NOT_BLOCK);
+	else {
+		error = proc_native_sysctl_permission(inode, table, mask);
+		if (error == 1)
+			error = sysctl_perm(head, table, mask & ~MAY_NOT_BLOCK);
+	}
 
 	sysctl_head_finish(head);
 	return error;
