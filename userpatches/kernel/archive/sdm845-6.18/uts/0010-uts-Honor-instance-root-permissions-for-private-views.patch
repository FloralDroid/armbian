From: 5656565566 <contact@home56.top>
Subject: [PATCH] uts: Honor instance root permissions for private views

Use the proc view owner namespace for existing private sysctl permissions.
Check both open and IO, reject foreign resource domains, and preserve
shared-kernel security floors and SELinux checks. Namespaced SYS_ADMIN
replaces initial-user-namespace SYS_ADMIN only for private restriction values.

Initialize private tree nodes and attributes with the mapped root of the
bound network namespace. Preserve existing attribute modes and stores;
never change the real host sysfs nodes or their ownership.

Signed-off-by: 5656565566 <contact@home56.top>

diff --git a/fs/proc/internal.h b/fs/proc/internal.h
index bb8d720ef02c77f523af01fafda93c021d3a9d6e..2c0e388d628646e52b522f68d35b2756f11c354b 100644
--- a/fs/proc/internal.h
+++ b/fs/proc/internal.h
@@ -24,12 +24,16 @@ struct proc_dir_entry;
 bool proc_native_visible(struct super_block *sb, struct proc_dir_entry *de);
 void proc_native_inode(struct inode *inode, struct proc_dir_entry *de);
 bool proc_native_sysctl_visible(struct dentry *dir, const char *name);
+int proc_native_sysctl_permission(struct inode *inode, const struct ctl_table *table,
+				 int mask);
 int proc_native_sysctl(struct file *file, const struct ctl_table *table, int write,
 		       void *buffer, size_t *length, loff_t *pos);
 #else
 static inline bool proc_native_visible(struct super_block *sb, struct proc_dir_entry *de) { return true; }
 static inline void proc_native_inode(struct inode *inode, struct proc_dir_entry *de) {}
 static inline bool proc_native_sysctl_visible(struct dentry *dir, const char *name) { return true; }
+static inline int proc_native_sysctl_permission(struct inode *inode,
+			const struct ctl_table *table, int mask) { return 1; }
 static inline int proc_native_sysctl(struct file *file, const struct ctl_table *table, int write,
 				     void *buffer, size_t *length, loff_t *pos) { return 1; }
 #endif
