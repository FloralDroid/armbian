 					     .store = node_store };
+
+static void node_ownership(const struct kobject *kobj, kuid_t *uid, kgid_t *gid)
+{
+	const struct uts_sysfs_node *node =
+		container_of(kobj, struct uts_sysfs_node, kobj);
+	const struct uts_sysfs *tree = node->native->sysfs_data;
+
+	*uid = tree->uid;
+	*gid = tree->gid;
+}
+
 static const struct kobj_type native_type = {
 	.release = node_release,
 	.sysfs_ops = &native_ops,
 	.namespace = node_namespace,
 	.child_ns_type = node_child_namespace,
+	.get_ownership = node_ownership,
 };
 
 /* Keep dynamic attribute pointers with their node, until its files are removed. */
@@ -488,6 +501,7 @@ int uts_sysfs_create(struct uts_native_view *native, struct net *net)
 	struct node_attributes *anchor;
 	struct uts_sysfs_node *devices, *system, *fs, *dev, *node;
 	struct net_device *netdev;
+	struct iattr ownership;
 	int ret;
 
 	ASSERT_RTNL();
@@ -498,6 +512,13 @@ int uts_sysfs_create(struct uts_native_view *native, struct net *net)
 		kfree(anchor);
 		return -ENOMEM;
 	}
+	tree->uid = make_kuid(net->user_ns, 0);
+	tree->gid = make_kgid(net->user_ns, 0);
+	if (!uid_valid(tree->uid) || !gid_valid(tree->gid)) {
+		kfree(tree);
+		kfree(anchor);
+		return -EOVERFLOW;
+	}
 	INIT_LIST_HEAD(&tree->nodes);
 	INIT_LIST_HEAD(&tree->global);
 	INIT_LIST_HEAD(&anchor->attributes);
@@ -516,6 +537,14 @@ int uts_sysfs_create(struct uts_native_view *native, struct net *net)
 	anchor->node.kobj.sd = kernfs_root_to_node(native->sysfs);
 	anchor->node.kobj.sd->priv = &anchor->node.kobj;
 	native->sysfs_data = tree;
+	ownership = (struct iattr) {
+		.ia_valid = ATTR_UID | ATTR_GID,
+		.ia_uid = tree->uid,
+		.ia_gid = tree->gid,
+	};
+	ret = kernfs_setattr(anchor->node.kobj.sd, &ownership);
+	if (ret)
+		return ret;
 #define DIR(dst, parent, name)                                               \
