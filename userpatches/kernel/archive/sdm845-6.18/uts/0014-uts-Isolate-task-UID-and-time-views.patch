diff --git a/drivers/dma-buf/sync_file.c b/drivers/dma-buf/sync_file.c
index 747e377fb95417ddd506b528618a4288bea9d459..02cc995fbe7d22ed3eecaff6d0a53a10b3f7a84d 100644
--- a/drivers/dma-buf/sync_file.c
+++ b/drivers/dma-buf/sync_file.c
@@ -16,10 +16,20 @@
 #include <linux/uaccess.h>
 #include <linux/anon_inodes.h>
 #include <linux/sync_file.h>
+#include <linux/time_namespace.h>
 #include <uapi/linux/sync_file.h>
 
 static const struct file_operations sync_file_fops;
 
+static bool sync_file_projected(void)
+{
+#if defined(CONFIG_UTS_NS_VIEWS) && defined(CONFIG_TIME_NS)
+	return current->nsproxy->time_ns->vvar_projected;
+#else
+	return false;
+#endif
+}
+
 static struct sync_file *sync_file_alloc(void)
 {
 	struct sync_file *sync_file;
@@ -141,11 +151,14 @@ char *sync_file_get_name(struct sync_file *sync_file, char *buf, int len)
 		rcu_read_lock();
 		driver = dma_fence_driver_name(fence);
 		timeline = dma_fence_timeline_name(fence);
-		snprintf(buf, len, "%s-%s%llu-%lld",
-			 rcu_dereference(driver),
-			 rcu_dereference(timeline),
-			 fence->context,
-			 fence->seqno);
+		if (sync_file_projected())
+			snprintf(buf, len, "%s-instance", rcu_dereference(driver));
+		else
+			snprintf(buf, len, "%s-%s%llu-%lld",
+				 rcu_dereference(driver),
+				 rcu_dereference(timeline),
+				 fence->context,
+				 fence->seqno);
 		rcu_read_unlock();
 	}
 
@@ -270,22 +283,32 @@ static int sync_fill_fence_info(struct dma_fence *fence,
 {
 	const char __rcu *timeline;
 	const char __rcu *driver;
+	s64 timestamp = 0;
 
 	rcu_read_lock();
 
 	driver = dma_fence_driver_name(fence);
 	timeline = dma_fence_timeline_name(fence);
 
-	strscpy(info->obj_name, rcu_dereference(timeline),
+	/* Driver timelines may contain host-wide context IDs or sequence state. */
+	strscpy(info->obj_name, sync_file_projected() ? "instance" : rcu_dereference(timeline),
 		sizeof(info->obj_name));
 	strscpy(info->driver_name, rcu_dereference(driver),
 		sizeof(info->driver_name));
 
 	info->status = dma_fence_get_status(fence);
-	info->timestamp_ns =
-		dma_fence_is_signaled(fence) ?
-			ktime_to_ns(dma_fence_timestamp(fence)) :
-			ktime_set(0, 0);
+	if (dma_fence_is_signaled(fence)) {
+		timestamp = ktime_to_ns(dma_fence_timestamp(fence));
+#if defined(CONFIG_UTS_NS_VIEWS) && defined(CONFIG_TIME_NS)
+		if (sync_file_projected()) {
+			/* The sealed offset is nonpositive; old events predate this Run. */
+			timestamp += timespec64_to_ns(
+				&current->nsproxy->time_ns->offsets.monotonic);
+			timestamp = max_t(s64, timestamp, 0);
+		}
+#endif
+	}
+	info->timestamp_ns = timestamp;
 
 	rcu_read_unlock();
 
@@ -367,6 +390,7 @@ static int sync_file_ioctl_set_deadline(struct sync_file *sync_file,
 					unsigned long arg)
 {
 	struct sync_set_deadline ts;
+	ktime_t deadline;
 
 	if (copy_from_user(&ts, (void __user *)arg, sizeof(ts)))
 		return -EFAULT;
@@ -374,7 +398,12 @@ static int sync_file_ioctl_set_deadline(struct sync_file *sync_file,
 	if (ts.pad)
 		return -EINVAL;
 
-	dma_fence_set_deadline(sync_file->fence, ns_to_ktime(ts.deadline_ns));
+	deadline = ns_to_ktime(ts.deadline_ns);
+#if defined(CONFIG_UTS_NS_VIEWS) && defined(CONFIG_TIME_NS)
+	if (sync_file_projected())
+		deadline = timens_ktime_to_host(CLOCK_MONOTONIC, deadline);
+#endif
+	dma_fence_set_deadline(sync_file->fence, deadline);
 
 	return 0;
 }
