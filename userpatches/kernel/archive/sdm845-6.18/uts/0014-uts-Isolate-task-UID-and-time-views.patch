From: 5656565566 <contact@home56.top>
Subject: [PATCH] container-root: isolate task, UID accounting and time views

Label explicit task proc files without growing proc inodes; bind UID
resource accounting to the sealed resource cgroup; normalize instance
limits and NUMA identity; publish projected vVAR data while retaining
the vDSO read path; project sync_file query metadata and reject
unprivileged sealed DRM primary opens before implicit master
acquisition. Advertise these prerequisites through the existing native
capability interface.

This extends the existing configured device/export boundary. It does
not grant GPU allocation, submission or global management operations.

Plain Git-generated diff against the complete Linux 6.18.62 SDM845
series. No source commit ID is manufactured.

Signed-off-by: 5656565566 <contact@home56.top>

diff --git a/arch/arm64/kernel/vdso.c b/arch/arm64/kernel/vdso.c
index 78ddf6bdecad704a5b28a29f3f5ca2d9edcda1b9..32f39261b06647a0bae13c9a9c9621144b53d9b9 100644
--- a/arch/arm64/kernel/vdso.c
+++ b/arch/arm64/kernel/vdso.c
@@ -18,6 +18,7 @@
 #include <linux/sched.h>
 #include <linux/signal.h>
 #include <linux/slab.h>
+#include <linux/uts_resources.h>
 #include <linux/vdso_datastore.h>
 #include <linux/vmalloc.h>
 #include <vdso/datapage.h>
@@ -40,6 +41,9 @@ struct vdso_abi_info {
 	unsigned long vdso_pages;
 	/* Code Mapping */
 	struct vm_special_mapping *cm;
+#ifdef CONFIG_UTS_NS_VIEWS
+	struct vm_special_mapping uts_cm;
+#endif
 };
 
 static struct vdso_abi_info vdso_info[] __ro_after_init = {
@@ -65,6 +69,152 @@ static int vdso_mremap(const struct vm_special_mapping *sm,
 	return 0;
 }
 
+#ifdef CONFIG_UTS_NS_VIEWS
+static bool __init vdso_range_valid(unsigned long offset, unsigned long length,
+				    unsigned long size)
+{
+	return offset <= size && length <= size - offset;
+}
+
+static int __init uts_vdso_scrub(void *image, unsigned long size)
+{
+	Elf64_Ehdr *eh64 = image;
+	Elf32_Ehdr *eh32 = image;
+	bool compat = eh64->e_ident[EI_CLASS] == ELFCLASS32;
+	unsigned long phoff, shoff, offset, length, flags;
+	unsigned int phnum, shnum, i, type;
+
+	if (compat) {
+		phoff = eh32->e_phoff;
+		phnum = eh32->e_phnum;
+		shoff = eh32->e_shoff;
+		shnum = eh32->e_shnum;
+	} else {
+		phoff = eh64->e_phoff;
+		phnum = eh64->e_phnum;
+		shoff = eh64->e_shoff;
+		shnum = eh64->e_shnum;
+	}
+	if (!vdso_range_valid(phoff, phnum * (compat ? sizeof(Elf32_Phdr) :
+			     sizeof(Elf64_Phdr)), size) ||
+	    !vdso_range_valid(shoff, shnum * (compat ? sizeof(Elf32_Shdr) :
+			     sizeof(Elf64_Shdr)), size))
+		return -EINVAL;
+
+	for (i = 0; i < phnum; i++) {
+		if (compat) {
+			Elf32_Phdr *ph = image + phoff;
+
+			type = ph[i].p_type;
+			offset = ph[i].p_offset;
+			length = ph[i].p_filesz;
+		} else {
+			Elf64_Phdr *ph = image + phoff;
+
+			type = ph[i].p_type;
+			offset = ph[i].p_offset;
+			length = ph[i].p_filesz;
+		}
+		if (type != PT_NOTE)
+			continue;
+		if (!vdso_range_valid(offset, length, size))
+			return -EINVAL;
+		while (length >= sizeof(Elf32_Nhdr)) {
+			Elf32_Nhdr *note = image + offset;
+			u64 namesz = ALIGN((u64)note->n_namesz, 4);
+			u64 descsz = ALIGN((u64)note->n_descsz, 4);
+			u64 span = sizeof(*note) + namesz + descsz;
+
+			if (span > length)
+				return -EINVAL;
+			/* Retain GNU CPU properties, including BTI/PAC. */
+			if (note->n_type != NT_GNU_PROPERTY_TYPE_0 ||
+			    note->n_namesz != 4 || memcmp(note + 1, "GNU", 4)) {
+				note->n_type = 0;
+				memset(note + 1, 0, namesz + descsz);
+			}
+			offset += span;
+			length -= span;
+		}
+	}
+	/* Non-allocated sections can retain compiler and build metadata. */
+	for (i = 0; i < shnum; i++) {
+		if (compat) {
+			Elf32_Shdr *sh = image + shoff;
+
+			type = sh[i].sh_type;
+			flags = sh[i].sh_flags;
+			offset = sh[i].sh_offset;
+			length = sh[i].sh_size;
+		} else {
+			Elf64_Shdr *sh = image + shoff;
+
+			type = sh[i].sh_type;
+			flags = sh[i].sh_flags;
+			offset = sh[i].sh_offset;
+			length = sh[i].sh_size;
+		}
+		if ((flags & SHF_ALLOC) || type == SHT_NOBITS)
+			continue;
+		if (!vdso_range_valid(offset, length, size))
+			return -EINVAL;
+		memset(image + offset, 0, length);
+	}
+	/* Bionic reads SHT_DYNSYM from the section table during libc startup. */
+	return 0;
+}
+
+static int __init uts_vdso_init(enum vdso_abi abi)
+{
+	struct vdso_abi_info *info = &vdso_info[abi];
+	unsigned long size = info->vdso_pages << PAGE_SHIFT;
+	struct page **pages;
+	void *image;
+	unsigned int i;
+	int ret;
+
+	image = alloc_pages_exact(size, GFP_KERNEL);
+	if (!image)
+		return -ENOMEM;
+	pages = kcalloc(info->vdso_pages, sizeof(*pages), GFP_KERNEL);
+	if (!pages) {
+		ret = -ENOMEM;
+		goto free_image;
+	}
+	memcpy(image, info->vdso_code_start, size);
+	ret = uts_vdso_scrub(image, size);
+	if (ret)
+		goto free_pages;
+	flush_icache_range((unsigned long)image, (unsigned long)image + size);
+	for (i = 0; i < info->vdso_pages; i++)
+		pages[i] = virt_to_page(image + i * PAGE_SIZE);
+	info->uts_cm.name = "[vdso]";
+	info->uts_cm.mremap = vdso_mremap;
+	info->uts_cm.pages = pages;
+	return 0;
+free_pages:
+	kfree(pages);
+free_image:
+	free_pages_exact(image, size);
+	return ret;
+}
+#endif
+
+bool arch_uts_vdso_ready(void)
+{
+#ifdef CONFIG_UTS_NS_VIEWS
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vdso_info); i++) {
+		if (!vdso_info[i].uts_cm.pages)
+			return false;
+	}
+	return !IS_ENABLED(CONFIG_POSIX_AUX_CLOCKS);
+#else
+	return false;
+#endif
+}
+
 static int __init __vdso_init(enum vdso_abi abi)
 {
 	int i;
@@ -95,6 +245,10 @@ static int __init __vdso_init(enum vdso_abi abi)
 
 	vdso_info[abi].cm->pages = vdso_pagelist;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (uts_vdso_init(abi))
+		pr_err("cannot prepare UTS vDSO for %s\n", vdso_info[abi].name);
+#endif
 	return 0;
 }
 
@@ -105,8 +259,16 @@ static int __setup_additional_pages(enum vdso_abi abi,
 {
 	unsigned long vdso_base, vdso_text_len, vdso_mapping_len;
 	unsigned long gp_flags = 0;
+	const struct vm_special_mapping *mapping = vdso_info[abi].cm;
 	void *ret;
 
+#ifdef CONFIG_UTS_NS_VIEWS
+	if (uts_resources_native_active()) {
+		if (!arch_uts_vdso_ready())
+			return -EOPNOTSUPP;
+		mapping = &vdso_info[abi].uts_cm;
+	}
+#endif
 	BUILD_BUG_ON(VDSO_NR_PAGES != __VDSO_PAGES);
 
 	vdso_text_len = vdso_info[abi].vdso_pages << PAGE_SHIFT;
@@ -132,7 +294,7 @@ static int __setup_additional_pages(enum vdso_abi abi,
 				       VM_READ|VM_EXEC|gp_flags|
 				       VM_MAYREAD|VM_MAYWRITE|VM_MAYEXEC|
 				       VM_SEALED_SYSMAP,
-				       vdso_info[abi].cm);
+				       mapping);
 	if (IS_ERR(ret))
 		goto up_fail;
 
