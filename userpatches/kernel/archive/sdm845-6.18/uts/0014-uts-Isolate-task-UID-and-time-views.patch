+int security_task_inode_sid(struct selinux_state *state, u32 sid,
+			    const struct qstr *name, u32 *out_sid)
+{
+	u32 ss_sid, ss_outsid;
+	int rc;
+
+	*out_sid = sid;
+	if (!selinux_initialized(state))
+		return 0;
+	rc = map_global_sid_to_ss(state, sid, &ss_sid, GFP_ATOMIC);
+	if (rc)
+		return rc;
+	rc = selinux_ss_task_inode_sid(state, ss_sid, name, &ss_outsid);
+	if (rc || ss_outsid == ss_sid)
+		return rc;
+	return map_ss_sid_to_global(state, ss_outsid, out_sid, GFP_ATOMIC);
+}
