+static LIST_HEAD(timens_vvar_list);
+
+static struct vdso_rng_data *timens_rng_data(struct time_namespace *ns)
+{
+	return page_address(ns->vvar_page) + VDSO_RNG_DATA_OFFSET;
+}
+
+static void timens_register_vvar(struct time_namespace *ns)
+{
+	struct vdso_rng_data *rng = timens_rng_data(ns);
+
+	if (!list_empty(&ns->vvar_list))
+		return;
+	list_add_tail(&ns->vvar_list, &timens_vvar_list);
+	rng->generation = ns->vvar_projected ? 1 :
+		READ_ONCE(vdso_k_rng_data->generation);
+	rng->is_ready = READ_ONCE(vdso_k_rng_data->is_ready);
+}
+
+static void timens_project_timestamp(struct vdso_clock *vc, unsigned int clk,
+				     const struct timespec64 *offset,
+				     unsigned int shift)
+{
+	struct vdso_timestamp *ts = &vc->basetime[clk];
+	u64 limit = (u64)NSEC_PER_SEC << shift;
+
+	ts->sec += offset->tv_sec;
+	ts->nsec += (u64)offset->tv_nsec << shift;
+	if (ts->nsec >= limit) {
+		ts->nsec -= limit;
+		ts->sec++;
+	}
+}
+
+static void timens_project_vvar(struct time_namespace *ns)
+{
+	const struct vdso_time_data *host = vdso_k_time_data;
+	struct vdso_time_data projected = *host;
+	struct vdso_time_data *vdata = page_address(ns->vvar_page);
+	struct vdso_clock *vc = projected.clock_data;
+	unsigned int i;
+
+	timens_project_timestamp(&vc[CS_HRES_COARSE], CLOCK_MONOTONIC,
+				 &ns->offsets.monotonic, vc[CS_HRES_COARSE].shift);
+	timens_project_timestamp(&vc[CS_HRES_COARSE], CLOCK_BOOTTIME,
+				 &ns->offsets.boottime, vc[CS_HRES_COARSE].shift);
+	timens_project_timestamp(&vc[CS_HRES_COARSE], CLOCK_MONOTONIC_COARSE,
+				 &ns->offsets.monotonic, 0);
+	timens_project_timestamp(&vc[CS_RAW], CLOCK_MONOTONIC_RAW,
+				 &ns->offsets.monotonic, vc[CS_RAW].shift);
+	vdso_write_begin(vdata);
+	/* Readers can ignore seq: host bases must never reach the mapped page. */
+	memcpy(&vdata->arch_data, &projected.arch_data, sizeof(vdata->arch_data));
+	for (i = 0; i < CS_BASES; i++)
+		memcpy(&vdata->clock_data[i].clock_mode, &vc[i].clock_mode,
+		       sizeof(vc[i]) - offsetof(struct vdso_clock, clock_mode));
+	vdata->hrtimer_res = host->hrtimer_res;
+	vdso_write_end(vdata);
